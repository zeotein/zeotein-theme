{%- comment -%}
  Product page buy box (v2, Nov 13, 2026).
  part: 'rating'   Store rating line: rating, orders (text params), links to the reviews.
                   scope: 'store' labels it "store rating" (single-ingredient pages, whose own review counts are small).
  part: 'formats'  Bulk bag / 30 sticks / 7-Day picker with photos and price per serving (current: 'bag' | 'sticks' | 'trial').
  part: 'perks'    First-order gifts with photos. With the Seal widget on the page they move inside the Subscribe & Save
                   and One-time options and Seal's renewal sentence is shortened; otherwise (no subscription) a plain row.
                   sub_gifts / once_gifts: comma lists of shaker, scoop, guides.
  part: 'trust'    Guarantee + shipping row. kind: 'single' = shipping-only row (single-ingredient powders are final sale).
  part: 'review'   One real customer review (quote, name).
  part: 'sticky'   Add to cart bar (phones: full width; desktop: floating) shown while the main button is off screen (moved to <body> so
                   it is fixed to the screen; sits above Shopify's preview bar when previewing).
  The 'sticky' part also carries the shared page layout: quantity + button on one row, Rewards launcher and the
  second top bar hidden on phones, zoom button moved off the image text, desktop title size.
{%- endcomment -%}
{%- liquid
  assign h_shaker = 'zeotein-cleanblend-shaker-27oz-usa-made'
  assign h_scoop = 'save-a-scoop'
  assign p_shaker = all_products[h_shaker]
  assign p_scoop = all_products[h_scoop]
  assign p_g1 = all_products['zeotein-starter-guide']
  assign p_g2 = all_products['cacao-recipe-guide']
  assign p_g3 = all_products['vegan-recipe-guide']
  assign guides_value = p_g1.price | plus: p_g2.price | plus: p_g3.price
-%}
{%- capture zt_gift_icon -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7.5" width="14" height="3.5" rx=".8"/><path d="M4.5 11v5.5h11V11M10 7.5v9"/><path d="M10 7.5C8.8 4.7 5.4 4.1 5.4 6.2c0 1.3 2.3 1.3 4.6 1.3ZM10 7.5c1.2-2.8 4.6-3.4 4.6-1.3 0 1.3-2.3 1.3-4.6 1.3Z"/></svg>{%- endcapture -%}
{%- case part -%}

  {%- when 'rating' -%}
    <a class="zt-rating" href="#zt-reviews" data-zt-reviews-link>
      <span class="zt-rating__stars" aria-hidden="true">★★★★★</span>
      <span><b>{{ rating | default: '4.9' }}/5</b> {% if scope == 'store' %}store rating{% else %}rating{% endif %}</span>
      <span class="zt-rating__dot" aria-hidden="true">·</span>
      <span>{{ orders | default: '1,500+' }} orders</span>
    </a>
    <style>
      #MainContent .product__info-container > .zt-rating{display:flex;flex-wrap:wrap;align-items:center;gap:2px 7px;margin:2px 0 6px !important;font-size:13.5px;line-height:1.3;color:#3A3546;text-decoration:none;width:fit-content}
      .zt-rating__stars{color:#0F8C7A;letter-spacing:1px;font-size:15px}
      .zt-rating b{color:#1D1530}
      .zt-rating:hover b{text-decoration:underline}
      .zt-rating__dot{color:#A39CB3}
    </style>
    <script>
      (function () {
        var a = document.querySelector('[data-zt-reviews-link]');
        if (!a) return;
        a.addEventListener('click', function (e) {
          var t = document.querySelector('.jdgm-review-widget, .jdgm-widget.jdgm-review-widget, [id*="judge_me_reviews_review_widget"], .jdgm-carousel-wrapper');
          if (!t) return;
          e.preventDefault();
          t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      })();
    </script>

  {%- when 'formats' -%}
    {%- liquid
      assign fmt_handles = 'zeotein-cacao-bag-30,zeotein-cacao-sticks-30,zeotein-cacao-sticks-7' | split: ','
      assign fmt_keys = 'bag,sticks,trial' | split: ','
      assign fmt_names = 'Bulk bag|30 sticks|7-Day pack' | split: '|'
      assign fmt_servings = '30,30,7' | split: ','
    -%}
    {%- comment -%} Only on the three main Cacao pages; funnel/starter-kit products that share these templates keep their own flow. {%- endcomment -%}
    {%- if fmt_handles contains product.handle -%}
    <div class="zt-formats" role="group" aria-label="Choose your format">
      {%- for h in fmt_handles -%}
        {%- liquid
          assign p = all_products[h]
          assign key = fmt_keys[forloop.index0]
          assign servings = fmt_servings[forloop.index0] | plus: 0
          assign low = p.selected_or_first_available_variant.price
          for a in p.selected_or_first_available_variant.selling_plan_allocations
            if a.price < low
              assign low = a.price
            endif
          endfor
          assign per = low | times: 1.0 | divided_by: servings | round
        -%}
        <a class="zt-format{% if current == key %} is-current{% endif %}" href="{{ p.url | default: '/products/' | append: h }}"{% if current == key %} aria-current="page"{% endif %}>
          {%- if key == 'bag' -%}<span class="zt-format__badge">Best value</span>{%- endif -%}
          {%- if p.featured_image -%}
            <img class="zt-format__img" src="{{ p.featured_image | image_url: width: 140 }}" alt="" width="56" height="56" loading="lazy">
          {%- endif -%}
          <span class="zt-format__name">{{ fmt_names[forloop.index0] }}</span>
          <span class="zt-format__note">{% if key != 'trial' %}from {% endif %}{{ per | money }}/serving</span>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}
    <style>
      #MainContent .product__info-container > .zt-formats{display:grid !important;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:8px 0 12px !important}
      .zt-format{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;padding:10px 6px 9px;border:1px solid #DDD6E8;border-radius:12px;text-decoration:none;color:#1D1530;background:#fff;min-width:0}
      .zt-format:hover{border-color:#5F2D90}
      .zt-format:focus-visible{outline:2px solid #32BAC0;outline-offset:2px}
      .zt-format.is-current{border:2px solid #5F2D90;padding:9px 5px 8px;background:#F8F5FC}
      .zt-format__img{width:56px;height:56px;object-fit:contain;margin-bottom:2px}
      .zt-format__name{font-size:13px;font-weight:700;line-height:1.2}
      .zt-format__note{font-size:11.5px;line-height:1.25;color:#6B6478}
      .zt-format__badge{position:absolute;top:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#5F2D90;color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 7px;border-radius:999px}
      @media (min-width: 750px){ .zt-format__img{width:64px;height:64px} .zt-format__name{font-size:14px} }
    </style>

  {%- when 'perks' -%}
    {%- capture gift_tiles_sub -%}
      {%- assign list = sub_gifts | split: ',' -%}
      {%- for g in list -%}
        {%- liquid
          case g
            when 'shaker'
              assign gp = p_shaker
              assign gl = 'Shaker'
              assign gv = p_shaker.price
            when 'scoop'
              assign gp = p_scoop
              assign gl = 'Save-A-Scoop'
              assign gv = p_scoop.price
            when 'guides'
              assign gp = p_g1
              assign gl = '3 digital guides'
              assign gv = guides_value
          endcase
        -%}
        <span class="zt-gift">
          {%- if gp.featured_image -%}<img src="{{ gp.featured_image | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">{%- endif -%}
          <span class="zt-gift__name">{{ gl }}</span>
          <span class="zt-gift__price">{% if gv > 0 %}<s>{{ gv | money_without_trailing_zeros }}</s> {% endif %}Free</span>
        </span>
      {%- endfor -%}
    {%- endcapture -%}
    <div class="zt-perks-src{% if sub_gifts == blank %} is-static{% endif %}" data-zt-perks>
      {%- if sub_gifts != blank -%}
        <div class="zt-perk zt-perk--sub" data-zt-perk="subscription">
          <p class="zt-perk__head">{{ zt_gift_icon }}<span>Free Starter Kit with your first order</span></p>
          <div class="zt-gifts">{{ gift_tiles_sub }}</div>
        </div>
      {%- endif -%}
      {%- if once_text != blank -%}
        <p class="zt-perk zt-perk--once" data-zt-perk="one_time">{{ zt_gift_icon }}<span>{{ once_text }}</span></p>
      {%- endif -%}
    </div>
    <style>
      .zt-perks-src{display:none}
      .zt-perks-src.is-static,.zt-perks-src.is-fallback{display:block}
      .zt-perk{margin:8px 0 0;border-radius:10px;background:#F3EEFA;color:#2E1748;font-size:13px;line-height:1.35;letter-spacing:0}
      .zt-perk--sub{padding:8px 9px 9px;border:1px solid #E4D9F3}
      .zt-perk__head{display:flex;align-items:center;gap:6px;margin:0 0 7px;font-weight:700;font-size:12.5px;color:#4B2380}
      .zt-perk__head svg{color:#5F2D90}
      .zt-gifts{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:6px}
      .zt-gift{display:flex;flex-direction:column;align-items:center;text-align:center;gap:1px;padding:6px 4px 5px;background:#fff;border-radius:8px;min-width:0}
      .zt-gift img{width:44px;height:44px;object-fit:contain}
      .zt-gift__name{font-size:11.5px;font-weight:700;line-height:1.2;color:#1D1530}
      .zt-gift__price{font-size:11px;line-height:1.2;color:#0E7C82;font-weight:800;text-transform:uppercase;letter-spacing:.03em}
      .zt-gift__price s{color:#8A8299;font-weight:500;text-transform:none;letter-spacing:0}
      .zt-perk--once{display:flex;align-items:flex-start;gap:7px;padding:7px 10px;background:#F5F4F7;color:#3A3546}
      .zt-perk--once svg{flex:none;margin-top:1px;color:#6B6478}
      .zt-perks-src.is-static .zt-perk{margin:2px 0 8px}
      .sealsubs-container .sls-selling-plan-description-content{font-size:11.5px;line-height:1.4;color:#6B6478;margin-top:6px}
      .sealsubs-container .zt-perk{margin-top:8px}
    </style>
    <script>
      (function () {
        var src = document.querySelector('.zt-perks-src[data-zt-perks]');
        if (!src || src.classList.contains('is-static')) return;
        var RATE = /^Your rate: (\$[\d.,]+) every (.+?), first order and every order after, for as long as you stay subscribed\. Cancel, pause or skip anytime\.?$/;
        function apply() {
          var box = document.querySelector('.sealsubs-container');
          if (!box) return false;
          var subPerk = src.querySelector('[data-zt-perk="subscription"]');
          var oncePerk = src.querySelector('[data-zt-perk="one_time"]');
          var options = box.querySelectorAll('.sls-option-container');
          // one gift box per purchase type: products with two subscription options get it on the first only
          var subPlaced = !!box.querySelector('.sls-option-container[data-selling-plan-group] .zt-perk');
          for (var i = 0; i < options.length; i++) {
            var opt = options[i];
            var label = opt.querySelector('.sls-label-container');
            if (!label || label.querySelector('.zt-perk')) continue;
            var isSub = opt.hasAttribute('data-selling-plan-group');
            if (isSub && subPlaced) continue;
            var perk = isSub ? subPerk : oncePerk;
            if (!perk) continue;
            var node = perk.cloneNode(true);
            var desc = isSub ? label.querySelector('.sls-selling-plan-description-content') : null;
            if (desc) desc.parentNode.insertBefore(node, desc); else label.appendChild(node);
            if (isSub) subPlaced = true;
          }
          var d = box.querySelector('.sls-selling-plan-description-content');
          if (d) {
            var m = d.textContent.trim().match(RATE);
            if (m) d.textContent = 'Renews at ' + m[1] + ' every ' + m[2] + ' until you cancel. Skip, pause or cancel anytime.';
          }
          return true;
        }
        var tries = 0;
        function watch() {
          var target = document.querySelector('.sealsubs-container');
          if (!target || !window.MutationObserver) return;
          var queued = false;
          new MutationObserver(function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () { queued = false; apply(); });
          }).observe(target.parentNode || target, { childList: true, subtree: true, characterData: true });
        }
        function start() {
          if (apply()) { watch(); return; }
          if (++tries > 40) { src.classList.add('is-fallback'); return; }
          setTimeout(start, 250);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
      })();
    </script>

  {%- when 'trust' -%}
    <ul class="zt-trust" role="list">
      {%- if kind == 'single' -%}
      <li>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5 10 3l7 3.5v7L10 17l-7-3.5z"/><path d="M3 6.5 10 10l7-3.5M10 10v7"/></svg>
        <span><b>Free U.S. shipping</b> on orders $150+</span>
      </li>
      {%- else -%}
      <li>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10a6 6 0 1 0 1.8-4.3"/><path d="M4 3.8v3.4h3.4"/></svg>
        <span><b>30-day guarantee</b> on your first order</span>
      </li>
      {%- endif -%}
      <li>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M2.5 5.5h9v8h-9zM11.5 8.5h3.2l2.3 2.6v2.4h-5.5"/><circle cx="6" cy="14.6" r="1.4"/><circle cx="14.2" cy="14.6" r="1.4"/></svg>
        <span><b>Ships in 1–2</b> business days</span>
      </li>
    </ul>
    <style>
      #MainContent .product__info-container > .zt-trust{display:grid !important;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:10px 0 12px !important;padding:0;list-style:none}
      .zt-trust li{display:flex;align-items:center;gap:7px;min-width:0;font-size:12.5px;line-height:1.3;color:#5C566A}
      .zt-trust svg{flex:none;color:#5F2D90}
      .zt-trust b{color:#1D1530;font-weight:700}
    </style>

  {%- when 'review' -%}
    <figure class="zt-review">
      <div class="zt-review__stars" aria-label="5 out of 5 stars">★★★★★</div>
      <blockquote>{{ quote }}</blockquote>
      <figcaption>{{ name }} <span class="zt-review__badge">Verified buyer</span></figcaption>
    </figure>
    <style>
      #MainContent .product__info-container > .zt-review{margin:14px 0 6px !important;padding:12px 14px;border:1px solid #ECE8F2;border-radius:12px;background:#FCFBFE}
      .zt-review__stars{color:#0F8C7A;letter-spacing:1px;font-size:14px}
      .zt-review blockquote{margin:4px 0 6px;font-size:13.5px;line-height:1.45;color:#2E2A38}
      .zt-review figcaption{font-size:12.5px;font-weight:700;color:#1D1530}
      .zt-review__badge{margin-left:6px;font-weight:600;color:#0E7C82}
    </style>

  {%- when 'sticky' -%}
    <div class="zt-sticky" data-zt-sticky hidden>
      {%- if product.featured_image -%}<img class="zt-sticky__img" src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="44" height="44" loading="lazy">{%- endif -%}
      <div class="zt-sticky__info">
        <span class="zt-sticky__name"><span>{{ label | default: product.title }}</span><span data-zt-sticky-size></span></span>
        <span class="zt-sticky__price" data-zt-sticky-price></span>
      </div>
      <button type="button" class="zt-sticky__btn" data-zt-sticky-btn>Add to cart</button>
    </div>
    <style>
      .product__media-icon{left:auto !important;right:1.2rem !important}
      #MainContent .product__info-container:has(.sealsubs-container) > [id^="price-template"]{display:none !important}
      #MainContent .product__info-container{display:flex;flex-wrap:wrap;column-gap:10px}
      #MainContent .product__info-container > *{flex:0 0 100%;max-width:100%;min-width:0}
      #MainContent .product__info-container > .product-form__quantity{flex:0 0 auto;max-width:none}
      #MainContent .product__info-container > .product-form__quantity + *{flex:1 1 0}
      #MainContent .product-form__quantity .form__label{position:absolute !important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
      #MainContent .product-form__quantity .quantity{width:112px;min-height:46px}
      #MainContent .product__info-container > .product-form__quantity + * delivery-promise-wc{margin-left:-122px}
      @media (min-width: 750px){
        #MainContent .product__info-container .product__title h1{font-size:26px !important;line-height:1.25}
      }
      @media (max-width: 749px){
        #bon-loyalty-btn{display:none !important}
        [id$="__announcement_marquee"]{display:none !important}
      }
      .zt-sticky{display:none}
      .zt-sticky__img{display:none}
      .zt-sticky__price b{font-weight:800}
      .zt-sticky__price span{font-size:13px;font-weight:500;color:#5C566A}
      @media (min-width: 750px){
        .zt-sticky{position:fixed;left:24px;bottom:16px;z-index:60;display:flex;align-items:center;gap:14px;
          width:560px;max-width:calc(100% - 48px);padding:10px 10px 10px 12px;background:#fff;border:1px solid #E6E0EF;border-radius:14px;
          box-shadow:0 10px 30px rgba(29,21,48,.18);transform:translateY(160%);transition:transform .2s ease}
        .zt-sticky.is-on{transform:none}
        body.zt-sticky-on #bon-loyalty-btn{opacity:0 !important;pointer-events:none !important}
        .zt-sticky[hidden]{display:none !important}
        .zt-sticky__img{display:block;width:44px;height:44px;object-fit:contain;border-radius:8px;background:#F7F5FA}
        .zt-sticky__info{display:flex;flex-direction:column;min-width:0;flex:1}
        .zt-sticky__name{font-size:13px;color:#5C566A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .zt-sticky__price{font-size:17px;color:#1D1530}
        .zt-sticky__btn{flex:none;min-height:46px;padding:0 30px;border:0;border-radius:8px;background:#32BAC0;color:#fff;font:inherit;font-size:15px;font-weight:700;letter-spacing:.04em;cursor:pointer}
        .zt-sticky__btn:hover{background:#2AA3A8}
      }
      @media (max-width: 749px){
        .zt-sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;align-items:center;gap:12px;
          padding:10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
          background:#fff;box-shadow:0 -6px 20px rgba(29,21,48,.12);transform:translateY(110%);transition:transform .2s ease}
        .zt-sticky.is-on{transform:none}
        body.zt-has-sticky{padding-bottom:76px}
        .zt-sticky[hidden]{display:none !important}
        .zt-sticky__info{display:flex;flex-direction:column;min-width:0;flex:1}
        .zt-sticky__name{font-size:12.5px;color:#5C566A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .zt-sticky__price{font-size:16px;color:#1D1530;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .zt-sticky__btn{flex:none;min-height:46px;padding:0 22px;border:0;border-radius:6px;background:#32BAC0;color:#fff;font:inherit;font-size:15px;font-weight:700;letter-spacing:.04em;cursor:pointer}
      }
      @media (prefers-reduced-motion: reduce){ .zt-sticky{transition:none} }
    </style>
    <script>
      (function () {
        var bar = document.querySelector('[data-zt-sticky]');
        if (!bar || !window.IntersectionObserver) return;
        var main = document.querySelector('#MainContent .product-form__submit');
        if (!main) return;
        document.body.appendChild(bar);
        document.body.classList.add('zt-has-sticky');
        function lift() {
          var pb = document.getElementById('PBarNextFrameWrapper');
          bar.style.bottom = pb && pb.offsetHeight && getComputedStyle(pb).display !== 'none' ? pb.offsetHeight + 'px' : '';
          var media = document.querySelector('#MainContent .product__media-wrapper');
          if (window.matchMedia('(min-width: 750px)').matches && media) {
            var r = media.getBoundingClientRect();
            bar.style.left = Math.round(r.left + 12) + 'px';
            bar.style.width = Math.round(Math.max(320, r.width - 24)) + 'px';
          } else { bar.style.left = ''; bar.style.width = ''; }
        }
        var priceEl = bar.querySelector('[data-zt-sticky-price]');
        var sizeEl = bar.querySelector('[data-zt-sticky-size]');
        function price() {
          var pr = document.querySelector('#MainContent .price');
          var dawn = pr ? (pr.classList.contains('price--on-sale') ? pr.querySelector('.price__sale .price-item--sale') : pr.querySelector('.price__regular .price-item--regular')) : null;
          var opt = document.querySelector('.sealsubs-container .sls-option-container.sls-active .sls-price .money')
                 || document.querySelector('.sealsubs-container .sls-option-container .sls-price .money')
                 || dawn || document.querySelector('#MainContent .price-item--regular');
          var size = document.querySelector('#MainContent variant-selects input[type="radio"]:checked');
          if (sizeEl) sizeEl.textContent = size ? ' · ' + size.value : '';
          var plan = document.querySelector('.sealsubs-container .sls-option-container.sls-active[data-selling-plan-group]');
          var txt = opt ? opt.textContent.trim().replace(/\s*USD$/, '') : '';
          var hasSeal = !!document.querySelector('.sealsubs-container .sls-option-container');
          priceEl.textContent = '';
          if (!txt) return;
          var b = document.createElement('b'); b.textContent = txt; priceEl.appendChild(b);
          if (hasSeal) { var sp = document.createElement('span'); sp.textContent = plan ? ' · Subscribe & Save' : ' · One-time'; priceEl.appendChild(sp); }
        }
        bar.hidden = false;
        new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { bar.classList.toggle('is-on', !e.isIntersecting); document.body.classList.toggle('zt-sticky-on', !e.isIntersecting); });
          price(); lift();
        }, { threshold: 0.4 }).observe(main);
        document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.sealsubs-container, variant-selects')) setTimeout(price, 400); });
        document.addEventListener('change', function () { setTimeout(price, 400); setTimeout(price, 1200); });
        if (typeof subscribe === 'function' && window.PUB_SUB_EVENTS) subscribe(PUB_SUB_EVENTS.variantChange, function () { setTimeout(price, 50); });
        bar.querySelector('[data-zt-sticky-btn]').addEventListener('click', function () { main.click(); });
        setTimeout(function () { price(); lift(); }, 1500);
        setTimeout(lift, 4000);
        window.addEventListener('resize', lift);
      })();
    </script>
{%- endcase -%}
