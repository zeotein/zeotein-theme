{%- comment -%}
  Product page buy box tidy-up (Nov 13, 2026).
  part: 'perks'   First-order gifts. With the Seal widget on the page, the gift lines move inside
                  the Subscribe & Save and One-time options and Seal's renewal sentence is shortened.
                  Without a subscription (sub_perk blank) the line shows as a plain row.
  part: 'trust'   One compact guarantee + shipping row.
  part: 'formats' Bulk bag / 30 sticks / 7-Day switcher (current: 'bag' | 'sticks' | 'trial').
  Also keeps the Rewards launcher off the buy box on phones and moves the zoom button off the image text.
{%- endcomment -%}
{%- capture zt_gift -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7.5" width="14" height="3.5" rx=".8"/><path d="M4.5 11v5.5h11V11M10 7.5v9"/><path d="M10 7.5C8.8 4.7 5.4 4.1 5.4 6.2c0 1.3 2.3 1.3 4.6 1.3ZM10 7.5c1.2-2.8 4.6-3.4 4.6-1.3 0 1.3-2.3 1.3-4.6 1.3Z"/></svg>{%- endcapture -%}
{%- case part -%}
  {%- when 'perks' -%}
    <div class="zt-perks-src{% if sub_perk == blank %} is-static{% endif %}" data-zt-perks>
      {%- if sub_perk != blank -%}
        <p class="zt-perk zt-perk--sub" data-zt-perk="subscription">{{ zt_gift }}<span>{{ sub_perk }}</span></p>
      {%- endif -%}
      {%- if once_perk != blank -%}
        <p class="zt-perk zt-perk--once" data-zt-perk="one_time">{{ zt_gift }}<span>{{ once_perk }}</span></p>
      {%- endif -%}
    </div>
    <style>
      .zt-perks-src{display:none}
      .zt-perks-src.is-static,.zt-perks-src.is-fallback{display:block}
      .zt-perk{display:flex;align-items:flex-start;gap:7px;margin:8px 0 0;padding:7px 10px;border-radius:8px;background:#F3EEFA;color:#2E1748;font-size:13px;line-height:1.35;letter-spacing:0}
      .zt-perk svg{flex:none;margin-top:1px;color:#5F2D90}
      .zt-perk b{font-weight:700}
      .zt-perk--once{background:#F5F4F7;color:#3A3546}
      .zt-perk--once svg{color:#6B6478}
      .zt-perks-src.is-static .zt-perk{margin:2px 0 4px}
      .sealsubs-container .sls-selling-plan-description-content{font-size:12px;line-height:1.4;color:#6B6478;margin-top:6px}
      .sealsubs-container .zt-perk{margin-top:9px}
      .product__media-icon{left:auto !important;right:1.2rem !important}
      @media (max-width: 749px){ #bon-loyalty-btn{display:none !important} }
    </style>
    <script>
      (function () {
        var src = document.querySelector('.zt-perks-src[data-zt-perks]');
        if (!src || src.classList.contains('is-static')) return;
        var RATE = /^Your rate: (\$[\d.,]+) every (.+?), first order and every order after, for as long as you stay subscribed\. Cancel, pause or skip anytime\.?$/;
        function apply() {
          var box = document.querySelector('.sealsubs-container');
          if (!box) return false;
          var subPerk = src.querySelector('[data-zt-perk="subscription"]');
          var oncePerk = src.querySelector('[data-zt-perk="one_time"]');
          var options = box.querySelectorAll('.sls-option-container');
          for (var i = 0; i < options.length; i++) {
            var opt = options[i];
            var label = opt.querySelector('.sls-label-container');
            if (!label || label.querySelector('.zt-perk')) continue;
            var isSub = opt.hasAttribute('data-selling-plan-group');
            var perk = isSub ? subPerk : oncePerk;
            if (!perk) continue;
            var node = perk.cloneNode(true);
            var desc = isSub ? label.querySelector('.sls-selling-plan-description-content') : null;
            if (desc) desc.parentNode.insertBefore(node, desc); else label.appendChild(node);
          }
          var d = box.querySelector('.sls-selling-plan-description-content');
          if (d) {
            var m = d.textContent.trim().match(RATE);
            if (m) d.textContent = 'Renews at ' + m[1] + ' every ' + m[2] + ' until you cancel. Skip, pause or cancel anytime.';
          }
          return true;
        }
        var tries = 0;
        function watch() {
          var target = document.querySelector('.sealsubs-container');
          if (!target || !window.MutationObserver) return;
          var queued = false;
          new MutationObserver(function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () { queued = false; apply(); });
          }).observe(target.parentNode || target, { childList: true, subtree: true, characterData: true });
        }
        function start() {
          if (apply()) { watch(); return; }
          if (++tries > 40) { src.classList.add('is-fallback'); return; }
          setTimeout(start, 250);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
      })();
    </script>
  {%- when 'trust' -%}
    <ul class="zt-trust" role="list">
      <li>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10a6 6 0 1 0 1.8-4.3"/><path d="M4 3.8v3.4h3.4"/></svg>
        <span><b>30-day guarantee</b>Money back on your first order</span>
      </li>
      <li>
        <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M2.5 5.5h9v8h-9zM11.5 8.5h3.2l2.3 2.6v2.4h-5.5"/><circle cx="6" cy="14.6" r="1.4"/><circle cx="14.2" cy="14.6" r="1.4"/></svg>
        <span><b>Fast shipping</b>Ships in 1 to 2 business days</span>
      </li>
    </ul>
    <style>
      #MainContent .product__info-container > .zt-trust{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:12px 0 4px !important;padding:12px 0 0;border-top:1px solid #ECE8F2;list-style:none}
      .zt-trust li{display:flex;align-items:flex-start;gap:8px;min-width:0}
      .zt-trust svg{flex:none;color:#5F2D90;margin-top:1px}
      .zt-trust span{display:grid;gap:1px;font-size:12.5px;line-height:1.35;color:#5C566A}
      .zt-trust b{font-size:13.5px;font-weight:700;color:#1D1530}
    </style>
  {%- when 'formats' -%}
    <nav class="zt-formats" aria-label="Choose your format">
      <p class="zt-formats__label">Choose your format</p>
      <div class="zt-formats__row">
        <a class="zt-format{% if current == 'bag' %} is-current{% endif %}" href="/products/zeotein-cacao-bag-30"{% if current == 'bag' %} aria-current="page"{% endif %}>
          <span class="zt-format__name">Bulk bag</span><span class="zt-format__note">Lowest cost per serving</span>
        </a>
        <a class="zt-format{% if current == 'sticks' %} is-current{% endif %}" href="/products/zeotein-cacao-sticks-30"{% if current == 'sticks' %} aria-current="page"{% endif %}>
          <span class="zt-format__name">30 stick packs</span><span class="zt-format__note">Single-serve, on the go</span>
        </a>
        <a class="zt-format{% if current == 'trial' %} is-current{% endif %}" href="/products/zeotein-cacao-sticks-7"{% if current == 'trial' %} aria-current="page"{% endif %}>
          <span class="zt-format__name">7-Day pack</span><span class="zt-format__note">Try it for a week</span>
        </a>
      </div>
    </nav>
    <style>
      #MainContent .product__info-container > .zt-formats{margin:14px 0 8px !important}
      .zt-formats__label{margin:0 0 7px;font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#6B6478}
      .zt-formats__row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
      .zt-format{display:flex;flex-direction:column;gap:2px;padding:9px 10px;border:1px solid #DDD6E8;border-radius:10px;text-decoration:none;color:#1D1530;min-width:0;background:#fff}
      .zt-format:hover{border-color:#5F2D90}
      .zt-format:focus-visible{outline:2px solid #32BAC0;outline-offset:2px}
      .zt-format.is-current{border:2px solid #5F2D90;padding:8px 9px;background:#F8F5FC}
      .zt-format__name{font-size:13.5px;font-weight:700;line-height:1.25}
      .zt-format__note{font-size:12px;line-height:1.3;color:#6B6478}
    </style>
{%- endcase -%}
