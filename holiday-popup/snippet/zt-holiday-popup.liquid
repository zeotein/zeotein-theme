{%- comment -%}
  Zeotein Holiday Recipe Guide pop-up (v3 design, approved by Dana Nov 11 2026).
  Step 1: first name + email -> GHL tag "holiday-guide" (same tag the gift.zeotein.com
  opt-in uses; that tag fires the guide email workflow).
  Step 2: optional phone + TCPA consent -> GHL "sms-opted-in" + consent fields.
  All GHL writes go through the relay in holiday-popup/worker (the GHL key never
  reaches the browser). Set ZT_HP_ENDPOINT below once the relay is deployed.

  Kill switch: set zt_hp_enabled to false, or remove the render line in theme.liquid.
  Preview any time with ?zt_popup=1 (bypasses triggers + caps, still posts for real).
{%- endcomment -%}
{%- liquid
  assign zt_hp_enabled = true
  assign zt_hp_endpoint = ''
  assign zt_hp_skip = false
  if request.design_mode
    assign zt_hp_skip = true
  endif
  if template.name == 'cart' or template.name == 'customers/account' or template.name == 'customers/order' or template.name == 'password'
    assign zt_hp_skip = true
  endif
  if request.path contains '/a/subscriptions' or request.path contains '/checkouts'
    assign zt_hp_skip = true
  endif
  comment
    Suppress for logged-in customers already on the email list.
  endcomment
  if customer and customer.accepts_marketing
    assign zt_hp_skip = true
  endif
-%}
{%- if zt_hp_enabled and zt_hp_skip == false -%}
<div id="zt-hp" class="zt-hp" hidden aria-hidden="true">
  <div class="zt-hp__dim" data-zt-close></div>
  <div class="zt-hp__modal" role="dialog" aria-modal="true" aria-labelledby="zt-hp-title">
    <div class="zt-hp__art">
      <div class="zt-hp__handle"></div>
      <div class="zt-hp__snow"></div>
      <img class="zt-hp__cover" src="{{ 'zt-holiday-guide-cover.webp' | asset_url }}" alt="Zeotein Holiday Recipe Guide cover" width="400" height="532" loading="eager">
    </div>
    <div class="zt-hp__body">
      <div class="zt-hp__corner"></div>
      <button type="button" class="zt-hp__x" data-zt-close aria-label="Close">&times;</button>

      <form class="zt-hp__s1" novalidate>
        <div class="zt-hp__k">FREE HOLIDAY RECIPE GUIDE</div>
        <h2 class="zt-hp__h" id="zt-hp-title">Treats Can Be<br><span>Smarter</span></h2>
        <p class="zt-hp__p">14 cozy drinks and festive treats with protein folded right in. For you, and for sharing all season. Yours free.</p>
        <input class="zt-hp__in" type="text" name="firstName" placeholder="First name" autocomplete="given-name" required maxlength="60">
        <input class="zt-hp__in" type="email" name="email" placeholder="Email address" autocomplete="email" required maxlength="120">
        <input class="zt-hp__hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="zt-hp__err" role="alert"></div>
        <button class="zt-hp__btn" type="submit">Send My Free Guide 🎄</button>
        <button type="button" class="zt-hp__later" data-zt-close>Maybe later</button>
      </form>

      <form class="zt-hp__s2" novalidate hidden>
        <div class="zt-hp__done">✓ You're in! Your guide is on its way.</div>
        <h2 class="zt-hp__h zt-hp__h--s2">Want new recipes<br><span>by text?</span></h2>
        <p class="zt-hp__p">Optional. Cozy recipes and holiday offers, sent straight to your phone.</p>
        <label class="zt-hp__in zt-hp__phone"><span class="zt-hp__cc">🇺🇸 +1</span><input type="tel" name="phone" placeholder="Mobile number" autocomplete="tel-national" inputmode="tel" maxlength="16"></label>
        <div class="zt-hp__err" role="alert"></div>
        <button class="zt-hp__btn" type="submit">Text Me Recipes 📱</button>
        <div class="zt-hp__tcpa" data-zt-consent>By tapping Text Me Recipes, you agree to receive recurring automated marketing texts from Zeotein at this number. Consent is not a condition of purchase. Msg &amp; data rates may apply. Msg frequency varies. Reply STOP to opt out, HELP for help. <a href="/policies/terms-of-service" target="_blank">Terms</a> &amp; <a href="/policies/privacy-policy" target="_blank">Privacy</a>.</div>
        <button type="button" class="zt-hp__later" data-zt-close>Skip, email is perfect</button>
      </form>
    </div>
  </div>
</div>

<style>
.zt-hp{--pine:#0f3b2e;--pine2:#0a2a20;--red:#b5232f;--red2:#8f1622;--cream:#fbf5ea;position:fixed;inset:0;z-index:2147483000;font-family:Poppins,sans-serif;letter-spacing:0;line-height:1.4}
.zt-hp[hidden]{display:none}
.zt-hp *{box-sizing:border-box;margin:0;padding:0}
.zt-hp__dim{position:absolute;inset:0;background:rgba(10,20,16,.5);opacity:0;transition:opacity .25s}
.zt-hp.is-open .zt-hp__dim{opacity:1}
.zt-hp__modal{position:absolute;left:50%;top:50%;transform:translate(-50%,-46%);opacity:0;transition:transform .3s ease,opacity .3s;width:640px;max-width:calc(100% - 80px);max-height:calc(100% - 40px);overflow:auto;display:grid;grid-template-columns:240px 1fr;border-radius:22px;background:var(--cream);box-shadow:0 30px 80px rgba(0,0,0,.5)}
.zt-hp.is-open .zt-hp__modal{transform:translate(-50%,-50%);opacity:1}
.zt-hp__art{position:relative;background:radial-gradient(ellipse at 50% 45%,#1c5a45,var(--pine2));display:flex;align-items:center;justify-content:center;padding:26px 22px;overflow:hidden}
.zt-hp__snow{position:absolute;inset:0;pointer-events:none;opacity:.55;background-image:radial-gradient(2px 2px at 20px 30px,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 90px 80px,#fff 50%,transparent 51%),radial-gradient(2.5px 2.5px at 160px 20px,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 210px 120px,#fff 50%,transparent 51%),radial-gradient(2px 2px at 60px 150px,#fff 50%,transparent 51%);background-size:240px 180px}
.zt-hp__cover{position:relative;display:block;opacity:1!important;visibility:visible!important;max-width:none;width:88%;height:auto;filter:drop-shadow(0 18px 30px rgba(0,0,0,.45))}
.zt-hp__handle{display:none}
.zt-hp__body{padding:30px 28px 22px;position:relative;color:#1d1d1f}
.zt-hp__corner{position:absolute;top:0;left:0;width:100%;height:8px;background:repeating-linear-gradient(135deg,var(--red) 0 14px,var(--red2) 14px 28px)}
.zt-hp__x{position:absolute;right:12px;top:10px;font-size:28px;line-height:1;color:#8a8273;background:none;border:0;cursor:pointer;padding:4px 8px}
.zt-hp__k{color:var(--red);font-weight:700;font-size:13px;letter-spacing:1.8px}
.zt-hp__h{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:46px;line-height:.95;color:var(--pine);margin:6px 0 8px;letter-spacing:.5px;text-transform:none}
.zt-hp__h span{color:var(--red)}
.zt-hp__h--s2{font-size:40px}
.zt-hp__p{font-size:15px;line-height:1.5;color:#4a443b;margin-bottom:14px}
.zt-hp__in{width:100%;height:50px;border:1.5px solid #d8cfc0;border-radius:10px;padding:0 16px;font:400 16px Poppins,sans-serif;color:#1d1d1f;background:#fff;display:flex;align-items:center;margin-bottom:10px;outline:none}
.zt-hp__in:focus,.zt-hp__phone:focus-within{border-color:var(--pine)}
.zt-hp__phone{gap:10px;cursor:text}
.zt-hp__phone input{flex:1;min-width:0;border:0;outline:none;font:inherit;color:inherit;background:none;height:100%}
.zt-hp__cc{font-weight:600;color:#333;border-right:1.5px solid #d8cfc0;padding-right:10px;white-space:nowrap}
.zt-hp__hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.zt-hp__err{color:var(--red);font-size:13px;min-height:0;margin:-4px 0 6px}
.zt-hp__err:empty{display:none}
.zt-hp__btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:56px;border:0;border-radius:12px;cursor:pointer;background:linear-gradient(180deg,#c92a37,var(--red2));color:#fff;font:700 18px Poppins,sans-serif;letter-spacing:.3px;box-shadow:0 6px 0 #6d0f18,0 10px 24px rgba(0,0,0,.25);text-transform:uppercase;margin-top:4px}
.zt-hp__btn[disabled]{opacity:.7;cursor:wait}
.zt-hp__later{display:block;margin:14px auto 0;background:none;border:0;font:400 13px Poppins,sans-serif;color:#8a8273;text-decoration:underline;cursor:pointer}
.zt-hp__done{display:flex;align-items:center;gap:8px;font:600 13.5px Poppins,sans-serif;color:#1f7a55;background:#e6f4ec;border-radius:999px;padding:6px 12px;width:max-content;max-width:100%;margin-bottom:10px}
.zt-hp__tcpa{font-size:10.5px;line-height:1.45;color:#7a7266;margin-top:12px;text-align:left}
.zt-hp__tcpa a{color:inherit;text-decoration:underline}
@media (max-width:700px){
 .zt-hp__modal{top:auto;bottom:0;left:0;transform:translateY(100%);opacity:1;width:100%;max-width:none;max-height:92%;grid-template-columns:minmax(0,1fr);overflow-x:hidden;border-radius:22px 22px 0 0}
 .zt-hp.is-open .zt-hp__modal{transform:none}
 .zt-hp__art{padding:22px 0 0;height:170px;align-items:flex-start}
 .zt-hp__cover{width:118px}
 .zt-hp__handle{display:block;position:absolute;top:8px;left:50%;width:44px;height:5px;margin-left:-22px;border-radius:9px;background:rgba(255,255,255,.5);z-index:3}
 .zt-hp__body{padding:18px 20px calc(18px + env(safe-area-inset-bottom));text-align:center;position:static}
 .zt-hp__corner{position:relative;top:-18px;left:-20px;width:calc(100% + 40px);margin-bottom:-8px}
 .zt-hp__x{color:#fff;top:12px;right:10px;z-index:4}
 .zt-hp__h{font-size:40px}
 .zt-hp__h--s2{font-size:34px}
 .zt-hp__p{font-size:14.5px;margin-bottom:12px}
 .zt-hp__done{margin:0 auto 8px;width:auto;display:inline-flex;font-size:12.5px}
 .zt-hp__s2{display:flex;flex-direction:column}
 .zt-hp__s2[hidden]{display:none}
 .zt-hp__s2 .zt-hp__done{align-self:center}
 .zt-hp__tcpa{font-size:10px}
}
</style>

<script>
(function(){
  var ENDPOINT = {{ zt_hp_endpoint | json }};
  var KEY = 'zt_hp_v1';
  var DISMISS_DAYS = 7;          // after "Maybe later" / close
  var SKIP_SMS_DAYS = 365;       // after email submit (never ask for email again)
  var root = document.getElementById('zt-hp'); if(!root) return;
  var q = new URLSearchParams(location.search);
  var force = q.get('zt_popup') === '1';
  function store(){ try{ return JSON.parse(localStorage.getItem(KEY)||'{}'); }catch(e){ return {}; } }
  function save(o){ try{ localStorage.setItem(KEY, JSON.stringify(Object.assign(store(), o))); }catch(e){} }
  var st = store(), now = Date.now(), day = 864e5;

  // Suppression: already submitted, recently dismissed, shown this session, or arrived from our own email/SMS.
  if(!force){
    if(st.submitted) return;
    if(st.dismissed && now - st.dismissed < DISMISS_DAYS*day) return;
    try{ if(sessionStorage.getItem(KEY+'_shown')) return; }catch(e){}
    var src = (q.get('utm_source')||'') + (q.get('utm_medium')||'');
    if(/email|sms|ghl|klaviyo|leadconnector/i.test(src)) { save({dismissed: now}); return; }
  }

  var s1 = root.querySelector('.zt-hp__s1'), s2 = root.querySelector('.zt-hp__s2');
  var lead = {};
  var opened = false;

  function open(trigger){
    if(opened) return; opened = true;
    try{ sessionStorage.setItem(KEY+'_shown','1'); }catch(e){}
    root.hidden = false; root.setAttribute('aria-hidden','false');
    requestAnimationFrame(function(){ root.classList.add('is-open'); });
    document.documentElement.style.overflow='hidden';
    track('zt_holiday_popup_view', {trigger: trigger});
    setTimeout(function(){ var f=s1.querySelector('input[name=firstName]'); if(f && window.matchMedia('(pointer:fine)').matches) f.focus(); }, 350);
  }
  function close(){
    root.classList.remove('is-open');
    document.documentElement.style.overflow='';
    setTimeout(function(){ root.hidden = true; root.setAttribute('aria-hidden','true'); }, 300);
    if(!lead.email) save({dismissed: Date.now()});
  }
  root.addEventListener('click', function(e){ if(e.target.closest('[data-zt-close]')) close(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && opened && !root.hidden) close(); });

  function track(name, data){
    try{ window.dataLayer = window.dataLayer||[]; window.dataLayer.push(Object.assign({event:name}, data||{})); }catch(e){}
    try{ if(window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish(name, data||{}); }catch(e){}
    try{ if(name==='zt_holiday_popup_email' && window.fbq) fbq('track','Lead',{content_name:'Holiday Recipe Guide'}); }catch(e){}
  }
  function post(payload){
    if(!ENDPOINT) return Promise.reject(new Error('not_configured'));
    return fetch(ENDPOINT, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)})
      .then(function(r){ return r.json().catch(function(){return {};}).then(function(j){ if(!r.ok || !j.ok) throw new Error(j.error||'failed'); return j; }); });
  }
  function busy(form, on){ var b=form.querySelector('.zt-hp__btn'); b.disabled=on; }
  function err(form, msg){ form.querySelector('.zt-hp__err').textContent = msg||''; }

  s1.addEventListener('submit', function(e){
    e.preventDefault(); err(s1);
    var fn = s1.firstName.value.trim(), em = s1.email.value.trim();
    if(!fn){ err(s1,'Please add your first name.'); return; }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){ err(s1,'Please enter a valid email.'); return; }
    busy(s1,true);
    post({step:'email', firstName:fn, email:em, company:s1.company.value, pageUrl:location.href})
      .then(function(){
        lead = {firstName:fn, email:em}; save({submitted: Date.now()});
        track('zt_holiday_popup_email');
        s1.hidden = true; s2.hidden = false;
        var p = s2.querySelector('input[name=phone]'); if(window.matchMedia('(pointer:fine)').matches) p.focus();
      })
      .catch(function(){ err(s1,'Something went wrong. Please try again.'); })
      .then(function(){ busy(s1,false); });
  });

  s2.addEventListener('submit', function(e){
    e.preventDefault(); err(s2);
    var digits = s2.phone.value.replace(/\D/g,'').replace(/^1(?=\d{10}$)/,'');
    if(digits.length !== 10){ err(s2,'Please enter a 10-digit US mobile number.'); return; }
    busy(s2,true);
    post({step:'sms', email:lead.email, firstName:lead.firstName, phone:'+1'+digits,
          consentText: s2.querySelector('[data-zt-consent]').innerText.trim(), pageUrl:location.href})
      .then(function(){
        track('zt_holiday_popup_sms');
        s2.innerHTML = '<div class="zt-hp__done" style="margin:20px auto 10px">✓ All set! Watch for a welcome text.</div><button type="button" class="zt-hp__later" data-zt-close>Close</button>';
        setTimeout(close, 2600);
      })
      .catch(function(){ err(s2,'Something went wrong. Please try again.'); busy(s2,false); });
  });

  // Triggers
  if(force){ setTimeout(function(){ open('preview'); }, 400); return; }
  var start = Date.now();
  var desktop = window.matchMedia('(min-width:701px) and (pointer:fine)').matches;
  if(desktop){
    // Exit intent only (Jewels's rule). Armed after 8s so it never fires early.
    document.addEventListener('mouseout', function(e){
      if(e.relatedTarget || e.toElement) return;
      if(e.clientY > 10) return;
      if(Date.now() - start < 8000) return;
      open('exit_intent');
    });
  } else {
    // Mobile: 25s on page AND 40% scroll, or quick scroll-up back toward the top after 40% (mobile "exit").
    var maxPct = 0, lastY = window.scrollY, timeOk = false;
    setTimeout(function(){ timeOk = true; check(); }, 25000);
    function pct(){ var h = document.documentElement.scrollHeight - innerHeight; return h>0 ? window.scrollY/h : 1; }
    function check(){
      var p = pct(); if(p > maxPct) maxPct = p;
      if(timeOk && maxPct >= 0.4) open('mobile_time_scroll');
    }
    window.addEventListener('scroll', function(){
      var y = window.scrollY;
      if(maxPct >= 0.4 && lastY - y > 600 && Date.now()-start > 12000) open('mobile_scroll_up');
      lastY = y; check();
    }, {passive:true});
  }
})();
</script>
{%- endif -%}
