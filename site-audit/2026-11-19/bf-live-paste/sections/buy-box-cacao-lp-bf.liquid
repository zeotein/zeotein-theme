t facts photo"},{"type":"color","id":"primary_color","label":"Primary color","default":"#580d93"},{"type":"range","id":"layout_width","label":"Layout width","min":980,"max":1600,"step":10,"unit":"px","default":1280}],"blocks":[{"type":"faq","name":"Detail","settings":[{"type":"text","id":"title","label":"Title","default":"Detail"},{"type":"textarea","id":"body","label":"Body"}]}],"max_blocks":8,"presets":[{"name":"Buy Box Cacao LP-BF"}]}
