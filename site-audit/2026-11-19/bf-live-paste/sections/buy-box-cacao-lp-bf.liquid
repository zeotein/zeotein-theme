{% comment %}
Buy Box Cacao LP - Black Friday.
Copy of Buy Box Cacao LP v2 with the Black Friday product, Seal plans and price ladder.
Renders through buy-box-cacao-lp.js on the v2 path, so that file is untouched.
Markup lives in the zt-bf-bb-* snippets.
{% endcomment %}
{%- liquid
assign sid = 'zt-bb2-' | append: section.id
assign details_id = 'zt-bb2-details-' | append: section.id
assign reviews_id = 'zt-bb2-reviews-' | append: section.id
assign bb_product = all_products['30-day-cacao-bulk-bag-black-friday']
assign variant = bb_product.selected_or_first_available_variant
assign variant_id = variant.id | default: '68115835322581'
assign seal_plan_1 = '6688669909'
assign seal_plan_2 = '6688702677'
assign seal_plan_3 = '6688735445'

assign shaker = all_products['lp-gift-cleanblend-shaker']
assign shaker_variant_id = '67706369704149'
if shaker != blank and shaker.selected_or_first_available_variant
assign shaker_variant_id = shaker.selected_or_first_available_variant.id
endif
assign scoop_product = all_products['lp-gift-save-a-scoop']
assign scoop_variant_id = '67706369507541'
if scoop_product != blank and scoop_product.selected_or_first_available_variant
assign scoop_variant_id = scoop_product.selected_or_first_available_variant.id
endif
assign guide_starter = all_products['lp-gift-starter-guide']
assign guide_cacao = all_products['lp-gift-cacao-recipe-guide']
assign guide_vegan = all_products['lp-gift-vegan-recipe-guide']
assign guide_starter_vid = '67706369540309'
assign guide_cacao_vid = '67706369605845'
assign guide_vegan_vid = '67706369638613'
if guide_starter != blank and guide_starter.selected_or_first_available_variant
assign guide_starter_vid = guide_starter.selected_or_first_available_variant.id
endif
if guide_cacao != blank and guide_cacao.selected_or_first_available_variant
assign guide_cacao_vid = guide_cacao.selected_or_first_available_variant.id
endif
if guide_vegan != blank and guide_vegan.selected_or_first_available_variant
assign guide_vegan_vid = guide_vegan.selected_or_first_available_variant.id
endif

if section.settings.layout_width == blank
assign layout_width = 1180
else
assign layout_width = section.settings.layout_width
endif

assign slide_1 = nil
if bb_product != blank
for media in bb_product.media
if media.media_type == 'image'
assign slide_1 = media
break
endif
endfor
endif
-%}

{{ 'buy-box-cacao-lp-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cacao-lp-scroll-offer.js' | asset_url }}" defer></script>
<script src="{{ 'buy-box-cacao-lp.js' | asset_url }}" type="module" defer></script>
{% render 'zt-bf-bb-sticky' %}

{%- capture buybox_config -%}
{
"productTitle": {{ bb_product.title | default: 'Zeotein Cacao 30-Day Bulk Bag' | json }},
"variantId": {{ variant_id | json }},
"defaultPlan": {{ section.settings.default_plan | default: 'sub' | json }},
"defaultBag": "1",
"ctaSub": {{ section.settings.cta_sub | default: 'Get My Black Friday Kit' | json }},
"ctaOnce": {{ section.settings.cta_once | default: 'Get My Black Friday Kit' | json }},
"afterAddAction": {{ section.settings.after_add_action | default: 'drawer' | json }},
"addShakerGift": {{ true | json }},
"shakerVariantId": {{ shaker_variant_id | json }},
"addBulkBagGifts": {{ true | json }},
"giftItems": {
"bulkBag": [
{%- assign gift_comma = false -%}
{%- if scoop_variant_id != blank -%}
{ "id": {{ scoop_variant_id }}, "key": "save_a_scoop" }
{%- assign gift_comma = true -%}
{%- endif -%}
{%- if guide_starter_vid != blank -%}
{%- if gift_comma -%},{%- endif -%}
{ "id": {{ guide_starter_vid }}, "key": "starter_guide" }
{%- assign gift_comma = true -%}
{%- endif -%}
{%- if guide_cacao_vid != blank -%}
{%- if gift_comma -%},{%- endif -%}
{ "id": {{ guide_cacao_vid }}, "key": "cacao_recipe_guide" }
{%- assign gift_comma = true -%}
{%- endif -%}
{%- if guide_vegan_vid != blank -%}
{%- if gift_comma -%},{%- endif -%}
{ "id": {{ guide_vegan_vid }}, "key": "vegan_recipe_guide" }
{%- endif -%}
],
"subscribeOnly": [
{%- if shaker_variant_id != blank -%}
{ "id": {{ shaker_variant_id }}, "key": "cleanblend_shaker" }
{%- endif -%}
]
},
"tiers": [
{
"key": "1",
"qty": 1,
"firstPrice": "68.99",
"renewPrice": "99.99",
"oncePrice": "",
"sellingPlanId": {{ seal_plan_1 | json }}
},
{
"key": "2",
"qty": 2,
"firstPrice": "133.98",
"renewPrice": "179.98",
"oncePrice": "",
"sellingPlanId": {{ seal_plan_2 | json }}
},
{
"key": "3",
"qty": 3,
"firstPrice": "195.99",
"renewPrice": "239.97",
"oncePrice": "",
"sellingPlanId": {{ seal_plan_3 | json }}
}
]
}
{%- endcapture -%}


<style>.hbclp__promo,[class*="optimonk"],[id*="optimonk"],iframe[src*="optimonk"]{display:none!important}</style>
<section
id="{{ sid }}"
class="zt-bb2"
data-zt-bb
data-zt-bb-version="v2"
data-zt-bb-config="zt-bb2-config-{{ section.id }}"
data-zt-bb-once-extra="{{ section.settings.once_extra | default: 'Save-A-Scoop included' | escape }}"
style="
--zt-bb2-primary: {{ section.settings.primary_color }};
--zt-bb2-pad-top: 24px;
--zt-bb2-pad-bottom: 40px;
--zt-bb2-width: {{ layout_width }}px;
--zt-bb2-bag-cols: 3;
"
{{ section.shopify_attributes }}
>
<script type="application/json" id="zt-bb2-config-{{ section.id }}">{{ buybox_config }}</script>

<div class="zt-bb2__inner" id="purchase">
{% render 'zt-bf-bb-gallery', section: section, bb_product: bb_product, slide_1: slide_1 %}

{% render 'zt-bf-bb-panel', section: section, sid: sid, details_id: details_id, reviews_id: reviews_id, variant_id: variant_id %}
</div>

{% render 'zt-bf-bb-nutrition', section: section %}

{% render 'zt-bf-bb-extras', sid: sid %}
</section>

{%- comment -%}
Live theme cart type can be "page" or "notification". Those modes do not print a drawer.
This slot adds Dawn's existing drawer only on this landing page, so "Open cart drawer"
works here while other templates keep the theme cart setting.
{%- endcomment -%}
{%- comment -%} Nov 13 2026: skipped on cacao-lp* templates; the layout already renders the cart drawer (fixes "CartDrawer has already been declared"). {%- endcomment -%}
{%- unless settings.cart_type == 'drawer' or template.suffix contains 'cacao-lp' -%}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
<div data-zt-bb-drawer-slot>
{%- render 'cart-drawer' -%}
</div>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

