{%- render 'zt-diff-head' -%}
<section class="zt-d zt-d-blends" id="{{ section.settings.anchor | default: 'inside' }}">
  <div class="zt-d__wrap">
    <div class="zt-d-blends__head">
      {%- if section.settings.eyebrow != blank -%}<p class="zt-d__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="zt-d__h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="zt-d-blends__row">
      {%- for block in section.blocks -%}
        {%- assign lines = block.settings.ingredients | newline_to_br | split: '<br />' -%}
        <article class="zt-d-blend zt-d-blend--{{ block.settings.theme }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 600px, 100vw', alt: block.settings.image.alt }}
          {%- endif -%}
          <div class="zt-d-blend__body">
            <div class="zt-d-blend__top">
              <h3>{{ block.settings.title }}</h3>
              <span class="zt-d-blend__stat">{{ block.settings.stat }}</span>
            </div>
            {%- if block.settings.text != blank -%}<p class="zt-d-blend__text">{{ block.settings.text }}</p>{%- endif -%}
            <ul class="zt-d-blend__ings" role="list">
              {%- for line in lines -%}
                {%- assign parts = line | strip | split: '|' -%}
                {%- assign ing = parts[0] | strip -%}
                {%- if ing != blank -%}
                  {%- assign tag = parts[1] | strip -%}
                  <li class="zt-d-blend__ing"><b>{{ ing }}</b>{%- if tag != blank -%}<span class="zt-d-blend__tag zt-d-blend__tag--{{ tag | handleize }}">{{ tag }}</span>{%- endif -%}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if block.settings.button != blank -%}
              <a class="zt-d__btn {% if block.settings.theme == 'light' %}zt-d__btn--purple{% else %}zt-d__btn--teal{% endif %}" href="{{ block.settings.link }}">{{ block.settings.button }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Difference: blends",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHAT'S INSIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two blends. One standard." },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "inside" }
  ],
  "blocks": [
    { "type": "blend", "name": "Blend", "limit": 2, "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "title", "label": "Title", "default": "Zeotein Cacao" },
      { "type": "text", "id": "stat", "label": "Stat line", "default": "23g protein · 0g sugar" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "textarea", "id": "ingredients", "label": "Ingredients, one per line: Name | TAG" },
      { "type": "text", "id": "button", "label": "Button" },
      { "type": "url", "id": "link", "label": "Button link" },
      { "type": "select", "id": "theme", "label": "Style", "default": "dark", "options": [ { "value": "dark", "label": "Deep purple" }, { "value": "light", "label": "Light teal" } ] }
    ] }
  ],
  "presets": [{ "name": "Difference: blends" }]
}
{% endschema %}
