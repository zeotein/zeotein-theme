{%- render 'zt-diff-head' -%}
<section class="zt-d zt-d-flex">
  <div class="zt-d__wrap">
    <div class="zt-d-flex__row">
      <div class="zt-d-flex__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 840', sizes: '(min-width: 990px) 420px, 100vw', alt: section.settings.image.alt }}
        {%- endif -%}
      </div>
      <div class="zt-d-flex__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="zt-d__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="zt-d__h2">{{ section.settings.heading }}</h2>
        <div class="zt-d-flex__cads">
          {%- for i in (1..3) -%}
            {%- assign t = 'cad' | append: i -%}{%- assign s = 'cad' | append: i | append: '_sub' -%}
            {%- if section.settings[t] != blank -%}<div class="zt-d-flex__cad"><b>{{ section.settings[t] }}</b><span>{{ section.settings[s] }}</span></div>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- assign chips = section.settings.chips | split: ',' -%}
        <ul class="zt-d-flex__chips" role="list">{%- for c in chips -%}{%- assign cc = c | strip -%}{%- if cc != blank -%}<li>{{ cc }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- if section.settings.text != blank -%}<p class="zt-d-flex__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Difference: flexible",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INTENTIONAL, BUT FLEXIBLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your routine. Your schedule." },
    { "type": "text", "id": "cad1", "label": "Delivery 1", "default": "Monthly" },
    { "type": "text", "id": "cad1_sub", "label": "Delivery 1 note", "default": "the classic" },
    { "type": "text", "id": "cad2", "label": "Delivery 2", "default": "6 weeks" },
    { "type": "text", "id": "cad2_sub", "label": "Delivery 2 note", "default": "a little more room" },
    { "type": "text", "id": "cad3", "label": "Delivery 3", "default": "8 weeks" },
    { "type": "text", "id": "cad3_sub", "label": "Delivery 3 note", "default": "your own pace" },
    { "type": "text", "id": "chips", "label": "Chips (comma list)", "default": "Skip, Pause, Swap, Cancel anytime" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Difference: flexible" }]
}
{% endschema %}
