{%- render 'zt-diff-head' -%}
<section class="zt-d zt-d-choices">
  <div class="zt-d__wrap">
    <div class="zt-d-choices__head">
      {%- if section.settings.eyebrow != blank -%}<p class="zt-d__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="zt-d__h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="zt-d-choices__grid">
      {%- for block in section.blocks -%}
        <div class="zt-d-card zt-d-card--{{ block.settings.style }}{% if block.settings.teal_title %} zt-d-card--tealtitle{% endif %}" {{ block.shopify_attributes }}>
          <span class="zt-d-card__k">{{ block.settings.kicker }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Difference: choices",
  "tag": "div",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ON PURPOSE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six choices that make Zeotein, Zeotein." }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "kicker", "label": "Small line", "default": "INTENTIONALLY" },
      { "type": "text", "id": "title", "label": "Title", "default": "Simple." },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "select", "id": "style", "label": "Style", "default": "light", "options": [ { "value": "light", "label": "White" }, { "value": "purple", "label": "Purple" }, { "value": "teal", "label": "Teal" } ] },
      { "type": "checkbox", "id": "teal_title", "label": "Teal title (white cards)", "default": false }
    ] }
  ],
  "presets": [{ "name": "Difference: choices" }]
}
{% endschema %}
