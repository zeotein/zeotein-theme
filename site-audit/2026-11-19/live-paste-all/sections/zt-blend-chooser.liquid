{% comment %}
  ZEOTEIN BLEND CHOOSER (Nov 16 2026, simplified 11:30 AM CT per Dana 11:09 AM CT)
  All-in-one chooser page: pick blend (when more than one), Subscribe or One-Time, then one product card.
  One simple choice per product: no 1/2/3 bundle tiers, no "pick 1, 2 or 3" step and no bundle savings line here.
  Multi-bag savings are shown ONLY on each product's own page (snippets/zt-buybox-tidy.liquid, part 'bundle').
  The button opens the real product page. Prices come from the products and their selling plans. Nothing is added to the cart here.
  Nov 16 2026 6:35 PM CT per Dana: no savings callouts on the size cards; each card shows only its real price.
  Photos are a swipeable gallery of the product's own images, shown in full (contain, not cropped).

  Nov 18 2026 (Jewels Roundtable section 08):
  - Each size card shows a gift badge ("+ FREE STARTER KIT" on 30-day sizes, "+ 3 FREE GUIDES" on one-time-only 7-Day sizes)
    and, on the selected card, an inline gift line in the product page style (snippets/zt-ch-perk.liquid; Dana asked for the
    gifts inside the product selection itself).
  - The old "Included free" box is replaced by a gift card (snippets/zt-ch-kit.liquid) listing each item with its struck price
    and FREE, with a value pill that follows the choice. Values are read live from the gift products:
    bag subscribe $62.98, sticks subscribe $55.99, bag one-time $46.99, sticks one-time $40, 7-Day $40 (Nov 18 2026).
  - Gifts per size come from the product unless the size block overrides them (kit_sub / kit_once).
  - Button: "Continue · {price} + Free Starter Kit" (7-Day: "+ 3 Free Guides"); guarantee line under it.
  - The Zeotein FAQ (snippets/zt-faq-content.liquid) with FAQPage schema renders under the chooser (setting faq_set).
{% endcomment %}

{%- liquid
  assign uid = 'zt-chooser-' | append: section.id
  assign blend_count = 0
  for b in section.blocks
    if b.type == 'blend'
      assign blend_count = blend_count | plus: 1
    endif
  endfor
  assign first_blend = ''
  for b in section.blocks
    if b.type == 'blend' and first_blend == ''
      assign first_blend = b.settings.key
    endif
  endfor
  assign zt_ch_blend = false
  for b in section.blocks
    if b.type == 'option' and b.settings.product != blank
      if b.settings.product.tags contains 'protein-blend'
        assign zt_ch_blend = true
      endif
    endif
  endfor
-%}

<section id="{{ uid }}" class="zt-ch" data-zt-chooser data-mode="sub" data-blend="{{ first_blend | escape }}">
  <div class="zt-ch__inner">
    <div class="zt-ch__media">
      {%- for b in section.blocks -%}
        {%- if b.type == 'option' and b.settings.product != blank -%}
          {%- assign p = b.settings.product -%}
          {%- assign zt_imgs = p.media | where: 'media_type', 'image' -%}
          <div class="zt-ch__img-wrap" data-zt-img="{{ b.id }}" {% unless forloop.first %}hidden{% endunless %}>
            <div class="zt-ch__gal" data-zt-gal tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ b.settings.title | escape }} photos">
              {%- if zt_imgs.size > 0 -%}
                {%- for m in zt_imgs -%}
                  {%- liquid
                    assign zt_alt = m.alt | default: b.settings.title
                    assign zt_load = 'lazy'
                    if forloop.first
                      assign zt_load = 'eager'
                    endif
                  -%}
                  <div class="zt-ch__slide">
                    {{ m.preview_image | image_url: width: 1100 | image_tag: loading: zt_load, widths: '450, 700, 900, 1100', sizes: '(min-width: 990px) 50vw, 100vw', class: 'zt-ch__img', alt: zt_alt }}
                  </div>
                {%- endfor -%}
              {%- elsif b.settings.image != blank -%}
                <div class="zt-ch__slide">{{ b.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '450, 700, 900, 1100', sizes: '(min-width: 990px) 50vw, 100vw', class: 'zt-ch__img', alt: b.settings.title }}</div>
              {%- elsif p.featured_image -%}
                <div class="zt-ch__slide">{{ p.featured_image | image_url: width: 1100 | image_tag: loading: 'eager', widths: '450, 700, 900, 1100', sizes: '(min-width: 990px) 50vw, 100vw', class: 'zt-ch__img', alt: b.settings.title }}</div>
              {%- endif -%}
            </div>
            {%- if zt_imgs.size > 1 -%}
              <button type="button" class="zt-ch__gal-btn zt-ch__gal-btn--prev" data-zt-gal-prev aria-label="Previous photo"><svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.5 4.5 7 10l5.5 5.5"/></svg></button>
              <button type="button" class="zt-ch__gal-btn zt-ch__gal-btn--next" data-zt-gal-next aria-label="Next photo"><svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 4.5 13 10l-5.5 5.5"/></svg></button>
              <div class="zt-ch__dots">
                {%- for m in zt_imgs -%}
                  <button type="button" class="zt-ch__dot{% if forloop.first %} is-active{% endif %}" data-zt-dot="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }} of {{ zt_imgs.size }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="zt-ch__panel">
      <h1 class="zt-ch__heading">{{ section.settings.heading }} {% if section.settings.heading_accent != blank %}<span>{{ section.settings.heading_accent }}</span>{% endif %}</h1>
      {%- if section.settings.intro != blank -%}<p class="zt-ch__intro">{{ section.settings.intro }}</p>{%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <p class="zt-ch__rating"><span class="zt-ch__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</p>
      {%- endif -%}

      {%- if blend_count > 1 -%}
        <p class="zt-ch__step" id="{{ uid }}-blend-label">{{ section.settings.blend_step }}</p>
        <div class="zt-ch__blends" role="group" aria-labelledby="{{ uid }}-blend-label">
          {%- for b in section.blocks -%}
            {%- if b.type == 'blend' -%}
              <button type="button" class="zt-ch__blend{% if b.settings.key == first_blend %} is-active{% endif %}" data-zt-blend-btn="{{ b.settings.key | escape }}" aria-pressed="{% if b.settings.key == first_blend %}true{% else %}false{% endif %}" {{ b.shopify_attributes }}>
                <strong>{{ b.settings.label }}</strong>
                {%- if b.settings.sublabel != blank -%}<span>{{ b.settings.sublabel }}</span>{%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <p class="zt-ch__step" id="{{ uid }}-mode-label">{{ section.settings.mode_step }}</p>
      <div class="zt-ch__modes" role="group" aria-labelledby="{{ uid }}-mode-label">
        <button type="button" class="zt-ch__mode is-active" data-zt-mode-btn="sub" aria-pressed="true">{{ section.settings.subscribe_label }}</button>
        <button type="button" class="zt-ch__mode" data-zt-mode-btn="once" aria-pressed="false">{{ section.settings.onetime_label }}</button>
      </div>

      <p class="zt-ch__step" id="{{ uid }}-size-label">{{ section.settings.size_step }}</p>
      <div class="zt-ch__options" role="group" aria-labelledby="{{ uid }}-size-label">
        {%- assign first_done = false -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'option' and b.settings.product != blank -%}
            {%- liquid
              assign p = b.settings.product
              assign v = p.selected_or_first_available_variant
              assign once_price = v.price
              assign sub_price = nil
              assign plan_id = ''
              assign alloc = nil
              if b.settings.one_time_only == false
                if b.settings.selling_plan_id != blank
                  for a in v.selling_plan_allocations
                    assign aid = a.selling_plan.id | append: ''
                    if aid == b.settings.selling_plan_id
                      assign alloc = a
                    endif
                  endfor
                endif
                if alloc == nil
                  assign alloc = v.selling_plan_allocations.first
                endif
              endif
              if alloc
                assign sub_price = alloc.price
                assign plan_id = alloc.selling_plan.id
              endif
              assign is_first = false
              if b.settings.blend == first_blend and first_done == false
                assign is_first = true
                assign first_done = true
              endif
              assign k_sub = b.settings.kit_sub
              assign k_once = b.settings.kit_once
              if b.settings.one_time_only
                assign k_once = k_once | default: 'guides'
              elsif p.handle contains 'bag'
                assign k_sub = k_sub | default: 'shaker,scoop,guides'
                assign k_once = k_once | default: 'scoop,guides'
              else
                assign k_sub = k_sub | default: 'shaker,guides'
                assign k_once = k_once | default: 'guides'
              endif
            -%}
            <button type="button"
              class="zt-ch__opt{% if is_first %} is-active{% endif %}{% if sub_price == nil %} is-once-only{% endif %}"
              data-zt-opt="{{ b.id }}"
              data-blend="{{ b.settings.blend | escape }}"
              data-url="{{ p.url }}"
              data-plan="{{ plan_id }}"
              data-title="{{ b.settings.title | escape }}"
              data-suffix="{% if b.settings.cta_suffix != blank %}{{ b.settings.cta_suffix | escape }}{% elsif b.settings.one_time_only %}3 Free Guides{% else %}Free Starter Kit{% endif %}"
              data-once="{{ once_price | money | escape }}"
              data-sub="{% if sub_price %}{{ sub_price | money | escape }}{% endif %}"
              aria-pressed="{% if is_first %}true{% else %}false{% endif %}"
              {{ b.shopify_attributes }}>
              <span class="zt-ch__opt-thumb">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </span>
              <span class="zt-ch__opt-body">
                <strong class="zt-ch__opt-title">{{ b.settings.title }}</strong>
                {%- if b.settings.description != blank -%}<span class="zt-ch__opt-desc">{{ b.settings.description }}</span>{%- endif -%}
                {%- if b.settings.gift_badge != blank -%}<span class="zt-ch__gbadge">{{ b.settings.gift_badge }}</span>{%- elsif zt_ch_blend -%}<span class="zt-ch__gbadge">{% if b.settings.one_time_only %}+ 3 FREE GUIDES{% else %}+ FREE STARTER KIT{% endif %}</span>{%- endif -%}
                {%- if sub_price == nil -%}
                  <span class="zt-ch__opt-note">{{ section.settings.once_only_label }}</span>
                {%- endif -%}
              </span>
              <span class="zt-ch__opt-price">
                {%- if sub_price -%}
                  <span class="zt-ch__sub-only"><strong>{{ sub_price | money }}</strong></span>
                  <span class="zt-ch__once-only"><strong>{{ once_price | money }}</strong></span>
                {%- else -%}
                  <strong>{{ once_price | money }}</strong>
                {%- endif -%}
              </span>
              {%- if zt_ch_blend -%}
                {%- if b.settings.one_time_only -%}
                  {%- render 'zt-ch-perk', csv: k_once, kind: 'trial', mode_class: '' -%}
                {%- else -%}
                  {%- render 'zt-ch-perk', csv: k_sub, kind: 'sub', mode_class: 'zt-ch__sub-only' -%}
                  {%- render 'zt-ch-perk', csv: k_once, kind: 'once', mode_class: 'zt-ch__once-only' -%}
                {%- endif -%}
              {%- endif -%}
              {%- if b.settings.badge != blank -%}<span class="zt-ch__badge">{{ b.settings.badge }}</span>{%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if zt_ch_blend -%}
      <div class="zt-ch__kits">
        {%- for b in section.blocks -%}
          {%- if b.type == 'option' and b.settings.product != blank -%}
            {%- liquid
              assign k_h = b.settings.product.handle
              assign k_title = b.settings.kit_title
              assign k_sub = b.settings.kit_sub
              assign k_once = b.settings.kit_once
              if b.settings.one_time_only
                assign k_title = k_title | default: 'Your 3 FREE Guides'
                assign k_once = k_once | default: 'guides'
              else
                assign k_title = k_title | default: 'Your FREE Starter Kit'
                if k_h contains 'bag'
                  assign k_sub = k_sub | default: 'shaker,scoop,guides'
                  assign k_once = k_once | default: 'scoop,guides'
                else
                  assign k_sub = k_sub | default: 'shaker,guides'
                  assign k_once = k_once | default: 'guides'
                endif
              endif
            -%}
            <div data-zt-gifts="{{ b.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {%- if b.settings.one_time_only -%}
                {%- render 'zt-ch-kit', csv: k_once, title: k_title, note: section.settings.kit_note, mode_class: '' -%}
              {%- else -%}
                {%- render 'zt-ch-kit', csv: k_sub, title: k_title, note: section.settings.kit_note, mode_class: 'zt-ch__sub-only' -%}
                {%- render 'zt-ch-kit', csv: k_once, title: k_title, note: section.settings.kit_note, mode_class: 'zt-ch__once-only' -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- endif -%}

      <a class="zt-ch__cta" href="#" data-zt-cta>
        <span data-zt-cta-label>{{ section.settings.cta_label }}</span>
        <span class="zt-ch__cta-sep" aria-hidden="true">&middot;</span>
        <span class="zt-ch__cta-price" data-zt-cta-price></span>
      </a>
      <p class="zt-ch__note" data-zt-summary aria-live="polite"></p>
      {%- if zt_ch_blend and section.settings.guarantee_text != blank -%}
        <p class="zt-ch__guar"><svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><span>{{ section.settings.guarantee_text }}</span></p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- liquid
  assign zt_faq_set = section.settings.faq_set
  if zt_faq_set == 'auto'
    assign zt_faq_set = 'all'
    assign zt_has_cacao = false
    for b in section.blocks
      if b.type == 'option' and b.settings.product != blank and b.settings.product.handle contains 'cacao'
        assign zt_has_cacao = true
      endif
    endfor
    if zt_has_cacao == false
      assign zt_faq_set = 'vegan'
    endif
  endif
-%}
{%- if zt_ch_blend and zt_faq_set != 'none' -%}
  {{ 'zt-faq.css' | asset_url | stylesheet_tag }}
  <section id="{{ uid }}-faq" class="zt-faq zt-ch-faq" aria-labelledby="{{ uid }}-faq-h">
    <div class="zt-faq__container">
      <div class="zt-faq__header"><div class="zt-faq__eyebrow">QUESTIONS, ANSWERED</div><h2 id="{{ uid }}-faq-h" class="zt-faq__heading">{{ section.settings.faq_heading }}</h2></div>
      <div class="zt-faq__list">{%- render 'zt-faq-content', set: zt_faq_set, schema: true -%}</div>
    </div>
  </section>
{%- endif -%}

