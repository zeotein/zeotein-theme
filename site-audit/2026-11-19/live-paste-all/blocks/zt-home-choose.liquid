{% comment %}
  ZEOTEIN HOMEPAGE: CHOOSE YOUR ZEOTEIN (Nov 2026)
  Replaces choose-you-zeotein on the homepage. Three cards: Cacao, Vegan, Single Ingredients.
  Nov 18 2026: Cacao and Vegan cards show "30-Day + FREE STARTER KIT" and "7-Day + 3 FREE GUIDES" badges and an
  "Up to [value] in free gifts" line. Values are read live from the gift products (Cacao $62.98, Vegan $55.99).
{% endcomment %}

{% liquid
  assign cacao = block.settings.cacao_product
  if cacao == blank
    assign cacao = all_products['zeotein-cacao-sticks-7']
  endif
  assign vegan = block.settings.vegan_product
  if vegan == blank
    assign vegan = all_products['zeotein-vegan-sticks-7']
  endif
  assign uid = 'zt-home-choose-' | append: block.id
  assign zg_shaker = all_products['zeotein-cleanblend-shaker-27oz-usa-made'].price
  assign zg_scoop = all_products['save-a-scoop'].price
  assign zg_guides = all_products['zeotein-starter-guide'].price | plus: all_products['cacao-recipe-guide'].price | plus: all_products['vegan-recipe-guide'].price
  assign zg_cacao_val = zg_shaker | plus: zg_scoop | plus: zg_guides | money_without_trailing_zeros
  assign zg_vegan_val = zg_shaker | plus: zg_guides | money_without_trailing_zeros
%}

<section id="{{ uid }}" class="zt-home-choose" {{ block.shopify_attributes }}>
  <div class="zt-home-choose__inner">
    <p class="zt-home-choose__eyebrow">{{ block.settings.eyebrow }}</p>
    <h2 class="zt-home-choose__heading">{{ block.settings.heading }}</h2>

    <div class="zt-home-choose__grid">
      <div class="zt-home-choose__card">
        <a class="zt-home-choose__media" href="{{ block.settings.cacao_url | default: '/collections/zeotein' }}" tabindex="-1" aria-hidden="true">
          {% if block.settings.cacao_image != blank %}
            {{ block.settings.cacao_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', class: 'zt-home-choose__img', alt: 'Zeotein Cacao pouch with cacao and a chocolate shake' }}
          {% elsif cacao.featured_image %}
            {{ cacao.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'zt-home-choose__img', alt: 'Zeotein Cacao' }}
          {% endif %}
          {% if block.settings.cacao_badge != blank %}
            <span class="zt-home-choose__badge">{{ block.settings.cacao_badge }}</span>
          {% endif %}
        </a>
        <div class="zt-home-choose__body">
          <p class="zt-home-choose__label">{{ block.settings.cacao_label }}</p>
          <h3 class="zt-home-choose__title">{{ block.settings.cacao_title }}</h3>
          <p class="zt-home-choose__text">{{ block.settings.cacao_text }}</p>
          <p class="zt-home-choose__detail">{{ block.settings.cacao_detail }}</p>
          {%- if block.settings.gift_30 != blank or block.settings.gift_7 != blank -%}
            <div class="zt-home-choose__gifts">
              {%- if block.settings.gift_30 != blank -%}<span class="zt-home-choose__gift"><em>30-Day</em> {{ block.settings.gift_30 }}</span>{%- endif -%}
              {%- if block.settings.gift_7 != blank -%}<span class="zt-home-choose__gift"><em>7-Day</em> {{ block.settings.gift_7 }}</span>{%- endif -%}
            </div>
            {%- if block.settings.gift_note != blank -%}<p class="zt-home-choose__gift-note">{{ block.settings.gift_note | replace: '[value]', zg_cacao_val }}</p>{%- endif -%}
          {%- endif -%}
          <a class="zt-home-choose__button" href="{{ block.settings.cacao_url | default: '/collections/zeotein' }}">{{ block.settings.cacao_button }}</a>
        </div>
      </div>

      <div class="zt-home-choose__card">
        <a class="zt-home-choose__media" href="{{ block.settings.vegan_url | default: '/collections/zeotein-vegan-1' }}" tabindex="-1" aria-hidden="true">
          {% if block.settings.vegan_image != blank %}
            {{ block.settings.vegan_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', class: 'zt-home-choose__img', alt: 'Zeotein Vegan pouch with seeds and a plant-based shake' }}
          {% elsif vegan.featured_image %}
            {{ vegan.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'zt-home-choose__img', alt: 'Zeotein Vegan' }}
          {% endif %}
        </a>
        <div class="zt-home-choose__body">
          <p class="zt-home-choose__label zt-home-choose__label--teal">{{ block.settings.vegan_label }}</p>
          <h3 class="zt-home-choose__title">{{ block.settings.vegan_title }}</h3>
          <p class="zt-home-choose__text">{{ block.settings.vegan_text }}</p>
          <p class="zt-home-choose__detail">{{ block.settings.vegan_detail }}</p>
          {%- if block.settings.gift_30 != blank or block.settings.gift_7 != blank -%}
            <div class="zt-home-choose__gifts">
              {%- if block.settings.gift_30 != blank -%}<span class="zt-home-choose__gift"><em>30-Day</em> {{ block.settings.gift_30 }}</span>{%- endif -%}
              {%- if block.settings.gift_7 != blank -%}<span class="zt-home-choose__gift"><em>7-Day</em> {{ block.settings.gift_7 }}</span>{%- endif -%}
            </div>
            {%- if block.settings.gift_note != blank -%}<p class="zt-home-choose__gift-note">{{ block.settings.gift_note | replace: '[value]', zg_vegan_val }}</p>{%- endif -%}
          {%- endif -%}
          <a class="zt-home-choose__button" href="{{ block.settings.vegan_url | default: '/collections/zeotein-vegan-1' }}">{{ block.settings.vegan_button }}</a>
        </div>
      </div>

      <div class="zt-home-choose__card">
        <a class="zt-home-choose__media" href="{{ block.settings.singles_url | default: '/collections/single-ingredient-supplements' }}" tabindex="-1" aria-hidden="true">
          {% if block.settings.singles_image != blank %}
            {{ block.settings.singles_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 33vw, 100vw', class: 'zt-home-choose__img', alt: 'Zeotein Collagen Peptides, MCT Oil and Hemp Protein pouches' }}
          {% else %}
            <img class="zt-home-choose__img" src="{{ 'zt-home-singles.jpg' | asset_url }}" alt="Zeotein Collagen Peptides, MCT Oil and Hemp Protein pouches on a wooden table" width="1024" height="1024" loading="lazy">
          {% endif %}
        </a>
        <div class="zt-home-choose__body">
          <p class="zt-home-choose__label">{{ block.settings.singles_label }}</p>
          <h3 class="zt-home-choose__title">{{ block.settings.singles_title }}</h3>
          <p class="zt-home-choose__text">{{ block.settings.singles_text }}</p>
          <p class="zt-home-choose__detail">{{ block.settings.singles_detail }}</p>
          <a class="zt-home-choose__button" href="{{ block.settings.singles_url | default: '/collections/single-ingredient-supplements' }}">{{ block.settings.singles_button }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #{{ uid }} { background: #f8f5f0; padding: 60px 24px; }
  #{{ uid }} .zt-home-choose__inner { max-width: 1200px; margin: 0 auto; }
  #{{ uid }} .zt-home-choose__eyebrow { margin: 0; text-align: center; color: #5a3a86; font-size: 12px; font-weight: 600; letter-spacing: .14em; }
  #{{ uid }} .zt-home-choose__heading { margin: 8px 0 0; text-align: center; color: #35164f; font-size: clamp(32px, 4vw, 48px); font-weight: 600; letter-spacing: -0.03em; }
  #{{ uid }} .zt-home-choose__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 30px; }
  #{{ uid }} .zt-home-choose__card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid #ece7f1; border-radius: 20px; background: #ffffff; }
  #{{ uid }} .zt-home-choose__media { position: relative; display: block; aspect-ratio: 1; background: #f1eee9; }
  #{{ uid }} .zt-home-choose__img { display: block; width: 100%; height: 100%; object-fit: cover; }
  #{{ uid }} .zt-home-choose__badge { position: absolute; left: 14px; top: 14px; padding: 6px 12px; border-radius: 999px; background: #ffffff; color: #35164f; font-size: 12px; font-weight: 700; }
  #{{ uid }} .zt-home-choose__body { display: flex; flex: 1; flex-direction: column; padding: 18px 20px 20px; }
  #{{ uid }} .zt-home-choose__label { margin: 0; color: #5a3a86; font-size: 12px; font-weight: 600; letter-spacing: .08em; }
  #{{ uid }} .zt-home-choose__label--teal { color: #17625f; }
  #{{ uid }} .zt-home-choose__title { margin: 4px 0 0; color: #35164f; font-size: 27px; font-weight: 600; }
  #{{ uid }} .zt-home-choose__text { flex: 1 0 auto; margin: 6px 0 0; color: #4a3b5a; font-size: 15px; line-height: 1.45; }
  #{{ uid }} .zt-home-choose__detail { margin: 12px 0 0; padding-top: 12px; border-top: 1px solid #ece7f1; color: #35164f; font-size: 15px; font-weight: 700; }
  #{{ uid }} .zt-home-choose__gifts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  #{{ uid }} .zt-home-choose__gift { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; background: #32BAC0; color: #0b2c2e; font-size: 11.5px; font-weight: 800; letter-spacing: .04em; }
  #{{ uid }} .zt-home-choose__gift em { font-style: normal; font-weight: 700; padding-right: 5px; border-right: 1px solid rgba(11, 44, 46, .35); }
  #{{ uid }} .zt-home-choose__gift-note { margin: 8px 0 0; color: #4a3b5a; font-size: 13.5px; line-height: 1.4; }
  #{{ uid }} .zt-home-choose__gift-note b, #{{ uid }} .zt-home-choose__gift-note strong { color: #5F2D90; }
  #{{ uid }} .zt-home-choose__button { display: flex; align-items: center; justify-content: center; min-height: 48px; margin-top: 12px; border-radius: 999px; background: #47206b; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; }
  #{{ uid }} .zt-home-choose__button:hover { background: #35164f; }
  @media screen and (max-width: 989px) {
    #{{ uid }} .zt-home-choose__grid { grid-template-columns: 1fr; max-width: 520px; margin-left: auto; margin-right: auto; }
  }
  @media screen and (max-width: 749px) {
    #{{ uid }} { padding: 40px 16px; }
    #{{ uid }} .zt-home-choose__title { font-size: 24px; }
  }
</style>

{% schema %}
{
  "name": "Zeotein Home Choose",
  "tag": "section",
  "class": "section-zt-home-choose",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND YOUR FIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Zeotein" },
    { "type": "header", "content": "Cacao" },
    { "type": "product", "id": "cacao_product", "label": "Cacao product" },
    { "type": "image_picker", "id": "cacao_image", "label": "Cacao image" },
    { "type": "text", "id": "cacao_badge", "label": "Badge", "default": "Most Popular" },
    { "type": "text", "id": "cacao_label", "label": "Label", "default": "ANIMAL-BASED PROTEIN BLEND" },
    { "type": "text", "id": "cacao_title", "label": "Title", "default": "Zeotein Cacao" },
    { "type": "text", "id": "cacao_text", "label": "Text", "default": "Grass-fed collagen peptides and grass-fed beef bone broth." },
    { "type": "text", "id": "cacao_detail", "label": "Detail", "default": "23g protein" },
    { "type": "text", "id": "cacao_button", "label": "Button", "default": "Shop Cacao" },
    { "type": "url", "id": "cacao_url", "label": "Button link" },
    { "type": "header", "content": "Free gifts (Cacao and Vegan cards)" },
    { "type": "text", "id": "gift_30", "label": "30-Day gift badge", "default": "+ FREE STARTER KIT" },
    { "type": "text", "id": "gift_7", "label": "7-Day gift badge", "default": "+ 3 FREE GUIDES" },
    { "type": "text", "id": "gift_note", "label": "Gift line", "info": "[value] = the top gift value, read live from the gift products", "default": "Up to <b>[value]</b> in free gifts with your first order" },
    { "type": "header", "content": "Vegan" },
    { "type": "product", "id": "vegan_product", "label": "Vegan product" },
    { "type": "image_picker", "id": "vegan_image", "label": "Vegan image" },
    { "type": "text", "id": "vegan_label", "label": "Label", "default": "PLANT-BASED PROTEIN BLEND" },
    { "type": "text", "id": "vegan_title", "label": "Title", "default": "Zeotein Vegan" },
    { "type": "text", "id": "vegan_text", "label": "Text", "default": "Organic hemp and pumpkin seed protein." },
    { "type": "text", "id": "vegan_detail", "label": "Detail", "default": "20g plant protein" },
    { "type": "text", "id": "vegan_button", "label": "Button", "default": "Shop Vegan" },
    { "type": "url", "id": "vegan_url", "label": "Button link" },
    { "type": "header", "content": "Single Ingredients" },
    { "type": "image_picker", "id": "singles_image", "label": "Image (blank uses the built-in photo)" },
    { "type": "text", "id": "singles_label", "label": "Label", "default": "ONE INGREDIENT AT A TIME" },
    { "type": "text", "id": "singles_title", "label": "Title", "default": "Single Ingredients" },
    { "type": "text", "id": "singles_text", "label": "Text", "default": "Collagen, bone broth, hemp, MCT, sea moss and more." },
    { "type": "text", "id": "singles_detail", "label": "Detail", "default": "9 ingredients to choose from" },
    { "type": "text", "id": "singles_button", "label": "Button", "default": "Shop Single Ingredients" },
    { "type": "url", "id": "singles_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Zeotein Home Choose" }]
}
{% endschema %}
