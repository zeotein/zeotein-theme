{%- comment -%}
  Inline gift line inside a chooser size card (Nov 18 2026, Dana: show the free gifts in the product selection
  itself, same look as the product page perk in snippets/zt-buybox-tidy.liquid part 'perks').
  csv: shaker, scoop, guides. kind: 'sub' | 'once' | 'trial'. mode_class: zt-ch__sub-only | zt-ch__once-only | ''.
  Values are read live from the gift products, so they always match the store.
{%- endcomment -%}
{%- liquid
  assign p_list = csv | remove: ' ' | split: ','
  assign p_value = 0
  assign p_names = ''
  assign p_shaker = all_products['zeotein-cleanblend-shaker-27oz-usa-made']
  assign p_scoop = all_products['save-a-scoop']
  assign p_g1 = all_products['zeotein-starter-guide']
  assign p_g2 = all_products['cacao-recipe-guide']
  assign p_g3 = all_products['vegan-recipe-guide']
  assign p_guides = p_g1.price | plus: p_g2.price | plus: p_g3.price
  for g in p_list
    case g
      when 'shaker'
        assign p_value = p_value | plus: p_shaker.price
        assign p_n = 'shaker'
      when 'scoop'
        assign p_value = p_value | plus: p_scoop.price
        assign p_n = 'Save-A-Scoop'
      when 'guides'
        assign p_value = p_value | plus: p_guides
        assign p_n = '3 guides'
    endcase
    if forloop.first
      assign p_names = p_n
    elsif forloop.last
      assign p_names = p_names | append: ' + ' | append: p_n
    else
      assign p_names = p_names | append: ', ' | append: p_n
    endif
  endfor
-%}
<span class="zt-ch__perk zt-ch__perk--{{ kind }} {{ mode_class }}">
  <span class="zt-ch__perk-thumbs" aria-hidden="true">
    {%- for g in p_list -%}
      {%- case g -%}
        {%- when 'shaker' -%}{%- if p_shaker.featured_image -%}<img src="{{ p_shaker.featured_image | image_url: width: 72 }}" alt="" width="30" height="30" loading="lazy">{%- endif -%}
        {%- when 'scoop' -%}{%- if p_scoop.featured_image -%}<img src="{{ p_scoop.featured_image | image_url: width: 72 }}" alt="" width="30" height="30" loading="lazy">{%- endif -%}
        {%- when 'guides' -%}<span class="zt-ch__perk-fan">{%- for gg in (1..3) -%}{%- case gg -%}{%- when 1 -%}{%- assign gp = p_g2 -%}{%- when 2 -%}{%- assign gp = p_g3 -%}{%- else -%}{%- assign gp = p_g1 -%}{%- endcase -%}{%- if gp.featured_image -%}<img src="{{ gp.featured_image | image_url: width: 72, height: 96, crop: 'center' }}" alt="" width="20" height="28" loading="lazy">{%- endif -%}{%- endfor -%}</span>
      {%- endcase -%}
    {%- endfor -%}
  </span>
  <span class="zt-ch__perk-txt">
    {%- case kind -%}
      {%- when 'sub' -%}<b>Free Starter Kit</b> &middot; {{ p_value | money_without_trailing_zeros }} value<small>With your first subscription: {{ p_names }}</small>
      {%- when 'trial' -%}<b>3 Free Guides</b> &middot; {{ p_value | money_without_trailing_zeros }} value<small>With your first order: Starter Guide, Cacao and Vegan Recipe Guides</small>
      {%- else -%}<b>Free with your first order:</b> {{ p_names | replace: '3 guides', '3 digital guides' | replace: ' + ', ' and ' }} &middot; {{ p_value | money_without_trailing_zeros }} value
    {%- endcase -%}
  </span>
</span>
