<script>
  (function () {
    var root = document.getElementById('{{ uid }}');
    if (!root) return;
    var opts = Array.prototype.slice.call(root.querySelectorAll('[data-zt-opt]'));
    var cta = root.querySelector('[data-zt-cta]');
    var ctaPrice = root.querySelector('[data-zt-cta-price]');
    var summary = root.querySelector('[data-zt-summary]');
    var subLabel = {{ section.settings.subscribe_label | json }};
    var onceLabel = {{ section.settings.onetime_label | json }};
    function active() { return root.querySelector('[data-zt-opt].is-active'); }
    function setPressed(list, el) {
      list.forEach(function (b) { var on = b === el; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    }
    var modeBtns = Array.prototype.slice.call(root.querySelectorAll('[data-zt-mode-btn]'));
    var rememberedMode = root.getAttribute('data-mode') || 'sub';
    function applyMode(mode) {
      root.setAttribute('data-mode', mode);
      var btn = root.querySelector('[data-zt-mode-btn="' + mode + '"]');
      if (btn) setPressed(modeBtns, btn);
    }
    function sync() {
      var blend = root.getAttribute('data-blend');
      opts.forEach(function (o) { o.hidden = !!blend && o.getAttribute('data-blend') !== blend; });
      var cur = active();
      if (!cur || cur.hidden) { cur = opts.filter(function (o) { return !o.hidden; })[0]; if (cur) setPressed(opts, cur); }
      if (!cur) return;
      if (!cur.getAttribute('data-sub')) {
        if (root.getAttribute('data-mode') === 'sub') applyMode('once');
      } else if (rememberedMode && root.getAttribute('data-mode') !== rememberedMode) {
        applyMode(rememberedMode);
      }
      var mode = root.getAttribute('data-mode');
      var id = cur.getAttribute('data-zt-opt');
      root.querySelectorAll('[data-zt-img]').forEach(function (el) { el.hidden = el.getAttribute('data-zt-img') !== id; });
      root.querySelectorAll('[data-zt-gifts]').forEach(function (el) { el.hidden = el.getAttribute('data-zt-gifts') !== id; });
      var sub = cur.getAttribute('data-sub');
      var useSub = mode === 'sub' && sub;
      var url = cur.getAttribute('data-url');
      if (useSub && cur.getAttribute('data-plan')) url += (url.indexOf('?') > -1 ? '&' : '?') + (cur.getAttribute('data-plan') === 'route' ? 'zt_sub=1' : 'selling_plan=' + cur.getAttribute('data-plan'));
      cta.setAttribute('href', url);
      ctaPrice.textContent = (useSub ? sub : cur.getAttribute('data-once'));
      cta.setAttribute('aria-label', cur.getAttribute('data-title') + ', ' + (useSub ? subLabel : onceLabel) + ', ' + ctaPrice.textContent);
      if (summary) summary.textContent = cur.getAttribute('data-title') + ', ' + (useSub ? subLabel : onceLabel);
    }
    root.querySelectorAll('[data-zt-blend-btn]').forEach(function (b, i, all) {
      b.addEventListener('click', function () { root.setAttribute('data-blend', b.getAttribute('data-zt-blend-btn')); setPressed(Array.prototype.slice.call(all), b); sync(); });
    });
    modeBtns.forEach(function (b) {
      b.addEventListener('click', function () {
        rememberedMode = b.getAttribute('data-zt-mode-btn');
        applyMode(rememberedMode);
        sync();
      });
    });
    opts.forEach(function (o) {
      o.addEventListener('click', function () {
        setPressed(opts, o);
        sync();
      });
    });
    (function () {
      var m = location.search.match(/[?&]zt_pill=(best_value|best_seller|none)/);
      var S = window.Shopify || {};
      if (!m || !(S.designMode || (S.theme && S.theme.role && S.theme.role !== 'main'))) return;
      root.querySelectorAll('[data-zt-pill]').forEach(function (p) {
        p.hidden = m[1] === 'none';
        p.textContent = m[1] === 'best_seller' ? p.getAttribute('data-seller') : p.getAttribute('data-value');
      });
    })();
    root.querySelectorAll('.zt-ch__img-wrap').forEach(function (wrap) {
      var gal = wrap.querySelector('[data-zt-gal]');
      if (!gal) return;
      var dots = Array.prototype.slice.call(wrap.querySelectorAll('[data-zt-dot]'));
      var prev = wrap.querySelector('[data-zt-gal-prev]');
      var next = wrap.querySelector('[data-zt-gal-next]');
      var count = gal.children.length;
      function idx() { var w = gal.clientWidth || 1; return Math.max(0, Math.min(count - 1, Math.round(gal.scrollLeft / w))); }
      function go(i) { gal.scrollTo({ left: i * gal.clientWidth, behavior: 'smooth' }); }
      function mark() {
        var i = idx();
        dots.forEach(function (d, j) { d.classList.toggle('is-active', j === i); d.setAttribute('aria-current', j === i ? 'true' : 'false'); });
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === count - 1;
      }
      var t;
      gal.addEventListener('scroll', function () { clearTimeout(t); t = setTimeout(mark, 60); }, { passive: true });
      dots.forEach(function (d, j) { d.addEventListener('click', function () { go(j); }); });
      if (prev) prev.addEventListener('click', function () { go(idx() - 1); });
      if (next) next.addEventListener('click', function () { go(idx() + 1); });
      gal.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(idx() + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx() - 1); }
      });
      mark();
    });
    sync();
  })();
</script>

<script>(function () { var root = document.getElementById('{{ uid }}'); if (!root) return; var box = root.querySelector('[data-zt-qty]'); var cta = root.querySelector('[data-zt-cta]'); var ctaLabel = root.querySelector('[data-zt-cta-label]'); var ctaPrice = root.querySelector('[data-zt-cta-price]'); if (!box || !cta) return; var qBtns = Array.prototype.slice.call(box.querySelectorAll('[data-zt-q]')); var q = 1; var TIERS = [0, 10, 20], BF_TIERS = [30, 37, 44]; var ROUTE_PLAN = '6730842325'; function money(c) { return '$' + (Math.round(c) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } function unitNow(base, pct) { return base - Math.floor(base * pct / 100 + 1e-7); } function isBF() { var el = root.querySelector('.zt-ch__bf[data-ztbf-start]'); if (!el) return false; var t = Date.now() / 1000; return t >= Number(el.getAttribute('data-ztbf-start')) && t < Number(el.getAttribute('data-ztbf-end')); } function cur() { return root.querySelector('[data-zt-opt].is-active'); } function useSub(o) { return root.getAttribute('data-mode') === 'sub' && !!o.getAttribute('data-sub-c'); } function render() { var o = cur(); if (!o) return; var tiered = o.getAttribute('data-tiered') === '1'; box.hidden = !tiered; var bfp = box.querySelector('[data-zt-q-bf]'); if (bfp) bfp.hidden = !isBF(); if (!tiered) q = 1; var sub = useSub(o); var base = Number(o.getAttribute(sub ? 'data-sub-c' : 'data-once-c')) || 0; var pcts = isBF() ? BF_TIERS : TIERS; var unit = o.getAttribute('data-unit') === 'box' ? ['box', 'boxes'] : ['bag', 'bags']; qBtns.forEach(function (b) { var n = Number(b.getAttribute('data-zt-q')); var each = unitNow(base, pcts[n - 1]); b.querySelector('[data-zt-q-n]').textContent = n + ' ' + (n === 1 ? unit[0] : unit[1]); b.querySelector('[data-zt-q-save]').textContent = TIERS[n - 1] ? 'Save ' + TIERS[n - 1] + '%' : ''; b.querySelector('[data-zt-q-each]').textContent = money(each) + '/' + unit[0]; b.querySelector('[data-zt-q-tot]').textContent = n > 1 ? money(each * n) + ' total' : ''; var on = n === q; b.classList.toggle('is-active', on); b.setAttribute('aria-checked', on ? 'true' : 'false'); }); if (ctaLabel) ctaLabel.textContent = 'Add to cart'; if (tiered && base) { ctaPrice.textContent = money(unitNow(base, pcts[q - 1]) * q); } cta.setAttribute('aria-label', 'Add to cart, ' + (o.getAttribute('data-title') || '') + (tiered ? ', ' + q + ' ' + (q === 1 ? unit[0] : unit[1]) : '') + ', ' + ctaPrice.textContent); } qBtns.forEach(function (b) { b.addEventListener('click', function () { q = Number(b.getAttribute('data-zt-q')); render(); }); }); root.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('[data-zt-cta]')) return; setTimeout(render, 0); }); cta.addEventListener('click', function (e) { var o = cur(); if (!o || !o.getAttribute('data-variant')) return; e.preventDefault(); if (cta.classList.contains('is-busy')) return; cta.classList.add('is-busy'); var item = { id: Number(o.getAttribute('data-variant')), quantity: o.getAttribute('data-tiered') === '1' ? q : 1 }; if (useSub(o)) { var plan = o.getAttribute('data-plan'); if (plan === 'route') plan = ROUTE_PLAN; if (plan) item.selling_plan = Number(plan); } var fallback = cta.getAttribute('href'); fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [item] }) }).then(function (r) { return r.json(); }).then(function (d) { if (!d || d.status || !d.items) throw new Error('add failed'); window.location.href = '/cart'; }).catch(function () { cta.classList.remove('is-busy'); if (fallback && fallback !== '#') window.location.href = fallback; }); }); render(); window.addEventListener('pageshow', function () { cta.classList.remove('is-busy'); render(); }); })();</script>{% schema %}
