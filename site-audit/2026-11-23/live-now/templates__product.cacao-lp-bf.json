    "faq_cacao_lp_6zCNeE": {
      "type": "faq-cacao-lp",
      "blocks": {
        "item_bf_end": {
          "type": "item",
          "settings": {
            "question": "When does the Black Friday price end?",
            "answer": "Monday November 30 at 11:59pm CT. After that the page goes back to everyday pricing.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_2": {
          "type": "item",
          "settings": {
            "question": "What do I pay after my first order?",
            "answer": "One bag renews at [bf_renew_1] every 30 days. Two bags renew at [bf_renew_2] every 60 days and three bags at [bf_renew_3] every 90 days. You can switch to every 6 or 8 weeks in your portal, and cancel anytime.",
            "open_by_default": false
          }
        },
        "item_bf_returning": {
          "type": "item",
          "settings": {
            "question": "Can I use this if I had a subscription before?",
            "answer": "No. The Black Friday price is for first-time subscribers, limit one per customer. If you had a Zeotein subscription before, sign in to your customer portal and restart at the regular price.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_1": {
          "type": "item",
          "settings": {
            "question": "What comes in my Starter Kit?",
            "answer": "A 30-day bulk bag (30 servings), a CleanBlend shaker, a Save-A-Scoop, and three digital guides emailed after you order: the Zeotein Starter Guide, the Cacao Recipe Guide and the Vegan Recipe Guide.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_3": {
          "type": "item",
          "settings": {
            "question": "What does it taste like?",
            "answer": "Zeotein Cacao tastes like deep, unsweetened chocolate, and Zeotein Vegan has a mild, earthy taste from organic hemp and pumpkin seed protein.\nNeither blend has added sugar, so you can drink them as they are, blend them with fruit, or stir them into coffee or milk. This is what clean tastes like.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_4": {
          "type": "item",
          "settings": {
            "question": "Is this a whey protein?",
            "answer": "No. The protein comes from grass-fed beef bone broth and grass-fed collagen peptides.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_ingredients": {
          "type": "item",
          "settings": {
            "question": "What is in Zeotein Cacao?",
            "answer": "Grass-fed collagen peptides, grass-fed beef bone broth, organic fermented cacao, organic MCT oil powder and organic purple and gold sea moss. The full ingredient list is under View Nutrition Facts.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_5": {
          "type": "item",
          "settings": {
            "question": "Is it gluten free and dairy free?",
            "answer": "Yes. Zeotein Cacao is gluten free and dairy free.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_6": {
          "type": "item",
          "settings": {
            "question": "When does it ship?",
            "answer": "Orders ship in 1 to 2 business days. Standard U.S. shipping takes 2 to 5 business days after that.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_7": {
          "type": "item",
          "settings": {
            "question": "Can I pause or cancel?",
            "answer": "Yes. Pause, skip, change your date or cancel anytime in your customer portal.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_8": {
          "type": "item",
          "settings": {
            "question": "How does the guarantee work?",
            "answer": "30-day money-back guarantee on our protein blends.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_taste_broth": {
          "type": "item",
          "settings": {
            "question": "Does Zeotein Cacao taste like bone broth?",
            "answer": "No, not even a little: Zeotein Cacao tastes like rich, unsweetened chocolate, not soup.\nThe grass-fed bone broth protein we use is flavorless, so the organic raw fermented cacao is what you taste. With zero sugar and zero artificial sweeteners, it reads more like dark chocolate than milk chocolate. Blend it with a banana or your favorite milk if you like it a little sweeter.",
            "open_by_default": false
          }
        }
      },
