{% comment %}
  BF-only copy of cacao-lp-reviews (used only by product.cacao-lp-bf).
  Same Judge.me store-wide widget, but NO review count anywhere:
  - legacy SSR header/body (contains the count) is not rendered;
  - fallback shows '4.9 stars · Verified reviews' instead of a count;
  - JS swaps the widget's 'N reviews' line for the same sentence and strips
    '(N)' from the tab label; CSS hides medal counts and histogram counts.
  Hero and buy box ratings link to #zt-cacao-reviews.
  @example
  <!-- Add Cacao LP Reviews as the last section on the cacao-lp product template -->
{% endcomment %}

{%- assign zt_rating_line = 'Rated 4.9 stars by verified buyers' -%}

<div id="zt-cacao-reviews" class="zt-cacao-reviews">
  {%- comment -%} Judge.me Happy Customers / All Reviews (store-wide) {%- endcomment -%}
  <div
    id="judgeme_all_reviews"
    class="jdgm-widget jdgm-all-reviews-widget-v2025"
    data-widget="all-reviews-v2025"
    data-auto-install="false"
    data-entry-point="all_reviews_widget_v2025.js"
    data-entry-key="all-reviews-widget-v2025/main.js"
    data-show-all-reviews-in-same-tab="true"
    style="max-width: 1200px; margin: 0 auto;"
  >
    {%- comment -%} BF copy: legacy all_reviews_header not rendered (it prints the review count). {%- endcomment -%}
  </div>

  <script>
    /**
     * Judge.me still stores funnel / renamed handles on some reviews.
     * Shopify redirects work; rewrite to current public URLs before the widget boots.
     */
    (function () {
      var HANDLE_MAP = {
        'zeotein-cacao-bulk-bag-starter-kit-try-99-99-renewal': '/products/cacao-protein-starter-kit',
        'zeotein-cacao-starter-kit': '/products/cacao-protein-starter-kit',
        'zeotein-cacao-bag-30-intro': '/products/cacao-protein-starter-kit',
        'zeotein-cacao-bag-30-try': '/products/cacao-protein-starter-kit',
        'zeotein-cacao-bag-30-lp': '/products/cacao-protein-starter-kit',
        'cacao': '/products/cacao-protein-starter-kit',
        'zeotein-cacao-30-day-bulk-bag-one-time-starter-kit-93-49': '/products/zeotein-cacao-bag-30-onetime',
        'zeotein-cacao-30-day-bulk-powder': '/products/zeotein-cacao-bag-30',
        'zeotein-cacao-sticks-30-sub-go': '/products/zeotein-cacao-sticks-30',
        'zeotein-30-day-supply': '/products/zeotein-cacao-sticks-30',
        'zeotein-protein-cacao': '/products/zeotein-cacao-sticks-7'
      };

      function mappedPath(pathname) {
        var m = String(pathname || '').match(/\/products\/([a-z0-9\-]+)/i);
        if (!m) return null;
        return HANDLE_MAP[m[1].toLowerCase()] || null;
      }

      function rewriteUrl(url) {
        if (!url || typeof url !== 'string') return url;
        try {
          var abs = /^https?:\/\//i.test(url);
          var u = new URL(url, window.location.origin);
          var nextPath = mappedPath(u.pathname);
          if (!nextPath) return url;
          u.pathname = nextPath;
          if (abs) return u.toString();
          return u.pathname + u.search + u.hash;
        } catch (e) {
          return url;
        }
      }

      function rewriteTree(node) {
        if (!node || typeof node !== 'object') return;
        if (Array.isArray(node)) {
          node.forEach(rewriteTree);
          return;
        }
        Object.keys(node).forEach(function (key) {
          var val = node[key];
          if (typeof val === 'string' && /product_url/i.test(key)) {
            node[key] = rewriteUrl(val);
          } else if (val && typeof val === 'object') {
            rewriteTree(val);
          }
        });
      }

      window.ztJdgmRewriteProductUrls = rewriteTree;
      window.ztJdgmRewriteUrl = rewriteUrl;
    })();
  </script>

  {%- if shop.metafields.judgeme.all_reviews_widget_v2025_data -%}
    <script>
      window.jdgm = window.jdgm || {};
      jdgm.data = jdgm.data || {};
      jdgm.data.allReviewsWidgetV2025 = {{ shop.metafields.judgeme.all_reviews_widget_v2025_data }};
      if (window.ztJdgmRewriteProductUrls) window.ztJdgmRewriteProductUrls(jdgm.data.allReviewsWidgetV2025);
    </script>
  {%- endif -%}

  <div id="zt-cacao-reviews-fallback" class="zt-cacao-reviews__fallback" hidden>
    <div class="zt-cacao-reviews__inner">
      <div class="zt-cacao-reviews__head">
        <h2 class="zt-cacao-reviews__title">{{ section.settings.heading | default: 'Customer Reviews' | escape }}</h2>
        <p class="zt-cacao-reviews__summary"><span>{{ zt_rating_line }}</span></p>
      </div>
      <p class="zt-cacao-reviews__note">Loading store reviews...</p>
    </div>
  </div>
</div>

<script>
  (function () {
    var rewriteUrl = window.ztJdgmRewriteUrl || function (u) { return u; };
    var root = document.getElementById('zt-cacao-reviews');
    var widget = document.getElementById('judgeme_all_reviews');
    var fallback = document.getElementById('zt-cacao-reviews-fallback');
    if (!widget || !root) return;

    function hideOneStarReviews() {
      // Individual review cards
      root.querySelectorAll('.jm-review-item').forEach(function (item) {
        var rating = item.querySelector('.jm-star-rating[aria-label]');
        var label = rating && rating.getAttribute('aria-label');
        if (label && /^1(\.0)?\s+out of 5/i.test(label)) {
          item.hidden = true;
          item.setAttribute('data-zt-hidden-rating', '1');
        }
      });
      // Histogram "1 star" row
      root.querySelectorAll('.jm-histogram-row').forEach(function (row) {
        var label = row.getAttribute('aria-label') || '';
        if (/1 star/i.test(label)) {
          row.hidden = true;
          row.setAttribute('data-zt-hidden-rating', '1');
        }
      });
    }

    var RATING_LINE = {{ zt_rating_line | json }};
    var COUNT_IN_PARENS = /\s*\(\s*[\d,]+\s*\)/g;
    function scrubCounts() {
      // Summary: '<score>' '<N> reviews' -> replace the count line with the rating sentence
      root.querySelectorAll('.jm-review-widget-header p.jm-text').forEach(function (p) {
        var t = (p.textContent || '').trim();
        if (/^[\d,.]+\s*reviews?$/i.test(t)) {
          p.textContent = RATING_LINE;
          p.setAttribute('data-zt-count-replaced', '1');
        } else if (/^[\d]+(?:\.[\d]+)?(?:\s*stars)?$/i.test(t)) {
          p.textContent = '';
          p.hidden = true;
          p.setAttribute('data-zt-score-hidden', '1');
        }
      });
      // Tabs / dropdown: 'Product and store reviews (N)' -> 'Product and store reviews'
      root.querySelectorAll('.jdgm-tabs').forEach(function (box) {
        var w = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
        var n;
        while ((n = w.nextNode())) {
          if (/\(\s*[\d,]+\s*\)/.test(n.nodeValue)) n.nodeValue = n.nodeValue.replace(COUNT_IN_PARENS, '');
        }
      });
      if (root.querySelector('.jm-review-widget-header')) root.classList.add('zt-rc-scrubbed');
    }

    function patchDomLinks() {
      root.querySelectorAll('a[href*="/products/"]').forEach(function (a) {
        var next = rewriteUrl(a.getAttribute('href') || a.href);
        if (next && next !== a.getAttribute('href')) a.setAttribute('href', next);
      });
    }

    root.addEventListener(
      'click',
      function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var a = t.closest('a[href*="/products/"]');
        if (a) {
          var next = rewriteUrl(a.href);
          if (next && next !== a.href) a.href = next;
          return;
        }
        // Judge.me v2025 product cards are role=button, not anchors
        var card = t.closest(
          '.jm-product-variant-card__product-link, .jm-product-variant-card__thumbnail, [aria-label*="product page"]'
        );
        if (!card) return;
        var label = card.getAttribute('aria-label') || '';
        // Prefer URL from rewritten jdgm data when available; fall back to known titles
        if (/Starter Kit/i.test(label)) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = '/products/cacao-protein-starter-kit';
          return;
        }
        if (/15% Off|Stick Packs \u2014 Subscription|sub-go/i.test(label)) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = '/products/zeotein-cacao-sticks-30';
        }
      },
      true
    );

    function officialReady() {
      return (
        (widget.classList.contains('jdgm--done-setup-widget') ||
          widget.querySelector('.jdgm-rev-widg, .jdgm-all-reviews-widget, .jm-review-item, [class*="jdgm-rev"]')) &&
        widget.offsetHeight > 80
      );
    }

    var tries = 0;
    var timer = setInterval(function () {
      tries += 1;
      hideOneStarReviews();
      scrubCounts();
      patchDomLinks();
      if (officialReady()) {
        if (fallback) fallback.hidden = true;
        hideOneStarReviews();
        scrubCounts();
        patchDomLinks();
        if (tries >= 8) clearInterval(timer);
        return;
      }
      if (tries === 6) {
        var base = window.jdgm && jdgm.CDN_BASE_URL;
        var src = base ? base + 'all_reviews_widget_v2025.js' : '';
        if (src && !document.querySelector('script[src*="all_reviews_widget_v2025"]')) {
          var script = document.createElement('script');
          script.type = 'module';
          script.src = src;
          document.head.appendChild(script);
        }
      }
      if (tries >= 16) {
        if (fallback) fallback.hidden = false;
        clearInterval(timer);
      }
    }, 150);

    // Re-run when Judge.me paginates / re-renders
    if ('MutationObserver' in window) {
      var MO_OPTS = { childList: true, subtree: true, characterData: true };
      var mo = new MutationObserver(function () {
        mo.disconnect();
        hideOneStarReviews();
        scrubCounts();
        patchDomLinks();
        mo.observe(root, MO_OPTS);
      });
      mo.observe(root, MO_OPTS);
    }
  })();
</script>

<style>
  .zt-cacao-reviews {
    background: #fff;
    scroll-margin-top: 96px;
    padding: 24px 0 48px;
  }

  #judgeme_all_reviews {
    width: min(1200px, calc(100% - 40px));
  }

  .zt-cacao-reviews__inner {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
    padding: 24px 0 32px;
  }

  .zt-cacao-reviews__title {
    margin: 0;
    color: #1a1a1a;
    font-size: 28px;
    line-height: 1.2;
  }

  .zt-cacao-reviews__summary {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin: 8px 0 0;
    color: #1a1a1a;
    font-size: 16px;
  }

  .zt-cacao-reviews__score {
    font-size: 22px;
    font-weight: 700;
  }

  .zt-cacao-reviews__note {
    margin: 16px 0 0;
    color: #3d3d3d;
    font-size: 15px;
  }

  /* BF copy: no review counts. Medals show counts (verified reviews, monthly
     record); histogram rows show per-star counts. The summary and tabs stay
     hidden until scrubCounts() has swapped the count line. */
  #zt-cacao-reviews .jm-medals,
  #zt-cacao-reviews .jm-histogram-row__frequency {
    display: none !important;
  }
  #zt-cacao-reviews:not(.zt-rc-scrubbed) .jm-review-widget-header__summary-section,
  #zt-cacao-reviews:not(.zt-rc-scrubbed) .jdgm-tabs {
    visibility: hidden;
  }

  /* Hide 1-star reviews + histogram row on this LP */
  #zt-cacao-reviews .jm-review-item[data-zt-hidden-rating='1'],
  #zt-cacao-reviews .jm-histogram-row[data-zt-hidden-rating='1'] {
    display: none !important;
  }
</style>

{% schema %}
{
  "name": "Cacao LP Reviews BF",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "BF landing page only. Judge.me store-wide reviews with no review count. The summary reads 4.9 stars · Verified reviews."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Customer Reviews"
    }
  ],
  "presets": [
    {
      "name": "Cacao LP Reviews BF"
    }
  ]
}
{% endschema %}