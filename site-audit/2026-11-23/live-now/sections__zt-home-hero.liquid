{% comment %}
  ZEOTEIN HOMEPAGE HERO (Nov 2026)
  Replaces zeotein-hero on the homepage. The old section file is kept.
{% endcomment %}

<section id="zt-home-hero-{{ section.id }}" class="zt-home-hero">
  <a class="zt-home-hero__media" href="{{ section.settings.cta_url | default: '/collections/protein-blends' }}" tabindex="-1" aria-hidden="true">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000',
          sizes: '(min-width: 750px) 80vw, 100vw',
          class: 'zt-home-hero__img',
          alt: section.settings.hero_alt
      }}
    {% else %}
      <img
        class="zt-home-hero__img"
        src="{{ 'zt-home-hero.jpg' | asset_url }}"
        alt="{{ section.settings.hero_alt | escape }}"
        width="1536"
        height="1024"
        fetchpriority="high"
      >
    {% endif %}
  </a>

  <div class="zt-home-hero__inner">
    <div class="zt-home-hero__copy">
      <p class="zt-home-hero__rating">
        <span class="zt-home-hero__stars" aria-hidden="true">★★★★★</span>
        Rated 4.9 stars by verified buyers
      </p>

      <h1 class="zt-home-hero__heading">{{ section.settings.heading }}</h1>

      <p class="zt-home-hero__text">{{ section.settings.text }}</p>

      <div class="zt-home-hero__actions">
        <a class="zt-home-hero__button" href="{{ section.settings.cta_url | default: '/collections/protein-blends' }}">
          {{ section.settings.cta_text }}
        </a>
        {% if section.settings.link_text != blank %}
          <a class="zt-home-hero__link" href="{{ section.settings.link_url | default: '/collections/single-ingredient-supplements' }}">
            {{ section.settings.link_text }} <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.proof_1 != blank or section.settings.proof_2 != blank %}
        {%- capture zt_check -%}<svg class="zt-home-hero__check" aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3L13 4.5"/></svg>{%- endcapture -%}
        <ul class="zt-home-hero__proof" role="list">
          {% if section.settings.proof_1 != blank %}<li>{{ zt_check }}<span>{{ section.settings.proof_1 }}</span></li>{% endif %}
          {% if section.settings.proof_2 != blank %}<li>{{ zt_check }}<span>{{ section.settings.proof_2 }}</span></li>{% endif %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #zt-home-hero-{{ section.id }} {
    position: relative;
    min-height: 640px;
    overflow: hidden;
    background: #e6e5e3;
    color: #35164f;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__media {
    display: block;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 80%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14%);
    mask-image: linear-gradient(90deg, transparent 0, #000 14%);
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__inner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 84px 32px 72px;
    box-sizing: border-box;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__copy {
    max-width: 500px;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__rating {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__stars {
    margin-right: 6px;
    color: #8a5a00;
    letter-spacing: 2px;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__heading {
    margin: 16px 0 0;
    color: #35164f;
    font-size: clamp(44px, 5.6vw, 72px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__text {
    max-width: 420px;
    margin: 18px 0 0;
    color: #4a2a63;
    font-size: 19px;
    line-height: 1.45;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 24px;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__button {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 0 32px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #47206b;
    color: #ffffff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: background .2s ease;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__button:hover {
    background: #35164f;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__link {
    color: #47206b;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__link:hover {
    text-decoration: underline;
  }

  /* Nov 19 2026 (Dana 9:35 PM): proof lines are quiet badges, not link-styled. Only "Single Ingredients" looks like a link. */
  #zt-home-hero-{{ section.id }} .zt-home-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    color: #5c566a;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__proof li::before,
  #zt-home-hero-{{ section.id }} .zt-home-hero__proof li::marker {
    content: none;
  }

  #zt-home-hero-{{ section.id }} .zt-home-hero__check {
    flex: none;
    color: #14a39a;
  }

  @media screen and (max-width: 749px) {
    #zt-home-hero-{{ section.id }} {
      display: flex;
      flex-direction: column-reverse;
      min-height: 0;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__media {
      position: relative;
      width: 100%;
      height: 420px;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__img {
      object-position: 100% 40%;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__inner {
      padding: 26px 18px 18px;
      text-align: center;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__heading {
      font-size: 38px;
      line-height: 1.02;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__text {
      margin: 10px auto 0;
      font-size: 16px;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__actions {
      flex-direction: column;
      gap: 10px;
      margin-top: 16px;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__button {
      justify-content: center;
      width: 100%;
      min-height: 54px;
    }

    #zt-home-hero-{{ section.id }} .zt-home-hero__proof {
      justify-content: center;
      gap: 4px 14px;
      margin-top: 16px;
      font-size: 12.5px;
    }
  }
</style>

{% schema %}
{
  "name": "Zeotein Home Hero",
  "tag": "section",
  "class": "section-zt-home-hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (blank uses the built-in photo)" },
    { "type": "text", "id": "hero_alt", "label": "Hero image alt text", "default": "A woman holding a Zeotein shaker after a sip, with a Zeotein Cacao pouch on the kitchen counter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Nutrition. Made for Real Life." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Protein shakes and single-ingredient supplements that go where you go." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop Protein Blends" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "link_text", "label": "Second link text", "default": "Single Ingredients" },
    { "type": "url", "id": "link_url", "label": "Second link" },
    { "type": "text", "id": "proof_1", "label": "Proof line 1", "default": "Zero Added Sugar" },
    { "type": "text", "id": "proof_2", "label": "Proof line 2", "default": "30-Day Money-Back Guarantee" }
  ],
  "presets": [{ "name": "Zeotein Home Hero" }]
}
{% endschema %}