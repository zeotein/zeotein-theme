{%- comment -%}
  Mobile sticky ATC. Replaces the older sticky-offer-cacao-lp bar on this page
  (that section is disabled in the template so the two do not double up).
  The button uses the same wording as the main CTA and clicks that button, so
  variant, selling plan, quantity and gift properties stay in sync.
  Chat and Rewards are hidden on this layout; the offset still applies if they
  are shown later, so the bar will not cover them.
{%- endcomment -%}
<div class="zt-bf-mobi-atc" data-zt-bf-mobi-atc hidden>
  <div class="zt-bf-mobi-atc__inner">
    <div class="zt-bf-mobi-atc__price" data-zt-bf-mobi-atc-price hidden></div>
    <button type="button" class="zt-bf-mobi-atc__btn" data-zt-bf-mobi-atc-btn>
      <span data-zt-bf-mobi-atc-label>{{ section.settings.cta_sub | default: 'Get My Black Friday Kit' | escape }}</span>
    </button>
  </div>
</div>

<style>
  .zt-bf-mobi-atc {
    display: none;
  }
  @media screen and (max-width: 749px) {
    .zt-bf-mobi-atc {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 38;
      background: #fcfbfd;
      border-top: 1px solid rgba(30, 23, 52, 0.10);
      box-shadow: 0 -6px 20px rgba(30, 23, 52, 0.08);
      padding: 10px 14px calc(12px + env(safe-area-inset-bottom, 0px));
      box-sizing: border-box;
    }
    .zt-bf-mobi-atc[hidden] { display: none !important; }
    .zt-bf-mobi-atc__inner {
      display: flex;
      align-items: center;
      gap: 12px;
      max-width: 1280px;
      margin: 0 auto;
    }
    .zt-bf-mobi-atc__price {
      flex: 0 1 auto;
      min-width: 0;
      font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
      font-size: 13px;
      font-weight: 700;
      color: #1e1734;
      line-height: 1.25;
    }
    .zt-bf-mobi-atc__btn {
      flex: 1 1 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 14px 18px;
      border: 0;
      border-radius: 12px;
      background: #580d93;
      color: #ffffff;
      font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.2;
      cursor: pointer;
      box-shadow: 3px 3px 0 #580d93;
    }
    .zt-bf-mobi-atc__btn:focus-visible {
      outline: 2px solid #1aa6a0;
      outline-offset: 2px;
    }
    html.zt-bf-mobi-atc-on {
      padding-bottom: var(--zt-bf-mobi-atc-h, 88px);
    }
    /* Lift chat and Rewards above the bar if they are visible. */
    html.zt-bf-mobi-atc-on chat-widget,
    html.zt-bf-mobi-atc-on #bon-loyalty-btn,
    html.zt-bf-mobi-atc-on #bon-iframe-container {
      bottom: calc(var(--zt-bf-mobi-atc-h, 88px) + 12px) !important;
    }
  }
  @media screen and (min-width: 750px) {
    .zt-bf-mobi-atc { display: none !important; }
    html.zt-bf-mobi-atc-on { padding-bottom: 0; }
  }
</style>

<script>
  (function () {
    var bar = document.querySelector('[data-zt-bf-mobi-atc]');
    if (!bar || bar.dataset.ztBfMobiBound === '1') return;
    bar.dataset.ztBfMobiBound = '1';

    var btn = bar.querySelector('[data-zt-bf-mobi-atc-btn]');
    var labelEl = bar.querySelector('[data-zt-bf-mobi-atc-label]');
    var priceEl = bar.querySelector('[data-zt-bf-mobi-atc-price]');
    var mq = window.matchMedia('(max-width: 749px)');
    var io = null;

    function mainCta() {
      return document.querySelector('[data-zt-bb-cta]');
    }

    function otherStickyVisible() {
      var other = document.querySelector('[data-zt-sticky-offer-bar].is-visible, .zt-sticky-offer__bar.is-visible');
      return !!(other && other.offsetParent !== null);
    }

    function syncCopy() {
      var cta = mainCta();
      if (!cta) return;
      var src = cta.querySelector('[data-zt-bb-cta-label]') || cta;
      if (labelEl && src && src.textContent) {
        labelEl.textContent = src.textContent.trim();
      }
      if (!priceEl) return;
      var root = cta.closest('.zt-bb2') || document;
      var plan = root.querySelector('[data-zt-bb-plan].is-active, [data-zt-bb-plan][aria-pressed="true"]');
      var isOnce = plan && plan.getAttribute('data-zt-bb-plan') === 'once';
      var price = root.querySelector(isOnce ? '[data-zt-bb-once-price]' : '[data-zt-bb-sub-price]');
      var renew = isOnce ? null : root.querySelector('[data-zt-bb-sub-renew]');
      var parts = [];
      if (price && price.textContent.trim()) parts.push(price.textContent.trim());
      if (renew && renew.textContent.trim()) parts.push(renew.textContent.trim());
      if (parts.length) {
        priceEl.hidden = false;
        priceEl.textContent = parts.join(' · ');
      } else {
        priceEl.hidden = true;
        priceEl.textContent = '';
      }
    }

    function setPad(on) {
      document.documentElement.classList.toggle('zt-bf-mobi-atc-on', on);
      if (on && bar.offsetHeight) {
        document.documentElement.style.setProperty('--zt-bf-mobi-atc-h', bar.offsetHeight + 'px');
      }
    }

    function setVisible(show) {
      var want = !!(show && mq.matches && !otherStickyVisible());
      bar.hidden = !want;
      setPad(want);
    }

    function bindIo() {
      var cta = mainCta();
      if (!cta) {
        setVisible(false);
        return;
      }
      syncCopy();
      if (io) io.disconnect();
      if (!('IntersectionObserver' in window)) {
        setVisible(true);
        return;
      }
      io = new IntersectionObserver(function (entries) {
        var inView = entries.some(function (e) { return e.isIntersecting; });
        setVisible(!inView);
      }, { root: null, threshold: 0.2 });
      io.observe(cta);
    }

    btn.addEventListener('click', function () {
      var cta = mainCta();
      if (!cta) return;
      cta.click();
    });

    var box = document.querySelector('.zt-bb2') || document;
    box.addEventListener('click', function (e) {
      if (e.target.closest('[data-zt-bb-plan], [data-zt-bb-bag]')) {
        setTimeout(syncCopy, 0);
      }
    });

    mq.addEventListener('change', function () {
      if (!mq.matches) setVisible(false);
      else bindIo();
    });
    window.addEventListener('resize', function () {
      if (!bar.hidden && bar.offsetHeight) {
        document.documentElement.style.setProperty('--zt-bf-mobi-atc-h', bar.offsetHeight + 'px');
      }
    });
    window.addEventListener('load', bindIo);
    document.addEventListener('shopify:section:load', bindIo);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindIo);
    } else {
      bindIo();
    }
  })();
</script>

