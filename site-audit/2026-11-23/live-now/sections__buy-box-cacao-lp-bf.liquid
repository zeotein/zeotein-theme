{% comment %}
Buy Box Cacao LP - Black Friday.
Copy of Buy Box Cacao LP v2 with the Black Friday product, Seal plans and price ladder.
Renders through buy-box-cacao-lp.js on the v2 path, so that file is untouched.
Markup lives in the zt-bf-bb-* snippets.
{% endcomment %}
{%- liquid
assign sid = 'zt-bb2-' | append: section.id
assign details_id = 'zt-bb2-details-' | append: section.id
assign reviews_id = 'zt-bb2-reviews-' | append: section.id
assign bb_product = all_products['30-day-cacao-bulk-bag-black-friday']
assign variant = bb_product.selected_or_first_available_variant
assign variant_id = variant.id | default: '68115835322581'
# One-time display comes from this variant's price and compare-at, times bag quantity. No hardcoded sale price.
assign once_unit_cents = variant.price | default: 6999
assign once_was_cents = variant.compare_at_price | default: 9999
assign once_p1_d = once_unit_cents | times: 1 | divided_by: 100
assign once_p1_c = once_unit_cents | times: 1 | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_price_1 = once_p1_d | append: '.' | append: once_p1_c
assign once_w1_d = once_was_cents | times: 1 | divided_by: 100
assign once_w1_c = once_was_cents | times: 1 | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_was_1 = once_w1_d | append: '.' | append: once_w1_c
assign once_p2_cents = once_unit_cents | times: 2
assign once_p2_d = once_p2_cents | divided_by: 100
assign once_p2_c = once_p2_cents | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_price_2 = once_p2_d | append: '.' | append: once_p2_c
assign once_w2_cents = once_was_cents | times: 2
assign once_w2_d = once_w2_cents | divided_by: 100
assign once_w2_c = once_w2_cents | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_was_2 = once_w2_d | append: '.' | append: once_w2_c
assign once_p3_cents = once_unit_cents | times: 3
assign once_p3_d = once_p3_cents | divided_by: 100
assign once_p3_c = once_p3_cents | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_price_3 = once_p3_d | append: '.' | append: once_p3_c
assign once_w3_cents = once_was_cents | times: 3
assign once_w3_d = once_w3_cents | divided_by: 100
assign once_w3_c = once_w3_cents | modulo: 100 | prepend: '00' | slice: -2, 2
assign once_was_3 = once_w3_d | append: '.' | append: once_w3_c
if once_was_cents > once_unit_cents
  assign once_off_pct = once_was_cents | minus: once_unit_cents | times: 100.0 | divided_by: once_was_cents | round
  assign once_save_label = 'Save ' | append: once_off_pct | append: '%'
else
  assign once_save_label = 'Save 30%'
endif
assign seal_plan_1 = '6688669909'
assign seal_plan_2 = '6688702677'
assign seal_plan_3 = '6688735445'
# Nov 22 2026 (Orbit 4:00 PM CT, local currencies): Subscribe tier amounts come from the Seal plan allocations on the
# BF variant (presentment currency), times bags. US amounts are the same as before: first 68.99/133.98/195.99,
# renew 89.99/179.98/239.97. Fallbacks are the old US cents, used only if a plan is not on the variant.
assign sub_first_1 = 6899
assign sub_first_2 = 13398
assign sub_first_3 = 19599
assign sub_renew_1 = 8999
assign sub_renew_2 = 17998
assign sub_renew_3 = 23997
for zt_a in variant.selling_plan_allocations
  assign zt_aid = zt_a.selling_plan.id | append: ''
  assign zt_a_renew = zt_a.price
  if zt_a.price_adjustments.size > 1
    assign zt_a_renew = zt_a.price_adjustments.last.price
  endif
  if zt_aid == seal_plan_1
    assign sub_first_1 = zt_a.price
    assign sub_renew_1 = zt_a_renew
  elsif zt_aid == seal_plan_2
    assign sub_first_2 = zt_a.price | times: 2
    assign sub_renew_2 = zt_a_renew | times: 2
  elsif zt_aid == seal_plan_3
    assign sub_first_3 = zt_a.price | times: 3
    assign sub_renew_3 = zt_a_renew | times: 3
  endif
endfor
# Kit value = bag compare-at times bags + the gifts in the box (shaker, Save-A-Scoop, 3 guides), all presentment prices.
# US: 162.97 / 262.96 / 362.95 as before.
assign kit_gifts = 0
assign zt_gift_handles = 'lp-gift-cleanblend-shaker,lp-gift-save-a-scoop,lp-gift-starter-guide,lp-gift-cacao-recipe-guide,lp-gift-vegan-recipe-guide' | split: ','
for zt_gh in zt_gift_handles
  assign zt_gp = all_products[zt_gh]
  if zt_gp != blank and zt_gp.selected_or_first_available_variant
    assign kit_gifts = kit_gifts | plus: zt_gp.selected_or_first_available_variant.price
  endif
endfor
assign sub_was_1 = once_was_cents | plus: kit_gifts
assign sub_was_2 = once_was_cents | times: 2 | plus: kit_gifts
assign sub_was_3 = once_was_cents | times: 3 | plus: kit_gifts
assign money_format = shop.money_format | strip_html

if section.settings.layout_width == blank
assign layout_width = 1180
else
assign layout_width = section.settings.layout_width
endif

assign slide_1 = nil
if bb_product != blank
for media in bb_product.media
if media.media_type == 'image'
assign slide_1 = media
break
endif
endfor
endif
-%}

