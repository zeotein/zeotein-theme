      New-buyer subscribe route. Old Seal rules stay attached (nothing detached); existing subscriptions are not touched.
      - Main stick PDPs: Subscribe adds the Starter Kit variant (Funnel - free shipping profile) on the new $84.99 then $109.99 plan.
      - Bulk bag + bag resub: Subscribe always goes on the new $89.99 plan; the old rule's option is hidden when the new one is shown.
      A rule is only active when its new plan IDs are really on the target variant (unfilled __X__ placeholders never match = no change).
      Rendered from part 'trust' (on every protein-blend PDP). Seal settings and plans unchanged.
      Option C (Orbit 10:17 PM CT): Seal lists old + new plans in ONE group (same storefront group id), so the old plan IDs are
      removed from the Seal frequency select in the browser, the matching new plan is selected, and any old ID left at submit is swapped.
      An explicit ?selling_plan=<old id> in the URL (e.g. Vegan lander plan 4565729493) is left alone.
      ONE CONFIG SPOT: zr_defs below = variant>target handle>kit|same>old Seal group>oldPlan:newPlan pairs. fill-ids.py fills __B1/S1/S2__.
    {%- endcomment -%}
    {%- liquid
      assign zr_defs = '52649698132181>zeotein-cacao-sticks-30>same>3750068437>6671335637:6730842325,6671368405:6730875093,6671401173:6730907861|53061513511125>zeotein-vegan-sticks-30>same>3750101205>6671433941:6730842325,6671466709:6730875093,6671499477:6730907861|53720454004949>zeotein-cacao-bag-30>same>3750035669>6671237333:6729892053,6671270101:6729924821,6671302869:6729957589|68020246380757>zeotein-cacao-bag-30-resub>same>3744891093>6665535701:6729892053,6665765077:6729924821,6665797845:6729957589|68020247199957>zeotein-cacao-sticks-30-resub>same>3744923861>6665568469:6730088661,6665830613:6730121429,6665863381:6730154197|68020247953621>zeotein-vegan-sticks-30-resub>same>3744956629>6665601237:6730088661,6666027221:6730121429,6666059989:6730154197|67758454669525>zeotein-cacao-sticks-30-web>same>3696984277>6616285397:6729990357,6616318165:6730023125,6616350933:6730055893|68049376313557>zeotein-vegan-sticks-30-intro>same>3285385429>4565729493:6729990357,6561136853:6730023125,6561169621:6730055893|67710100308181>zeotein-cacao-bag-30-try>same>3678961877>6596853973:4659019989,6622773461:6730186965,6622806229:6730219733,6561202389:6730186965,6561235157:6730219733' | split: '|'
      assign zr_mine = ''
      for zv in product.variants
        assign zr_mine = zr_mine | append: ',' | append: zv.id | append: ','
      endfor
      assign zr_json = ''
    -%}
    {%- for d in zr_defs -%}
      {%- liquid
        assign f = d | split: '>'
        assign probe = ',' | append: f[0] | append: ','
        unless zr_mine contains probe
          continue
        endunless
        assign tp = all_products[f[1]]
        assign tv = nil
        for x in tp.variants
          if f[2] == 'same'
            assign xid = x.id | append: ''
            if xid == f[0]
              assign tv = x
            endif
          elsif forloop.first
            assign tv = x
          endif
        endfor
        if tv == nil
          continue
        endif
        assign pairs = f[4] | split: ','
        assign ok = true
        assign mj = ''
        assign newids = ''
        assign first_c = 0
        assign renew_c = 0
        assign new_group = ''
        for pr in pairs
          assign kv = pr | split: ':'
          assign found = false
          for a in tv.selling_plan_allocations
            assign aid = a.selling_plan.id | append: ''
            if aid == kv[1]
              assign found = true
              if first_c == 0
                assign first_c = a.price
                assign renew_c = a.price
                if a.price_adjustments.size > 1
                  assign renew_c = a.price_adjustments.last.price
                endif
                assign new_group = a.selling_plan_group_id | append: ''
              endif
            endif
          endfor
          if found == false
            assign ok = false
          endif
          if mj != ''
            assign mj = mj | append: ','
            assign newids = newids | append: ','
          endif
          assign mj = mj | append: '"' | append: kv[0] | append: '":"' | append: kv[1] | append: '"'
          assign newids = newids | append: '"' | append: kv[1] | append: '"'
        endfor
        if ok
          if zr_json != ''
            assign zr_json = zr_json | append: ','
          endif
          assign is_kit = false
          if f[2] == 'kit'
            assign is_kit = true
          endif
          comment
            Nov 22 2026 (Orbit 4:00 PM CT, local currencies): Subscribe & Save amounts are formatted here with the money filter,
            so the shopper's currency symbol and format come from Shopify. Amounts are unchanged (presentment cents from Seal allocations).
          endcomment
          assign once_c = product.selected_or_first_available_variant.price
          assign first_m = first_c | money | strip_html | json
          assign renew_m = renew_c | money | strip_html | json
          assign first_ps_m = first_c | divided_by: 30.0 | round | money | strip_html | json
          assign renew_ps_m = renew_c | divided_by: 30.0 | round | money | strip_html | json
          assign once_ps_m = once_c | divided_by: 30.0 | round | money | strip_html | json
          assign zr_json = zr_json | append: '{"v":"' | append: f[0] | append: '","to":"' | append: tv.id | append: '","kit":' | append: is_kit | append: ',"oldGroup":"' | append: f[3] | append: '","newGroup":"' | append: new_group | append: '","map":{' | append: mj | append: '},"newIds":[' | append: newids | append: '],"first":' | append: first_c | append: ',"renew":' | append: renew_c | append: ',"once":' | append: once_c | append: ',"firstM":' | append: first_m | append: ',"renewM":' | append: renew_m | append: ',"firstPs":' | append: first_ps_m | append: ',"renewPs":' | append: renew_ps_m | append: ',"oncePs":' | append: once_ps_m | append: '}'
        endif
      -%}
    {%- endfor -%}
    {%- if zr_json != '' -%}
    <script>
      (function () {
        if (window.__ztRoute) return;
        window.__ztRoute = 1;
        var R = [{{ zr_json }}];
        function form() { return document.querySelector('#MainContent form[action*="/cart/add"]'); }
        function ruleFor(id) { for (var i = 0; i < R.length; i++) { if (String(R[i].v) === String(id)) return R[i]; } return null; }
        function current() { var f = form(); var i = f && f.querySelector('[name="id"]'); return i ? ruleFor(i.value) : null; }
        function has(c, ids) { var h = c.outerHTML; for (var i = 0; i < ids.length; i++) { if (h.indexOf(ids[i]) > -1) return true; } return false; }
        function isOld(c, r) { var g = c.getAttribute('data-selling-plan-group') || ''; return g === r.oldGroup || (g.indexOf(r.oldGroup) > -1) || has(c, Object.keys(r.map)); }
        function isNew(c, r) { var g = c.getAttribute('data-selling-plan-group') || ''; return (r.newGroup && (g === r.newGroup || g.indexOf(r.newGroup) > -1)) || has(c, r.newIds); }
        function setText(el, t) { if (el && el.textContent !== t) el.textContent = t; }
        var clicked = false;
        function paint() {
          var box = document.querySelector('.sealsubs-container');
          if (!box) return false;
          var r = current();
          if (!r) return true;
          var subs = box.querySelectorAll('.sls-option-container[data-selling-plan-group]');
          if (r.kit) {
            for (var i = 0; i < subs.length; i++) {
              var c = subs[i];
              setText(c.querySelector('.sls-price .money') || c.querySelector('.sls-price'), r.firstM);
              var d = c.querySelector('.sls-selling-plan-description-content');
              setText(d, 'First order ' + r.firstM + ' (' + r.firstPs + '/serving) with the Starter Kit. Then ' + r.renewM + ' (' + r.renewPs + '/serving) every delivery. Skip, pause or cancel anytime.');
            }
            var once = box.querySelector('.sls-option-container:not([data-selling-plan-group]) .sls-label-container');
            if (once && !once.querySelector('.zt-route-ps')) { var s = document.createElement('small'); s.className = 'zt-route-ps'; s.style.cssText = 'display:block;font-size:11.5px;color:#6B6478;margin-top:4px'; s.textContent = r.oncePs + '/serving'; once.appendChild(s); }
          } else {
            var qsp = q.get('selling_plan');
            if (qsp && r.map[qsp]) return true;
            var sels = box.querySelectorAll('select');
            for (var si = 0; si < sels.length; si++) {
              var sel = sels[si], opts = sel.querySelectorAll('option'), hasNew = false;
              for (var oi = 0; oi < opts.length; oi++) { if (r.newIds.indexOf(opts[oi].value) > -1) hasNew = true; }
              if (!hasNew) continue;
              var cur = sel.value;
              if (r.map[cur]) { sel.value = r.map[cur]; sel.dispatchEvent(new Event('change', { bubbles: true })); }
              for (var oj = 0; oj < opts.length; oj++) { if (r.map[opts[oj].value]) opts[oj].parentNode.removeChild(opts[oj]); }
            }
            var hid = box.querySelector('input[name="selling_plan"]');
            if (hid && r.map[hid.value] && box.querySelector('.sls-active[data-selling-plan-group]')) { hid.value = r.map[hid.value]; }
            var newC = null, olds = [];
            for (var j = 0; j < subs.length; j++) { if (isNew(subs[j], r)) newC = subs[j]; else if (isOld(subs[j], r)) olds.push(subs[j]); }
            if (newC && olds.length) {
              var wasActive = false;
              for (var k = 0; k < olds.length; k++) { if (olds[k].classList.contains('sls-active')) wasActive = true; if (olds[k].style.display !== 'none') { olds[k].style.display = 'none'; olds[k].setAttribute('data-zt-route-hidden', '1'); } }
              if (wasActive && !clicked) { clicked = true; (newC.querySelector('input[type="radio"]') || newC.querySelector('label') || newC).click(); }
            }
            for (var pj = 0; pj < subs.length; pj++) { if (subs[pj].style.display !== 'none') setText(subs[pj].querySelector('.sls-price .money') || subs[pj].querySelector('.sls-price'), r.firstM); }
            if (/\/products\/zeotein-(cacao|vegan)-sticks-30\/?$/.test(location.pathname)) { for (var pd = 0; pd < subs.length; pd++) { var dd = subs[pd].querySelector('.sls-selling-plan-description-content'); if (dd && dd.textContent.indexOf(' with free shipping') > -1) setText(dd, dd.textContent.replace(' with free shipping', '')); } }
          }
          return true;
        }
        document.addEventListener('submit', function (e) {
          var f = e.target;
          if (!f || !f.matches || !f.matches('form[action*="/cart/add"]')) return;
          var idI = f.querySelector('[name="id"]'), sp = f.querySelector('[name="selling_plan"]');
          if (!idI || !sp || !sp.value) return;
          var r = ruleFor(idI.value);
          if (!r) return;
          var to = r.map[String(sp.value)];
          var isNewPlan = r.newIds.indexOf(String(sp.value)) > -1;
          if (!to && !isNewPlan) return;
          var keep = { id: idI.value, sp: sp.value };
          if (to) sp.value = to;
          if (r.kit) idI.value = r.to;
          setTimeout(function () { idI.value = keep.id; sp.value = keep.sp; }, 2500);
        }, true);
        var q = new URLSearchParams(location.search);
        var tries = 0;
        function start() {
          if (paint()) {
            if (q.get('zt_sub') === '1') { var b = document.querySelector('.sealsubs-container .sls-option-container[data-selling-plan-group]:not([data-zt-route-hidden])'); if (b && !b.classList.contains('sls-active')) (b.querySelector('input[type="radio"]') || b.querySelector('label') || b).click(); }
            var t = document.querySelector('.sealsubs-container');
            if (t && window.MutationObserver) {
              var queued = false;
              new MutationObserver(function () { if (queued) return; queued = true; requestAnimationFrame(function () { queued = false; paint(); }); }).observe(t.parentNode || t, { childList: true, subtree: true, characterData: true });
            }
            return;
          }
          if (++tries < 40) setTimeout(start, 250);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
      })();
    </script>
    {%- endif -%}
  {%- endcase -%}