{%- comment -%}
  Product page buy box (v2, Nov 13, 2026).
  part: 'rating'   "&#9733;&#9733;&#9733;&#9733;&#9733; 4.9 from verified buyers", live from Judge.me (updates as reviews come in), links to the reviews.
  part: 'formats'  Format picker with photos and price per serving (blend: 'cacao' default | 'vegan'; current: 'bag' | 'sticks' | 'trial').
                   Per serving uses the regular price (renewal price of a plan, never an intro first-order price).
  part: 'bundle'   PDP "Select your supply" 1 / 2 / 3 cards with computed bundle totals (10% on 2, 20% on 3), three 30-day products only.
  part: 'perks'    First-order gifts as one slim line with small photos. With the Seal widget on the page they move inside the Subscribe & Save
                   and One-time options and Seal's renewal sentence is shortened; otherwise (no subscription) a plain row.
                   sub_gifts / once_gifts: comma lists of shaker, scoop, guides.
  part: 'desc'     v2 product copy from snippets/zt-desc-cacao.liquid (by handle), else the product's own description.
  part: 'trust'    One guarantee + shipping row under Add to cart. On blends tagged protein-blend
                   (not final-sale or howie, and not an excluded product type): the left item
                   reads "30 days to try it. Not for you? We refund it." The right item keeps
                   "Ships in 1&ndash;2 business days" once. kind: 'single' = shipping-only row
                   (single-ingredient powders are final sale).
  part: 'review'   One real customer review (quote, name).
  part: 'sticky'   Add to cart bar (phones: full width; desktop: floating) shown while the main button is off screen (moved to <body> so
                   it is fixed to the screen; sits above Shopify's preview bar when previewing).
  The 'sticky' part also carries the shared page layout: quantity + button on one row, Rewards launcher and the
  second top bar hidden on phones, zoom button moved off the image text, desktop title size.
{%- endcomment -%}
{%- liquid
  assign h_shaker = 'zeotein-cleanblend-shaker-27oz-usa-made'
  assign h_scoop = 'save-a-scoop'
  assign p_shaker = all_products[h_shaker]
  assign p_scoop = all_products[h_scoop]
  assign p_g1 = all_products['zeotein-starter-guide']
  assign p_g2 = all_products['cacao-recipe-guide']
  assign p_g3 = all_products['vegan-recipe-guide']
  assign guides_value = p_g1.price | plus: p_g2.price | plus: p_g3.price
  comment
    Free-shipping threshold shown in the single-ingredient shipping row. Must match Settings > Shipping
    (General profile, United States, "Free Shipping" rate) and the top announcement bar. $130 since Nov 13, 2026.
  endcomment
  assign zt_free_ship_from = '$130'
  comment
    Blend-only guarantee line under Add to cart. Renders when the product is tagged
    protein-blend, is not tagged final-sale or howie, and product.type is not a
    final-sale type. kind: 'single' also hides it (single-ingredient shipping row).
  endcomment
  assign zt_show_guarantee = false
  if kind != 'single'
    if product.tags contains 'protein-blend'
      unless product.tags contains 'final-sale'
        unless product.tags contains 'howie'
          assign zt_excluded_type = false
          case product.type
            when 'Single Ingredient Supplement', 'Free Gift', 'Digital Guide', 'Shaker Bottle', 'Scoop', 'T-SHIRT'
              assign zt_excluded_type = true
          endcase
          unless zt_excluded_type
            assign zt_show_guarantee = true
          endunless
        endunless
      endunless
    endif
  endif
-%}
{%- capture zt_gift_icon -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7.5" width="14" height="3.5" rx=".8"/><path d="M4.5 11v5.5h11V11M10 7.5v9"/><path d="M10 7.5C8.8 4.7 5.4 4.1 5.4 6.2c0 1.3 2.3 1.3 4.6 1.3ZM10 7.5c1.2-2.8 4.6-3.4 4.6-1.3 0 1.3-2.3 1.3-4.6 1.3Z"/></svg>{%- endcapture -%}
{%- case part -%}

  {%- when 'rating' -%}
    {%- comment -%}
      Live from Judge.me's shop metafields, so it updates as reviews come in. Uses the verified-buyer average
      when Judge.me provides it; otherwise the all-reviews average with "Customers" wording (never claims
      "verified" without the verified number). rating param is only a last-resort fallback.
    {%- endcomment -%}
    {%- liquid
      assign jm = shop.metafields.judgeme
      assign v_avg = jm['trust_badge.verified_average_rating'].value
      assign a_avg = jm.all_reviews_rating.value | default: jm.all_reviews_rating
      assign who = 'verified buyers'
      if v_avg != blank
        assign avg = v_avg | times: 1.0
      elsif a_avg != blank
        assign avg = a_avg | times: 1.0
        assign who = 'customer reviews'
      else
        assign avg = rating | default: '4.9' | times: 1.0
        assign who = 'customer reviews'
      endif
      assign shown = avg | times: 10 | floor | divided_by: 10.0
      assign pct = avg | divided_by: 5.0 | times: 100 | round: 1
    -%}
    <a class="zt-rating" href="#zt-reviews" data-zt-reviews-link aria-label="Rated {{ shown }} out of 5 from {{ who }}. Read reviews.">
      <span class="zt-stars" aria-hidden="true"><span class="zt-stars__fill" style="width:{{ pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span><b>{{ shown }}</b> from {{ who }}</span>
    </a>
    <style>
      #MainContent .product__info-container > .zt-rating{display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px;margin:2px 0 6px !important;font-size:13.5px;line-height:1.3;color:#3A3546;text-decoration:none;width:fit-content}
      .zt-stars{position:relative;display:inline-block;color:#D8D2E2;letter-spacing:1px;font-size:15px;line-height:1}
      .zt-stars__fill{position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#0F8C7A}
      .zt-rating b{color:#1D1530}
      .zt-rating:hover span:last-child{text-decoration:underline}
    </style>
    <script>
      (function () {
        var a = document.querySelector('[data-zt-reviews-link]');
        if (!a) return;
        a.addEventListener('click', function (e) {
          var t = document.querySelector('.jdgm-carousel-wrapper') || document.querySelector('.jdgm-review-widget, [id*="judge_me_reviews_review_widget"]');
          if (!t) return;
          e.preventDefault();
          t.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      })();
    </script>

  {%- when 'formats' -%}
    {%- liquid
      if blend == 'vegan'
        assign fmt_handles = 'zeotein-vegan-sticks-30,zeotein-vegan-sticks-7' | split: ','
        assign fmt_keys = 'sticks,trial' | split: ','
        assign fmt_names = '30 sticks|7-Day pack' | split: '|'
        assign fmt_servings = '30,7' | split: ','
        assign fmt_best = 'sticks'
      else
        assign fmt_handles = 'zeotein-cacao-bag-30,zeotein-cacao-sticks-30,zeotein-cacao-sticks-7' | split: ','
        assign fmt_keys = 'bag,sticks,trial' | split: ','
        assign fmt_names = 'Bulk bag|30 sticks|7-Day pack' | split: '|'
        assign fmt_servings = '30,30,7' | split: ','
        assign fmt_best = 'bag'
      endif
    -%}
    {%- comment -%} Only on the three main Cacao pages; funnel/starter-kit products that share these templates keep their own flow. {%- endcomment -%}
    {%- if fmt_handles contains product.handle -%}
    <div class="zt-formats" role="group" aria-label="Choose your format">
      {%- for h in fmt_handles -%}
        {%- liquid
          assign p = all_products[h]
          assign key = fmt_keys[forloop.index0]
          assign servings = fmt_servings[forloop.index0] | plus: 0
          assign low = p.selected_or_first_available_variant.price
          for a in p.selected_or_first_available_variant.selling_plan_allocations
            assign rp = a.price
            if a.price_adjustments.size > 1
              assign rp = a.price_adjustments.last.price
            endif
            if rp < low
              assign low = rp
            endif
          endfor
          assign per = low | times: 1.0 | divided_by: servings | round
        -%}
        {%- if p.url != blank -%}{%- assign fmt_url = p.url -%}{%- else -%}{%- assign fmt_url = '/products/' | append: h -%}{%- endif -%}
        <a class="zt-format{% if current == key %} is-current{% endif %}" href="{{ fmt_url }}" data-zt-format{% if current == key %} aria-current="page"{% endif %}>
          {%- if key == fmt_best -%}<span class="zt-format__badge">Best value</span>{%- endif -%}
          {%- if p.featured_image -%}
            <img class="zt-format__img" src="{{ p.featured_image | image_url: width: 140 }}" alt="" width="56" height="56" loading="lazy">
          {%- endif -%}
          <span class="zt-format__name">{{ fmt_names[forloop.index0] }}</span>
          <span class="zt-format__note">{% if key != 'trial' %}from {% endif %}{{ per | money }}/serving</span>
        </a>
      {%- endfor -%}
    </div>
    <script>
      (function () {
        var row = document.querySelector('.zt-formats');
        if (!row) return;
        var KEY = 'zt-fmt-top';
        // Arriving from another format tile: put the tiles back where they were on screen.
        try {
          var saved = sessionStorage.getItem(KEY);
          if (saved !== null) {
            sessionStorage.removeItem(KEY);
            var want = parseFloat(saved);
            var place = function () { var y = row.getBoundingClientRect().top + window.scrollY - want; if (y > 0) window.scrollTo(0, y); return y; };
            var first = place();
            window.addEventListener('load', function () { if (Math.abs(window.scrollY - first) < 60) place(); }, { once: true });
          }
        } catch (e) {}
        row.querySelectorAll('[data-zt-format]').forEach(function (a) {
          if (a.getAttribute('aria-current') === 'page') {
            a.addEventListener('click', function (e) { e.preventDefault(); });
            return;
          }
          var l = document.createElement('link'); l.rel = 'prefetch'; l.href = a.href; document.head.appendChild(l);
          a.addEventListener('click', function () {
            try { sessionStorage.setItem(KEY, String(row.getBoundingClientRect().top)); } catch (e) {}
          });
        });
      })();
    </script>
    {%- endif -%}
    <style>
      #MainContent .product__info-container > .zt-formats{display:grid !important;grid-template-columns:repeat({{ fmt_handles.size }},minmax(0,1fr));gap:8px;margin:8px 0 12px !important}
      .zt-format{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;padding:10px 6px 9px;border:1px solid #DDD6E8;border-radius:12px;text-decoration:none;color:#1D1530;background:#fff;min-width:0}
      .zt-format:hover{border-color:#5F2D90}
      .zt-format:focus-visible{outline:2px solid #32BAC0;outline-offset:2px}
      .zt-format.is-current{border:2px solid #5F2D90;padding:9px 5px 8px;background:#F8F5FC}
      .zt-format__img{width:56px;height:56px;object-fit:contain;margin-bottom:2px}
      .zt-format__name{font-size:13px;font-weight:700;line-height:1.2}
      .zt-format__note{font-size:11.5px;line-height:1.25;color:#6B6478}
      .zt-format__badge{position:absolute;top:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#5F2D90;color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 7px;border-radius:999px}
      @media (min-width: 750px){ .zt-format__img{width:64px;height:64px} .zt-format__name{font-size:14px} }
    </style>

  {%- when 'bundle' -%}{%- comment -%} Bundle tiers OFF Nov 16 2026 6:25 PM CT per Dana: no bundles on any page with the format picker. {%- endcomment -%}
  {%- when 'bundle-off-20261116' -%}
    {%- comment -%}
      PDP bundle selector (Nov 16 2026, per Dana 11:09 AM CT; restyles the Nov 15 draft 1/2/3 ladder, which is removed from 'formats').
      Layout follows the developer's PDP selector: "Select your supply" with 1 / 2 / 3 cards, each showing its price.
      Only on the three products the bundle discounts cover (read from the 12 native automatic discounts, read only):
        zeotein-cacao-bag-30, zeotein-cacao-sticks-30, zeotein-vegan-sticks-30.
        2 of the same product = 10% off that line, 3 = 20% off. One-time AND Subscribe & Save.
        Windows: Nov 15 9:30 AM CT to Nov 23 11:59 PM CT, then again from Dec 1 12:00 AM CT (no end).
      Totals are worked out here from the live variant price (one-time) and the Seal plan price (subscribe); no base price is typed in.
      Rounding matches the cart: percent off each unit, rounded down to the cent, times the quantity.
      Hidden Nov 24 to Nov 30 (CT), when the bundle discounts are off and Black Friday pricing takes over (server and browser check),
      and the regular quantity box comes back. Always shown in the theme editor.
      No per-bag price on purpose (one tier per bag works out to an offer-lander-only price). Totals only.
      Picking a card sets the product form quantity (1, 2 or 3). The theme quantity box is hidden while the selector is showing.
    {%- endcomment -%}
    {%- liquid
      assign zb_handles = 'zeotein-cacao-bag-30,zeotein-cacao-sticks-30,zeotein-vegan-sticks-30' | split: ','
      assign zb_pcts = '0,10,20' | split: ','
      assign zb_from = 1795499940
      assign zb_to = 1796104800
      assign zb_paused = false
      assign zb_now = 'now' | date: '%s' | plus: 0
      if zb_now >= zb_from and zb_now < zb_to
        assign zb_paused = true
      endif
      if request.design_mode
        assign zb_paused = false
      endif
      if product.handle contains 'bag'
        assign zb_one = 'Bag'
        assign zb_many = 'Bags'
        assign zb_unit_word = 'servings'
      else
        assign zb_one = 'Box'
        assign zb_many = 'Boxes'
        assign zb_unit_word = 'stick packs'
      endif
      assign zb_v = product.selected_or_first_available_variant
      assign zb_once = zb_v.price
      assign zb_sub = 0
      for a in zb_v.selling_plan_allocations
        assign rp = a.price
        if a.price_adjustments.size > 1
          assign rp = a.price_adjustments.last.price
        endif
        if zb_sub == 0 or rp < zb_sub
          assign zb_sub = rp
        endif
      endfor
    -%}
    {%- if zb_handles contains product.handle -%}
    <div class="zt-bundle" data-zt-bundle data-from="{{ zb_from }}" data-to="{{ zb_to }}"{% if zb_paused %} hidden{% endif %}>
      <p class="zt-bundle__head" id="zt-bundle-head">Select your supply</p>
      <div class="zt-bundle__cards" role="radiogroup" aria-labelledby="zt-bundle-head">
        {%- for n in (1..3) -%}
          {%- liquid
            assign pct = zb_pcts[forloop.index0] | plus: 0
            comment
              Shopify takes the percent off EACH unit and drops the fraction of a cent (cart test Nov 16: 2 x $109.99 at 10% = $198.00),
              so: unit discount = unit price x percent, rounded down to the cent; total = (unit price - unit discount) x quantity.
            endcomment
            assign reg_once = zb_once | times: n
            assign off_once_unit = zb_once | times: pct | divided_by: 100
            assign tot_once = zb_once | minus: off_once_unit | times: n
            assign reg_sub = zb_sub | times: n
            assign off_sub_unit = zb_sub | times: pct | divided_by: 100
            assign tot_sub = zb_sub | minus: off_sub_unit | times: n
            assign servings = 30 | times: n
          -%}
          <button type="button" class="zt-bcard{% if n == 1 %} is-on{% endif %}" role="radio" aria-checked="{% if n == 1 %}true{% else %}false{% endif %}"
            data-qty="{{ n }}"
            data-once="{{ tot_once | money }}" data-once-reg="{% if pct > 0 %}{{ reg_once | money }}{% endif %}"
            data-sub="{% if zb_sub > 0 %}{{ tot_sub | money }}{% endif %}" data-sub-reg="{% if pct > 0 and zb_sub > 0 %}{{ reg_sub | money }}{% endif %}"
            aria-label="{{ n }} {% if n == 1 %}{{ zb_one }}{% else %}{{ zb_many }}{% endif %}, {{ servings }} {{ zb_unit_word }}{% if pct > 0 %}, save {{ pct }}%{% endif %}">
            {%- if pct > 0 -%}<span class="zt-bcard__badge">Save {{ pct }}%</span>{%- endif -%}
            <span class="zt-bcard__imgs zt-bcard__imgs--{{ n }}" aria-hidden="true">
              {%- if product.featured_image -%}
                {%- for i in (1..n) -%}<img src="{{ product.featured_image | image_url: width: 160 }}" alt="" width="48" height="48" loading="lazy">{%- endfor -%}
              {%- endif -%}
            </span>
            <span class="zt-bcard__name">{{ n }} {% if n == 1 %}{{ zb_one }}{% else %}{{ zb_many }}{% endif %}</span>
            <span class="zt-bcard__meta">{{ servings }} {{ zb_unit_word }}</span>
            <span class="zt-bcard__price"><b data-zb-total>{{ tot_once | money }}</b>{%- if pct > 0 -%}<s data-zb-reg>{{ reg_once | money }}</s>{%- endif -%}</span>
          </button>
        {%- endfor -%}
      </div>
      <p class="zt-bundle__note">2 {{ zb_many | downcase }} save 10%, 3 save 20%. Applied automatically in your cart, on one-time or Subscribe &amp; Save.</p>
    </div>
    <style>
      #MainContent .product__info-container > .zt-bundle:not([hidden]),.zt-bundle:not([hidden]){display:block !important;margin:10px 0 12px !important}
      .zt-bundle[hidden]{display:none !important}
      .zt-bundle__head{margin:0 0 8px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#1D1530}
      .zt-bundle__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
      .zt-bcard{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:3px;padding:16px 6px 10px;border:1px solid #DDD6E8;border-radius:12px;background:#fff;color:#1D1530;font:inherit;cursor:pointer;min-width:0}
      .zt-bcard:hover{border-color:#5F2D90}
      .zt-bcard:focus-visible{outline:2px solid #32BAC0;outline-offset:2px}
      .zt-bcard.is-on{border:2px solid #5F2D90;padding:15px 5px 9px;background:#F4EEFB}
      .zt-bcard__badge{position:absolute;top:-9px;left:50%;transform:translateX(-50%);white-space:nowrap;background:#5F2D90;color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 8px;border-radius:999px}
      .zt-bcard__imgs{display:flex;justify-content:center;align-items:flex-end;height:52px;margin-bottom:2px}
      .zt-bcard__imgs img{width:44px;height:52px;object-fit:contain;display:block}
      .zt-bcard__imgs--2 img + img,.zt-bcard__imgs--3 img + img{margin-left:-20px}
      .zt-bcard__imgs--3 img{width:40px;height:48px}
      .zt-bcard__name{font-size:14px;font-weight:800;line-height:1.2}
      .zt-bcard__meta{font-size:11.5px;color:#6B6478;line-height:1.2}
      .zt-bcard__price{display:flex;flex-direction:column;align-items:center;margin-top:3px;line-height:1.2}
      .zt-bcard__price b{font-size:16px;font-weight:800;color:#1D1530}
      .zt-bcard__price s{font-size:12px;color:#8A8296}
      .zt-bcard__price s:empty{display:none}
      .zt-bundle__note{margin:8px 0 0;font-size:12px;line-height:1.4;color:#4B2380;font-weight:600}
      .zt-bundle-on .product-form__quantity,.zt-bundle-on .product-form__input--quantity{display:none !important}
      @media screen and (max-width:749px){.zt-bcard{padding:15px 4px 9px}.zt-bcard.is-on{padding:14px 3px 8px}.zt-bcard__price b{font-size:15px}.zt-bcard__imgs--3 img + img{margin-left:-22px}}
    </style>
    <script>
      (function () {
        var box = document.querySelector('[data-zt-bundle]');
        if (!box) return;
        var from = Number(box.dataset.from) * 1000, to = Number(box.dataset.to) * 1000, t = Date.now();
        var editor = {{ request.design_mode | json }};
        if (!editor && t >= from && t < to) { box.hidden = true; return; }
        box.hidden = false;
        var info = box.closest('.product__info-container') || document.querySelector('#MainContent .product__info-container');
        if (info) info.classList.add('zt-bundle-on');
        var cards = Array.prototype.slice.call(box.querySelectorAll('.zt-bcard'));
        function qtyInput() { return document.querySelector('#MainContent .product-form__quantity input[name="quantity"], #MainContent input.quantity__input[name="quantity"]'); }
        function isSub() {
          if (document.querySelector('.sealsubs-container .sls-option-container.sls-active[data-selling-plan-group]')) return true;
          var sp = document.querySelector('#MainContent form[action$="/cart/add"] [name="selling_plan"]');
          return !!(sp && sp.value);
        }
        function paint() {
          var sub = isSub();
          cards.forEach(function (c) {
            var useSub = sub && c.dataset.sub;
            c.querySelector('[data-zb-total]').textContent = useSub ? c.dataset.sub : c.dataset.once;
            var r = c.querySelector('[data-zb-reg]');
            if (r) r.textContent = useSub ? c.dataset.subReg : c.dataset.onceReg;
          });
        }
        function mark(q) {
          q = String(q);
          if (q !== '1' && q !== '2' && q !== '3') q = '';
          cards.forEach(function (c) { var on = c.dataset.qty === q; c.classList.toggle('is-on', on); c.setAttribute('aria-checked', on ? 'true' : 'false'); });
        }
        function setQty(q) {
          var inp = qtyInput();
          if (inp) { inp.value = q; inp.dispatchEvent(new Event('input', { bubbles: true })); inp.dispatchEvent(new Event('change', { bubbles: true })); }
          mark(q);
        }
        cards.forEach(function (c) { c.addEventListener('click', function () { setQty(c.dataset.qty); paint(); }); });
        document.addEventListener('change', function (e) { var inp = qtyInput(); if (inp && e.target === inp) mark(inp.value); setTimeout(paint, 250); });
        document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.sealsubs-container, [class*="sls-"], .quantity__button')) setTimeout(paint, 250); });
        var inp0 = qtyInput();
        if (inp0 && inp0.value !== '1') setQty('1');
        paint(); setTimeout(paint, 800); setTimeout(paint, 2000); setTimeout(paint, 4000);
      })();
    </script>
    {%- endif -%}

  {%- when 'perks' -%}
    {%- liquid
      if sub_gifts == blank
        assign once_csv = 'guides'
      else
        assign once_csv = sub_gifts | replace: 'shaker,', '' | replace: ',shaker', '' | replace: 'shaker', ''
      endif
      assign sub_list = sub_gifts | split: ','
      assign once_list = once_csv | split: ','
      assign sub_value = 0
      assign sub_names = ''
      assign guide_handles = 'cacao-recipe-guide,vegan-recipe-guide,zeotein-starter-guide' | split: ','
    -%}
    {%- capture sub_thumbs -%}
      {%- for g in sub_list -%}
        {%- liquid
          case g
            when 'shaker'
              assign gp = p_shaker
              assign gl = 'shaker'
              assign gv = p_shaker.price
            when 'scoop'
              assign gp = p_scoop
              assign gl = 'Save-A-Scoop'
              assign gv = p_scoop.price
            when 'guides'
              assign gp = p_g1
              assign gl = '3 guides'
              assign gv = guides_value
          endcase
          assign sub_value = sub_value | plus: gv
          if forloop.first
            assign sub_names = gl
          elsif forloop.last
            assign sub_names = sub_names | append: ' + ' | append: gl
          else
            assign sub_names = sub_names | append: ', ' | append: gl
          endif
        -%}
