{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .contact--zeotein {
    max-width: 760px;
    margin: 0 auto;
  }

  .contact--zeotein .contact__intro {
    max-width: 620px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .contact--zeotein .contact__heading {
    margin-bottom: 12px;
  }

  .contact--zeotein .contact__description {
    margin: 0;
    line-height: 1.6;
  }

  .contact--zeotein .contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .contact--zeotein .field {
    margin-bottom: 16px;
  }

  .contact--zeotein .contact__fields .field {
    margin-bottom: 0;
  }

  .contact--zeotein .field__input {
    width: 100%;
  }

  .contact--zeotein textarea.field__input {
    min-height: 160px;
    resize: vertical;
  }

  .contact--zeotein .field__label {
    font-weight: 500;
  }

  .contact--zeotein .contact__button {
    margin-top: 8px;
  }

  .contact--zeotein .contact__button .button {
    width: 100%;
    min-height: 48px;
  }

  .contact--zeotein .contact__privacy {
    max-width: 620px;
    margin: 18px auto 0;
    text-align: center;
    font-size: 1.3rem;
    line-height: 1.5;
    opacity: 0.8;
  }

  .contact--zeotein .contact__privacy a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact--zeotein .form-status {
    margin-bottom: 24px;
  }

  .contact--zeotein .contact__field-error {
    display: block;
    margin-top: 6px;
  }

  .contact--zeotein .contact__field-error .form__message {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.4;
  }

  .contact--zeotein .contact__field-error .svg-wrapper {
    flex: 0 0 auto;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    .contact--zeotein {
      max-width: 100%;
    }

    .contact--zeotein .contact__intro {
      margin-bottom: 28px;
      text-align: left;
    }

    .contact--zeotein .contact__heading {
      margin-bottom: 10px;
    }

    .contact--zeotein .contact__fields {
      display: block;
      margin-bottom: 0;
    }

    .contact--zeotein .contact__fields .field {
      margin-bottom: 16px;
    }

    .contact--zeotein .field {
      margin-bottom: 16px;
    }

    .contact--zeotein textarea.field__input {
      min-height: 150px;
    }

    .contact--zeotein .contact__button {
      margin-top: 4px;
    }

    .contact--zeotein .contact__button .button {
      width: 100%;
      min-height: 52px;
    }

    .contact--zeotein .contact__privacy {
      margin-top: 16px;
      text-align: left;
      font-size: 1.2rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact contact--zeotein page-width page-width--narrow section-{{ section.id }}-padding">

    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="contact__intro">

        {%- if section.settings.heading != blank -%}
          <h1 class="contact__heading title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="contact__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- liquid
      assign contact_form_class = 'isolate'

      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}

    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}

      {%- if form.posted_successfully? -%}

        <h2
          class="form-status form-status-list form__message"
          tabindex="-1"
          autofocus
        >
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ section.settings.success_message }}
        </h2>

      {%- elsif form.errors -%}

        <div class="form__message">
          <h2
            class="form-status caption-large text-body"
            role="alert"
            tabindex="-1"
            autofocus
          >
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ section.settings.error_heading }}
          </h2>
        </div>

        <ul class="form-status-list caption-large" role="list">
          {%- if form.errors contains 'email' -%}
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </a>
            </li>
          {%- endif -%}
        </ul>

      {%- endif -%}

      <div class="contact__fields">

        <!-- NAME -->
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >

          <label
            class="field__label"
            for="ContactForm-name"
          >
            {{ 'templates.contact.form.name' | t }}
          </label>
        </div>

        <!-- EMAIL -->
        <div class="field field--with-error">

          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            required
            aria-required="true"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >

          <label
            class="field__label"
            for="ContactForm-email"
          >
            {{ 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span>
          </label>

          {%- if form.errors contains 'email' -%}
            <small
              class="contact__field-error"
              id="ContactForm-email-error"
            >
              <span class="visually-hidden">
                {{ 'accessibility.error' | t }}
              </span>

              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>

                <span>
                  {{- form.errors.translated_fields.email | capitalize -}}
                  {{ form.errors.messages.email -}}
                </span>
              </span>
            </small>
          {%- endif -%}

        </div>

      </div>

      <!-- MESSAGE -->
      <div class="field">

        <textarea
          rows="7"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="Message"
        >{{- form.body -}}</textarea>

        <label
          class="form__label field__label"
          for="ContactForm-body"
        >
          Message
        </label>

      </div>

      <!-- SUBMIT -->
      <div class="contact__button">
        <button
          type="submit"
          class="button"
        >
          SEND MESSAGE
        </button>
      </div>

      <!-- PRIVACY NOTICE -->
      {%- if section.settings.show_privacy_notice and section.settings.privacy_text != blank -%}
        <div class="contact__privacy">

          {{ section.settings.privacy_text }}

          {%- if section.settings.privacy_link != blank -%}
            <a href="{{ section.settings.privacy_link }}">
              {{ section.settings.privacy_link_text }}
            </a>.
          {%- endif -%}

        </div>
      {%- endif -%}

    {%- endform -%}

  </div>
</div>

{% schema %}
{
  "name": "Zeotein Contact Form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "CONTACT ZEOTEIN",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Have a question? We're here to help.</p><p>Whether you have a question about Zeotein, your order, or something else, send us a message and we'll get back to you.</p>",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        },
        {
          "value": "hxl",
          "label": "Extra large"
        },
        {
          "value": "hxxl",
          "label": "Extra extra large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "success_message",
      "default": "Thanks! Your message has been sent.",
      "label": "Success message"
    },
    {
      "type": "text",
      "id": "error_heading",
      "default": "Please check the information below.",
      "label": "Error heading"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_notice",
      "default": true,
      "label": "Show privacy notice"
    },
    {
      "type": "textarea",
      "id": "privacy_text",
      "default": "We'll use the information you provide to respond to your inquiry.",
      "label": "Privacy notice"
    },
    {
      "type": "text",
      "id": "privacy_link_text",
      "default": "See our Privacy Policy",
      "label": "Privacy link text"
    },
    {
      "type": "url",
      "id": "privacy_link",
      "label": "Privacy Policy link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "Bottom padding"
    }
  ],
  "presets": [
    {
      "name": "Zeotein Contact Form"
    }
  ]
}
{% endschema %}