{%- liquid
  assign sid = 'zt-uvt-' | append: section.id
-%}

{% content_for 'block', type: 'cacao-type-uvt', id: 'type-uvt' %}
{% content_for 'block', type: 'cacao-type-uvt-2', id: 'type-uvt-2' %}

{{ 'us-vs-them-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-uvt"
  {{ section.shopify_attributes }}
  style="
    --zt-uvt-bg: {{ section.settings.bg_color }};
    --zt-uvt-heading: {{ section.settings.heading_color }};
    --zt-uvt-body: {{ section.settings.body_color }};
    --zt-uvt-ink: {{ section.settings.ink_color }};
    --zt-uvt-border: {{ section.settings.border_color }};
    --zt-uvt-featured: {{ section.settings.featured_bg }};
    --zt-uvt-featured-text: {{ section.settings.featured_text_color }};
    --zt-uvt-accent: {{ section.settings.accent_color }};
    --zt-uvt-check-bg: {{ section.settings.check_bg }};
    --zt-uvt-check-icon: {{ section.settings.check_icon_color }};
    --zt-uvt-cross-bg: {{ section.settings.cross_bg }};
    --zt-uvt-cross-icon: {{ section.settings.cross_icon_color }};
    --zt-uvt-note: {{ section.settings.note_color }};
    --zt-uvt-max-width: {{ section.settings.content_width | default: 1180 }}px;
    --zt-uvt-pad-top: {{ section.settings.padding_top }}px;
    --zt-uvt-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zt-uvt2">
    <div class="zt-uvt2__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zt-uvt2__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zt-uvt2__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="zt-uvt2__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign uvt_rows = section.settings.compare_rows | newline_to_br | split: '<br />' -%}
    <div class="zt-uvt2__wrap">
      <table class="zt-uvt2__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col">{{ section.settings.comp1_label | escape }}</th>
            <th scope="col" class="zt-uvt2__us">{{ section.settings.featured_title | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for row in uvt_rows -%}
            {%- assign row_clean = row | strip -%}
            {%- if row_clean == blank -%}{% continue %}{%- endif -%}
            {%- assign cells = row_clean | split: '|' -%}
            <tr>
              <th scope="row">{{ cells[0] | strip | escape }}</th>
              <td>{{ cells[1] | strip | escape }}</td>
              <td class="zt-uvt2__us">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true" focusable="false"><path d="M5 12.5 9.5 17 19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ cells[2] | strip | escape }}</span>
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="zt-uvt__note">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>

  <style>
    #{{ sid }} .zt-uvt2 {
      width: min(900px, calc(100% - 40px));
      margin: 0 auto;
    }
    #{{ sid }} .zt-uvt2__copy {
      margin: 0 0 28px;
      text-align: left;
    }
    #{{ sid }} .zt-uvt2__eyebrow {
      margin: 0 0 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #137a80;
    }
    #{{ sid }} .zt-uvt2__heading {
      margin: 0 0 12px;
      font-family: var(--zt-heading-font, inherit);
      font-size: var(--zt-heading-size, 44px);
      font-weight: var(--zt-heading-weight, 700);
      line-height: 1.15;
      color: var(--zt-uvt-ink, #1e1734);
    }
    #{{ sid }} .zt-uvt2__body {
      margin: 0;
      max-width: 620px;
      font-size: var(--zt-body-size, 18px);
      line-height: 1.5;
      color: var(--zt-uvt-body, #5b5b71);
    }
    #{{ sid }} .zt-uvt2__wrap {
      width: 100%;
    }
    #{{ sid }} .zt-uvt2__table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 16px;
      line-height: 1.45;
      color: var(--zt-uvt-ink, #1e1734);
    }
    #{{ sid }} .zt-uvt2__table th,
    #{{ sid }} .zt-uvt2__table td {
      padding: 16px 14px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid #e3ddef;
    }
    #{{ sid }} .zt-uvt2__table thead th {
      padding-top: 12px;
      padding-bottom: 12px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #5d5670;
      border-bottom: 1px solid #d6c5e8;
    }
    #{{ sid }} .zt-uvt2__table tbody th {
      font-weight: 500;
      color: #4a4258;
    }
    #{{ sid }} .zt-uvt2__table td {
      color: #6b6480;
    }
    #{{ sid }} .zt-uvt2__table .zt-uvt2__us {
      background: #f1eaf8;
      color: var(--zt-uvt-ink, #1e1734);
      font-weight: 800;
    }
    #{{ sid }} .zt-uvt2__table thead .zt-uvt2__us {
      color: #5F2D90;
    }
    #{{ sid }} .zt-uvt2__table td.zt-uvt2__us svg {
      display: inline-block;
      vertical-align: -1px;
      margin-right: 4px;
      color: #5F2D90;
    }
    @media screen and (max-width: 749px) {
      #{{ sid }} .zt-uvt2__heading {
        font-size: var(--zt-heading-size-m, 30px);
      }
      #{{ sid }} .zt-uvt2__body {
        font-size: 15px;
      }
      #{{ sid }} .zt-uvt2__table {
        font-size: 14px;
      }
      #{{ sid }} .zt-uvt2__table th,
      #{{ sid }} .zt-uvt2__table td {
        padding: 12px 8px;
      }
      #{{ sid }} .zt-uvt2__table thead th {
        font-size: 11px;
      }
    }
  </style></section>

