<section
  id="AboutDanaValues-{{ section.id }}"
  class="zeotein-about-dana-values"
  aria-labelledby="AboutDanaHeading-{{ section.id }}"
>
  <div class="zeotein-about-dana-values__inner page-width">

    <div class="zeotein-about-dana-values__grid">

      <!-- Dana Media -->
      <div class="zeotein-about-dana-values__media">

        {% if section.settings.video != blank %}

          {{
            section.settings.video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: true,
              playsinline: true,
              image_size: '1600x'
          }}

        {% elsif section.settings.dana_image != blank %}

          {{
            section.settings.dana_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.image_alt
          }}

        {% endif %}

      </div>

      <!-- Content -->
      <div class="zeotein-about-dana-values__content">

        <!-- Hi, I'm Dana -->
        <p class="zeotein-about-dana-values__eyebrow">
          {{ section.settings.eyebrow }}
        </p>

        <h2
          id="AboutDanaHeading-{{ section.id }}"
          class="zeotein-about-dana-values__heading"
        >
          {{ section.settings.heading }}
        </h2>

        <p class="zeotein-about-dana-values__founder-line">
          {{ section.settings.founder_line }}
        </p>

        <!-- Our Commitment to You -->
        <div class="zeotein-about-dana-values__principles">

          <h3 class="zeotein-about-dana-values__principles-heading">
            {{ section.settings.principles_heading }}
          </h3>

          <div class="zeotein-about-dana-values__list">

            <div class="zeotein-about-dana-values__item">
              <span class="zeotein-about-dana-values__number">01</span>
              <p>{{ section.settings.point_1 }}</p>
            </div>

            <div class="zeotein-about-dana-values__item">
              <span class="zeotein-about-dana-values__number">02</span>
              <p>{{ section.settings.point_2 }}</p>
            </div>

            <div class="zeotein-about-dana-values__item">
              <span class="zeotein-about-dana-values__number">03</span>
              <p>{{ section.settings.point_3 }}</p>
            </div>

            <div class="zeotein-about-dana-values__item">
              <span class="zeotein-about-dana-values__number">04</span>
              <p>{{ section.settings.point_4 }}</p>
            </div>

          </div>

          <p class="zeotein-about-dana-values__signature">
            {{ section.settings.signature }}
          </p>

        </div>

      </div>

    </div>

  </div>
</section>


<style>
  #AboutDanaValues-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Main layout */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 7vw, 96px);
  }

  /* Dana media */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media {
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    background: #f1f0ee;
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media img,
  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Video */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media video {
    background: #f1f0ee;
  }

  /* Content */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__content {
    max-width: 590px;
  }

  /* HI, I'M DANA */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__eyebrow {
    margin: 0 0 12px;
    color: {{ section.settings.accent_color }};
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-transform: none;
  }

  /* Hidden heading */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__heading {
    display: none;
  }

  /* Dana requested line */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__founder-line {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.6;
    font-weight: 600;
    max-width: 560px;
  }

  /* Our Commitment to You */

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__principles {
    margin-top: 36px;
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__principles-heading {
    margin: 0 0 14px;
    color: {{ section.settings.text_color }};
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__list {
    border-top: 1px solid rgba(33, 22, 47, 0.12);
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid rgba(33, 22, 47, 0.12);
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__number {
    padding-top: 2px;
    color: {{ section.settings.accent_color }};
    font-size: 10px;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__item p {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    line-height: 1.6;
  }

  #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__signature {
    margin: 18px 0 0;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    line-height: 1.5;
    font-weight: 700;
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media {
      max-width: 720px;
      margin: 0 auto;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__content {
      max-width: 720px;
      margin: 0 auto;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__grid {
      gap: 30px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media {
      border-radius: {{ section.settings.mobile_image_radius }}px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media img,
    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__media video {
      aspect-ratio: 4 / 5;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__content {
      max-width: none;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__eyebrow {
      margin-bottom: 10px;
      font-size: 30px;
      line-height: 1.1;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__founder-line {
      font-size: 15px;
      line-height: 1.55;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__principles {
      margin-top: 30px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__principles-heading {
      font-size: 21px;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__item {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 12px;
      padding: 17px 0;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__item p {
      font-size: 15px;
      line-height: 1.6;
    }

    #AboutDanaValues-{{ section.id }} .zeotein-about-dana-values__signature {
      margin-top: 18px;
      font-size: 15px;
    }
  }
</style>


{% schema %}
{
  "name": "About Dana Values",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "dana_image",
      "label": "Dana's photo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Dana's video"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Dana, Zeotein."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Heading",
      "default": "HI, I'M DANA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hidden heading",
      "default": "Dana"
    },
    {
      "type": "text",
      "id": "founder_line",
      "label": "Dana's line",
      "default": "Dana — I run the day-to-day at Zeotein. Manitowoc, Wisconsin."
    },
    {
      "type": "text",
      "id": "principles_heading",
      "label": "Principles heading",
      "default": "What We Won't Do"
    },
    {
      "type": "textarea",
      "id": "point_1",
      "label": "Point 1",
      "default": "We won't add sweeteners to make this easier to sell."
    },
    {
      "type": "textarea",
      "id": "point_2",
      "label": "Point 2",
      "default": "We won't pad a label to make it look impressive."
    },
    {
      "type": "textarea",
      "id": "point_3",
      "label": "Point 3",
      "default": "We won't tell you a supplement will fix a medical problem. It won't, and anyone telling you otherwise is selling you something else."
    },
    {
      "type": "textarea",
      "id": "point_4",
      "label": "Point 4",
      "default": "We won't run a subscription you can't cancel in under a minute."
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— Dana"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F5F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#21162F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#5F2D91"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_image_radius",
      "label": "Mobile image corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "About Dana Values"
    }
  ]
}
{% endschema %}