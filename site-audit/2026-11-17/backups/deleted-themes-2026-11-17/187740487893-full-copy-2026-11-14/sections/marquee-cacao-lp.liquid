  ],
  "presets": [
    {
      "name": "Marquee Cacao LP",
      "settings": {
        "bg_color": "#580d93",
        "text_color": "#fcfcfc",
        "icon_color": "#009c96",
        "show_icons": true,
        "icon_size": 20,
        "font_family": "manrope",
        "custom_font": "",
        "label_font": "manrope",
        "label_font_custom": "",
        "label_weight": "800",
        "label_size_desktop": 18,
        "label_size_mobile": 14,
        "gap": 48,
        "padding_y": 24,
        "speed": 72,
        "pause_on_hover": true
      },
      "blocks": [
        {
