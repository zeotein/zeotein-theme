<section
  id="{{ sid }}"
  class="zt-bb"
  data-zt-bb
  data-zt-bb-config="zt-bb-config-{{ section.id }}"
  {{ section.shopify_attributes }}
  style="
    --zt-bb-bg: {{ section.settings.bg_color }};
    --zt-bb-accent: {{ section.settings.accent_color }};
    --zt-bb-ink: {{ section.settings.ink_color }};
    --zt-bb-pad-top: {{ section.settings.padding_top }}px;
    --zt-bb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --zt-bb-max-width: {{ section.settings.content_width | default: 1060 }}px;
  "
>
  <script type="application/json" id="zt-bb-config-{{ section.id }}">{{ buybox_config }}</script>

  <div class="zt-bb__inner" id="purchase">
    {%- for block in section.blocks -%}
      {%- if block.type == 'header' -%}
        {% render 'zt-bb-block-header', block: block %}
      {%- endif -%}
    {%- endfor -%}

    <div class="zt-bb__layout">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery' -%}
          {% render 'zt-bb-block-gallery',
            block: block,
            slide_1: slide_1,
            slide_2: slide_2,
            slide_3: slide_3,
            slide_4: slide_4,
            slide_5: slide_5,
            slide_6: slide_6
          %}
        {%- endif -%}
      {%- endfor -%}

      <div class="zt-bb__offer">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'product_info' -%}
              {% render 'zt-bb-block-product-info', block: block %}
            {%- when 'buy_box' -%}
              {% render 'zt-bb-block-buy-box', block: block %}
            {%- when 'cta' -%}
              {% render 'zt-bb-block-cta', block: block %}
            {%- when 'faq' -%}
              {% render 'zt-bb-block-faq', block: block %}
          {%- endcase -%}
        {%- endfor -%}

        <form class="zt-bb__form" data-zt-bb-form>
          <input type="hidden" name="id" data-zt-bb-variant value="{{ variant_id }}">
          <input type="hidden" name="quantity" data-zt-bb-qty value="1">
          <input type="hidden" name="selling_plan" data-zt-bb-selling-plan value="">
        </form>
      </div>
    </div>
  </div>
</section>

