{%- liquid
  assign sid = 'zt-bb-' | append: section.id
  assign bb_product = all_products['zeotein-cacao-bulk-bag-cacao-lp']
  if bb_product == blank
    assign bb_product = section.settings.product
  endif
  assign variant = bb_product.selected_or_first_available_variant
  assign variant_id = variant.id | default: '67596435783893'
  assign seal_plan_1 = '6565560533'
  assign seal_plan_2 = '6565593301'
  assign seal_plan_3 = '6565626069'
  assign seal_plan_4 = '6565658837'

  # Cart gifts are unlisted $0 products so checkout stays free without a discount code.
  # Theme Editor shaker picker is for the kit image only.
  assign shaker = all_products['lp-gift-cleanblend-shaker']
  assign shaker_variant_id = '67706369704149'
  if shaker != blank and shaker.selected_or_first_available_variant
    assign shaker_variant_id = shaker.selected_or_first_available_variant.id
  endif

  assign scoop_product = all_products['lp-gift-save-a-scoop']
  assign scoop_variant_id = '67706369507541'
  if scoop_product != blank and scoop_product.selected_or_first_available_variant
    assign scoop_variant_id = scoop_product.selected_or_first_available_variant.id
  endif
  assign guide_starter = all_products['lp-gift-starter-guide']
  assign guide_cacao = all_products['lp-gift-cacao-recipe-guide']
  assign guide_vegan = all_products['lp-gift-vegan-recipe-guide']
  assign guide_starter_vid = '67706369540309'
  assign guide_cacao_vid = '67706369605845'
  assign guide_vegan_vid = '67706369638613'
  if guide_starter != blank and guide_starter.selected_or_first_available_variant
    assign guide_starter_vid = guide_starter.selected_or_first_available_variant.id
  endif
  if guide_cacao != blank and guide_cacao.selected_or_first_available_variant
    assign guide_cacao_vid = guide_cacao.selected_or_first_available_variant.id
  endif
  if guide_vegan != blank and guide_vegan.selected_or_first_available_variant
    assign guide_vegan_vid = guide_vegan.selected_or_first_available_variant.id
  endif

  assign offer = nil
  assign tiers = nil
  assign gallery = nil
  assign product_info = nil
  assign cta = nil
  for block in section.blocks
    case block.type
      when 'buy_box'
        assign offer = block.settings
      when 'pricing_tiers'
        assign tiers = block.settings
      when 'gallery'
        assign gallery = block.settings
      when 'product_info'
        assign product_info = block.settings
      when 'cta'
        assign cta = block.settings
    endcase
  endfor
  if tiers == blank and offer != blank
    assign tiers = offer
  endif

  # Gallery: product media and/or manual pickers; theme assets fill empty slots in markup/JSON
  assign media_source = 'manual'
  if gallery != blank and gallery.media_source != blank
    assign media_source = gallery.media_source
  endif

  assign slide_1 = nil
  assign slide_2 = nil
  assign slide_3 = nil
  assign slide_4 = nil
  assign slide_5 = nil
  assign slide_6 = nil

  if media_source == 'product' and bb_product != blank
    assign product_image_i = 0
    for media in bb_product.media
      if media.media_type == 'image' and product_image_i < 6
        assign product_image_i = product_image_i | plus: 1
        case product_image_i
          when 1
            assign slide_1 = media
          when 2
            assign slide_2 = media
          when 3
            assign slide_3 = media
          when 4
            assign slide_4 = media
          when 5
            assign slide_5 = media
          when 6
            assign slide_6 = media
        endcase
      endif
    endfor
  endif

  if slide_1 == blank and gallery != blank
    assign slide_1 = gallery.image_1
  endif
  if slide_2 == blank and gallery != blank
    assign slide_2 = gallery.image_2
  endif
  if slide_3 == blank and gallery != blank
    assign slide_3 = gallery.image_3
  endif
  if slide_4 == blank and gallery != blank
    assign slide_4 = gallery.image_4
  endif
  if slide_5 == blank and gallery != blank
    assign slide_5 = gallery.image_5
  endif
  if slide_6 == blank and gallery != blank
    assign slide_6 = gallery.image_6
  endif

  assign product_title = product_info.product_title | default: '30-Day Cacao Bulk Bag'
  assign cta_prefix = cta.cta_prefix | default: 'Start Now'
  assign after_add_action = cta.after_add_action | default: 'none'
  assign tier1_label = tiers.tier1_label | default: '1 bag'
  assign tier2_label = tiers.tier2_label | default: '2 bags'
  assign tier3_label = tiers.tier3_label | default: '3 bags'
  assign tier4_label = tiers.tier4_label | default: '4 bags'
  assign show_tier_4 = false
  if tiers.show_tier_4
    assign show_tier_4 = true
  endif
  assign add_shaker_gift = false
  if shaker_variant_id != blank
    assign add_shaker_gift = true
  endif
  assign add_bulk_bag_gifts = false
  if scoop_variant_id != blank or guide_starter_vid != blank or guide_cacao_vid != blank or guide_vegan_vid != blank
    assign add_bulk_bag_gifts = true
  endif
-%}

