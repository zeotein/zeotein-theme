{%- comment -%}
  Risk Free Cacao LP: guarantee card (seal + heading) with the CTA below.
  Card content is hardcoded. Legacy settings stay in the schema so the template keeps validating.
  CTA styling matches the customer story teal "Claim My 55% Off" button (.zt-cs__cta).
{%- endcomment -%}
{%- liquid
  assign sid = 'zt-rf-' | append: section.id
  assign cta_href = section.settings.cta_link | default: '#purchase'
  assign cta_label = section.settings.cta_label | default: 'Claim My 55% Off'
-%}

{% content_for 'block', type: 'cacao-type-rf', id: 'type-rf' %}

{{ 'risk-free-cacao-lp.css' | asset_url | stylesheet_tag }}

<style>
  #{{ sid }}.zt-rf {
    background: #F3EDF9;
    color: #1e1734;
    padding: 32px 16px 40px;
    min-height: 0;
  }
  #{{ sid }} .zt-rf__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 520px;
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }
  #{{ sid }} .zt-rf2__card {
    box-sizing: border-box;
    width: 100%;
    background: #ffffff;
    border: 1px solid #e2d6f0;
    border-radius: 14px;
    padding: 22px 16px 20px;
    text-align: center;
    box-shadow: 0 10px 28px rgba(88, 13, 147, .08);
  }
  #{{ sid }} .zt-rf2__seal {
    display: block;
    width: 120px;
    height: 120px;
    margin: 0 auto 12px;
  }
  #{{ sid }} .zt-rf2__seal svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  #{{ sid }} .zt-rf2__heading {
    margin: 0;
    color: #580D93;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.01em;
  }
  #{{ sid }} .zt-rf__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    margin: 0;
    padding: 12px 26px;
    background: #00C9B8;
    color: #1e1734;
    border: 1.5px solid #1e1734;
    border-radius: 999px;
    box-shadow: 8px 8px 0 0 #1e1734;
    font-family: Manrope, Arial, sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: .6px;
    line-height: 21.6px;
    text-transform: none;
    text-decoration: none;
    transition: transform .18s, filter .18s;
  }
  #{{ sid }} .zt-rf__cta span {
    display: block;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
  }
  #{{ sid }} .zt-rf__cta-arrow {
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }
  @media (max-width: 749px) {
    #{{ sid }} .zt-rf__cta {
      width: 100%;
    }
  }
  @media (min-width: 750px) {
    #{{ sid }}.zt-rf {
      padding: 56px 24px 64px;
    }
  }
</style>

<section
  id="{{ sid }}"
  class="zt-rf"
  {{ section.shopify_attributes }}
>
  <div class="zt-rf__inner">
    <div class="zt-rf2__card">
      <span class="zt-rf2__seal"><svg viewBox="0 0 120 120" aria-hidden="true" focusable="false"><polygon points="60,1 66.9,7.5 75.3,3 80.3,11 89.5,8.9 92.3,18 101.7,18.3 102,27.7 111.1,30.5 109,39.7 117,44.7 112.5,53.1 119,60 112.5,66.9 117,75.3 109,80.3 111.1,89.5 102,92.3 101.7,101.7 92.3,102 89.5,111.1 80.3,109 75.3,117 66.9,112.5 60,119 53.1,112.5 44.7,117 39.7,109 30.5,111.1 27.7,102 18.3,101.7 18,92.3 8.9,89.5 11,80.3 3,75.3 7.5,66.9 1,60 7.5,53.1 3,44.7 11,39.7 8.9,30.5 18,27.7 18.3,18.3 27.7,18 30.5,8.9 39.7,11 44.7,3 53.1,7.5" fill="#580D93" stroke="#580D93" stroke-width="1.5" stroke-linejoin="round"/><circle cx="60" cy="60" r="46" fill="none" stroke="#32BAC0" stroke-width="2.5"/><circle cx="60" cy="60" r="41" fill="none" stroke="#ffffff" stroke-opacity=".35" stroke-width="1" stroke-dasharray="2 3"/><text x="60" y="59" text-anchor="middle" font-size="36" font-weight="900" fill="#ffffff" font-family="Manrope,ui-sans-serif,system-ui,sans-serif" letter-spacing="-1.5">30</text><text x="60" y="71" text-anchor="middle" font-size="10.5" font-weight="900" fill="#32BAC0" font-family="Manrope,ui-sans-serif,system-ui,sans-serif" letter-spacing="3.5">DAY</text><path d="M44 76.5h32" stroke="#32BAC0" stroke-width="2" stroke-linecap="round"/><text x="60" y="87" text-anchor="middle" font-size="7.6" font-weight="800" fill="#ffffff" font-family="Manrope,ui-sans-serif,system-ui,sans-serif" letter-spacing=".9">MONEY BACK</text></svg></span>
      <h2 class="zt-rf2__heading">Love it or your money back.</h2>
    </div>

    <a class="zt-rf__cta" href="{{ cta_href }}">
      <span>{{ cta_label | escape }}</span>
      <svg class="zt-rf__cta-arrow" viewBox="0 0 16 16" width="16" height="16" focusable="false" aria-hidden="true">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/>
      </svg>
    </a>
  </div>
</section>

<script>
  (function () {
    if (window.ztRfCtaScroll) return;
    window.ztRfCtaScroll = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.zt-rf__cta');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;

      var target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      if (href === '#purchase' && typeof window.ztScrollToCacaoOffer === 'function') {
        window.ztScrollToCacaoOffer({ frameKey: 'ztRfCtaFrame' });
        return;
      }

      var start = window.scrollY || window.pageYOffset;
      var margin = parseFloat(window.getComputedStyle(target).scrollMarginTop) || 0;
      var end = target.getBoundingClientRect().top + start - margin;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.ztRfCtaFrame) {
        window.cancelAnimationFrame(window.ztRfCtaFrame);
        window.ztRfCtaFrame = 0;
      }

      if (reduce || Math.abs(end - start) < 2) {
        window.scrollTo(0, end);
        if (window.history.replaceState) window.history.replaceState(null, '', window.location.pathname + window.location.search);
        return;
      }

      var duration = 1300;
      var startTime = null;

      function ease(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function finish(cancelled) {
        window.removeEventListener('wheel', cancel);
        window.removeEventListener('touchstart', cancel);
        window.ztRfCtaFrame = 0;
        if (!cancelled && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function cancel() {
        if (window.ztRfCtaFrame) window.cancelAnimationFrame(window.ztRfCtaFrame);
        finish(true);
      }

      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + (end - start) * ease(progress));
        if (progress < 1) {
          window.ztRfCtaFrame = window.requestAnimationFrame(step);
        } else {
          finish(false);
        }
      }

      window.addEventListener('wheel', cancel, { passive: true });
      window.addEventListener('touchstart', cancel, { passive: true });
      window.ztRfCtaFrame = window.requestAnimationFrame(step);
    });
  })();
</script>

