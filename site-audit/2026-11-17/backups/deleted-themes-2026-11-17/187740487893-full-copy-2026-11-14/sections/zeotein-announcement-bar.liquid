{% style %}
  .z-announcement-bar {
    background-color: #160A26;
    width: 100%;
    padding: 10px 20px;
    text-align: center;
    box-sizing: border-box;
  }

  .z-announcement-bar__text {
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #CDBFE0;
  }

  .z-announcement-bar__highlight {
    color: #2EC9C9;
    font-weight: 700;
  }

  @media screen and (max-width: 700px) {
    .z-announcement-bar {
      padding: 9px 14px;
    }

    .z-announcement-bar__text {
      font-size: 9px;
      letter-spacing: 0.06em;
      line-height: 1.35;
    }
  }
{% endstyle %}

<div class="z-announcement-bar">
  <p class="z-announcement-bar__text">
    {{ section.settings.bar_text }}
    {% if section.settings.highlight_text != blank %}
      <span class="z-announcement-bar__highlight">
        {{ section.settings.highlight_text }}
      </span>
    {% endif %}
  </p>
</div>

{% schema %}
{
  "name": "Zeotein Announcement Bar",
  "tag": "section",
  "class": "zeotein-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "bar_text",
      "label": "Main announcement text",
      "default": "WELCOME TO ZEOTEIN —"
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlighted text",
      "default": "REAL NUTRITION MADE SIMPLE."
    }
  ],
  "presets": [
    {
      "name": "Zeotein Announcement Bar"
    }
  ]
}
{% endschema %}