{%- liquid
  assign sid = 'zt-tm-' | append: section.id
  assign header_stars = section.settings.header_stars | default: 5
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'heading,title,body,sub,name,meta'
%}

{{ 'testimonials-cacao-lp.css' | asset_url | stylesheet_tag }}

{%- capture zt_tm_star -%}
  <svg class="zt-tm__star" viewBox="0 0 20 20" width="18" height="18" focusable="false" aria-hidden="true">
    <path fill="currentColor" d="M10 1.6l2.35 5.1 5.55.72-4.1 3.78.1 5.55L10 14.3l-4.9 2.75.1-5.55-4.1-3.78 5.55-.72L10 1.6z"/>
  </svg>
{%- endcapture -%}

<section
  id="{{ sid }}"
  class="zt-tm"
  {{ section.shopify_attributes }}
  style="
    --zt-tm-bg: {{ section.settings.bg_color }};
    --zt-tm-heading: {{ section.settings.heading_color }};
    --zt-tm-sub: {{ section.settings.sub_color }};
    --zt-tm-star: {{ section.settings.star_color }};
    --zt-tm-card-bg: {{ section.settings.card_bg_color }};
    --zt-tm-card-border: {{ section.settings.card_border_color }};
    --zt-tm-shadow: {{ section.settings.shadow_color }};
    --zt-tm-title: {{ section.settings.title_color }};
    --zt-tm-body: {{ section.settings.body_color }};
    --zt-tm-name: {{ section.settings.name_color }};
    --zt-tm-meta: {{ section.settings.meta_color }};
    --zt-tm-radius: {{ section.settings.card_radius }}px;
    --zt-tm-shadow-x: {{ section.settings.shadow_x }}px;
    --zt-tm-shadow-y: {{ section.settings.shadow_y }}px;
    --zt-tm-avatar: {{ section.settings.avatar_size }}px;
    --zt-tm-max-width: {{ section.settings.content_width | default: 1120 }}px;
    --zt-tm-pad-top: {{ section.settings.padding_top }}px;
    --zt-tm-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zt-tm__inner">
    <div class="zt-tm__header">
      {%- if section.settings.show_header_stars -%}
        <div class="zt-tm__stars" aria-hidden="true">
          {%- for i in (1..header_stars) -%}
            {{ zt_tm_star }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="zt-tm__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="zt-tm__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="zt-tm__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating | default: 5
            if rating < 1
              assign rating = 1
            endif
            if rating > 5
              assign rating = 5
            endif
            assign name_alt = block.settings.name | default: 'Customer'
          -%}
          <article class="zt-tm__card" {{ block.shopify_attributes }}>
            <div class="zt-tm__avatar">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 240
                  | image_tag:
                    class: 'zt-tm__avatar-img',
                    loading: 'lazy',
                    widths: '72, 120, 180, 240',
                    sizes: '72px',
                    alt: name_alt
                }}
              {%- else -%}
                <div class="zt-tm__avatar-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
            </div>

            <div class="zt-tm__card-stars" aria-label="{{ rating }} out of 5 stars">
              {%- for i in (1..rating) -%}
                {{ zt_tm_star }}
              {%- endfor -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="zt-tm__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="zt-tm__body">{{ block.settings.body | escape }}</p>
            {%- endif -%}

            {%- if block.settings.name != blank -%}
              <p class="zt-tm__name">{{ block.settings.name | escape }}</p>
            {%- endif -%}

            {%- if block.settings.meta != blank -%}
              <p class="zt-tm__meta">{{ block.settings.meta | escape }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

