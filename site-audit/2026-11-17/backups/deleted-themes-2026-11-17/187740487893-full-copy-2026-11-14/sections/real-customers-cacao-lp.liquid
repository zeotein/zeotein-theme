{%- liquid
  assign sid = 'zt-rc-' | append: section.id
  assign text_cols = section.settings.text_columns_desktop | default: 3
  assign video_cols = section.settings.video_columns_desktop | default: 5
  assign video_cols_m = section.settings.video_columns_mobile | default: 2
-%}

{% content_for 'block', type: 'cacao-type-rc', id: 'type-rc' %}
{% content_for 'block', type: 'cacao-type-rc-2', id: 'type-rc-2' %}

{{ 'real-customers-cacao-lp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'real-customers-cacao-lp.js' | asset_url }}" defer></script>

<section
  id="{{ sid }}"
  class="zt-rc{% if request.design_mode %} zt-rc--editor{% endif %}"
  data-zt-rc
  {{ section.shopify_attributes }}
  style="
    --zt-rc-bg: {{ section.settings.bg_color }};
    --zt-rc-heading: {{ section.settings.heading_color }};
    --zt-rc-text: {{ section.settings.text_color }};
    --zt-rc-muted: {{ section.settings.muted_color }};
    --zt-rc-star: {{ section.settings.star_color }};
    --zt-rc-tab: {{ section.settings.tab_active_color }};
    --zt-rc-tab-border: {{ section.settings.tab_border_color }};
    --zt-rc-badge: {{ section.settings.badge_color }};
    --zt-rc-play: {{ section.settings.play_color }};
    --zt-rc-max-width: {{ section.settings.content_width | default: 1120 }}px;
    --zt-rc-pad-top: {{ section.settings.padding_top }}px;
    --zt-rc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --zt-rc-text-cols: {{ text_cols }};
    --zt-rc-video-cols: {{ video_cols }};
    --zt-rc-video-cols-m: {{ video_cols_m }};
  "
>
  <div class="zt-rc__inner">
    <header class="zt-rc__header">
      {%- if section.settings.rating_label != blank -%}
        <div class="zt-rc__rating">
          <span class="zt-rc__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" width="14" height="14" focusable="false">
                <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.52L10 14.27 5.06 16.73 6 11.21l-4-3.9 5.53-.8L10 1.5z"/>
              </svg>
            {%- endfor -%}
          </span>
          <span>{% render 'cacao-lp-review-score', format: 'hero', fallback: section.settings.rating_label %}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="zt-rc__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </header>

    <div class="zt-rc__switcher" role="tablist" aria-label="{{ section.settings.heading | default: 'Customer reviews' | escape }}">
      {% content_for 'blocks' %}
    </div>

    {% content_for 'block', type: 'cacao-rc-videos', id: 'video-row' %}



    {%- if section.settings.disclaimer != blank -%}
      <p class="zt-rc__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}
  </div>

  <div class="zt-rc__modal" data-zt-rc-modal hidden>
    <div class="zt-rc__modal-backdrop" data-zt-rc-modal-backdrop></div>
    <div class="zt-rc__modal-dialog" role="dialog" aria-modal="true" aria-label="Video review">
      <button type="button" class="zt-rc__modal-close" data-zt-rc-modal-close aria-label="Close video">×</button>
      <div class="zt-rc__modal-frame" data-zt-rc-modal-frame></div>
    </div>
  </div>
</section>

