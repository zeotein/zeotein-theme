{%- liquid
  assign sid = 'zt-faq-' | append: section.id
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'heading,question,answer,eyebrow'
%}

{{ 'faq-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-faq"
  {{ section.shopify_attributes }}
  style="
    --zt-faq-bg: {{ section.settings.bg_color }};
    --zt-faq-eyebrow: {{ section.settings.eyebrow_color }};
    --zt-faq-heading: {{ section.settings.heading_color }};
    --zt-faq-question: {{ section.settings.question_color }};
    --zt-faq-answer: {{ section.settings.answer_color }};
    --zt-faq-divider: {{ section.settings.divider_color }};
    --zt-faq-icon: {{ section.settings.icon_color }};
    --zt-faq-max-width: {{ section.settings.content_width | default: 1180 }}px;
    --zt-faq-pad-top: {{ section.settings.padding_top }}px;
    --zt-faq-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zt-faq__inner">
    <div class="zt-faq__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zt-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zt-faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="zt-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            {%- liquid
              assign is_open = false
              if block.settings.open_by_default
                assign is_open = true
              elsif section.settings.open_first and forloop.first
                assign is_open = true
              endif
            -%}
            <details
              class="zt-faq__item"
              id="{{ sid }}-item-{{ block.id }}"
              {% if is_open %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary>
                <span class="zt-faq__q">{{ block.settings.question | escape }}</span>
                <svg class="zt-faq__icon" viewBox="0 0 16 16" width="18" height="18" focusable="false" aria-hidden="true">
                  <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 6l5 5 5-5"/>
                </svg>
              </summary>
              {%- if block.settings.answer != blank -%}
                {%- liquid
                  assign faq_answer = block.settings.answer | escape | newline_to_br
                  assign portal_url = 'https://zeotein.com/a/subscriptions/login'
                  capture portal_link
                    echo '<a href="https://zeotein.com/a/subscriptions/login" target="_blank" rel="noopener noreferrer">customer portal</a>'
                  endcapture
                -%}
                <div class="zt-faq__a">
                  {{ faq_answer | replace: portal_url, portal_link }}
                </div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

