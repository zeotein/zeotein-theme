</style>


<script>
(function () {

  /* ==========================================================
     FIND FINAL PRODUCT CHOICE
  ========================================================== */

  function findZeoteinProductChoice() {

    var target = document.querySelector(
      '[id^="zeotein-final-product-cta-"]'
    );

    if (target) return target;


    target = document.getElementById(
      'zeotein-final-product-cta'
    );

    if (target) return target;


    target = document.querySelector(
      '.z-upgrade'
    );

    if (target) return target;


    var headings = document.querySelectorAll(
      'h1, h2, h3, h4'
    );


    for (
      var i = 0;
      i < headings.length;
      i++
    ) {

      var text =
        (headings[i].textContent || '')
        .trim()
        .toLowerCase();


      if (
        text.indexOf('find your zeotein') !== -1
      ) {

        return (
          headings[i].closest('section') ||
          headings[i]
        );

      }

    }


    return null;

  }


  /* ==========================================================
     SCROLL TO FINAL PRODUCT CHOICE
  ========================================================== */

  function scrollToProductChoice(event) {

    var target =
      findZeoteinProductChoice();


    if (!target) return;


    event.preventDefault();


    var header =
      document.querySelector(
        'header, .shopify-section-header'
      );


    var headerOffset =
      header
        ? Math.min(
            header.getBoundingClientRect().height,
            110
          )
        : 0;


    var top =
      target.getBoundingClientRect().top +
      window.pageYOffset -
      headerOffset -
      16;


    window.scrollTo({

      top: Math.max(0, top),

      behavior: 'smooth'

    });

  }


  /* ==========================================================
     BIND CTA
  ========================================================== */

  function bindButtons(root) {

    var scope =
      root || document;


    scope
      .querySelectorAll(
        '[data-zt-scroll-disabled]'
      )
      .forEach(function (button) {


        if (
          button.dataset.zeoteinBound === 'true'
        ) {

          return;

        }


        button.dataset.zeoteinBound = 'true';


        button.addEventListener(
          'click',
          scrollToProductChoice
        );

      });

  }


  bindButtons(document);


  /* Shopify Theme Editor */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      bindButtons(event.target);

    }
  );

})();
</script>


