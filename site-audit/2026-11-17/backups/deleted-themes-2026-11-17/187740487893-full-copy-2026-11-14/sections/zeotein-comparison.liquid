  .zt-comparison__row--header
  .zt-comparison__cell--zeotein {

    background:
      rgba(111, 74, 168, 0.45);

    color: #ffffff;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }


