{% comment %}
  ZEOTEIN — STEP 13
  COMPARISON / VALUE

  Purpose:
  - Answer: "Why should I pay for this?"
  - Compare routine simplicity rather than making unsupported competitor claims
  - Keep nutritional claims limited to verified Zeotein Cacao facts
  - Use a premium editorial comparison graphic
{% endcomment %}

<section
  id="zeotein-comparison-{{ section.id }}"
  class="zt-comparison"
>
  <div class="zt-comparison__container">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="zt-comparison__header">

      {% if section.settings.eyebrow != blank %}
        <div class="zt-comparison__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="zt-comparison__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <p class="zt-comparison__intro">
          {{ section.settings.intro }}
        </p>
      {% endif %}

    </div>


    <!-- =========================================
         COMPARISON CARD
    ========================================== -->

    <div class="zt-comparison__card">

      <div class="zt-comparison__table">

        <!-- TABLE HEADER -->

        <div class="zt-comparison__row zt-comparison__row--header">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>THE ROUTINE</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">
            <span>{{ section.settings.typical_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <div class="zt-comparison__zeotein-label">

              <span class="zt-comparison__zeotein-dot"></span>

              {{ section.settings.zeotein_label }}

            </div>

          </div>

        </div>


        <!-- =====================================
             ROW 01
        ====================================== -->

        <div class="zt-comparison__row">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_1_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__x">×</span>

            <span>
              {{ section.settings.row_1_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_1_zeotein }}
            </strong>

          </div>

        </div>


        <!-- =====================================
             ROW 02
        ====================================== -->

        <div class="zt-comparison__row">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_2_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__x">×</span>

            <span>
              {{ section.settings.row_2_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_2_zeotein }}
            </strong>

          </div>

        </div>


        <!-- =====================================
             ROW 03
        ====================================== -->

        <div class="zt-comparison__row">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_3_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__x">×</span>

            <span>
              {{ section.settings.row_3_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_3_zeotein }}
            </strong>

          </div>

        </div>


        <!-- =====================================
             ROW 04
        ====================================== -->

        <div class="zt-comparison__row">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_4_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__x">×</span>

            <span>
              {{ section.settings.row_4_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_4_zeotein }}
            </strong>

          </div>

        </div>


        <!-- =====================================
             ROW 05
        ====================================== -->

        <div class="zt-comparison__row zt-comparison__row--verified">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_5_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__dash">—</span>

            <span>
              {{ section.settings.row_5_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_5_zeotein }}
            </strong>

          </div>

        </div>


        <!-- =====================================
             ROW 06
        ====================================== -->

        <div class="zt-comparison__row zt-comparison__row--verified">

          <div class="zt-comparison__cell zt-comparison__cell--label">
            <span>{{ section.settings.row_6_label }}</span>
          </div>

          <div class="zt-comparison__cell zt-comparison__cell--typical">

            <span class="zt-comparison__dash">—</span>

            <span>
              {{ section.settings.row_6_typical }}
            </span>

          </div>

          <div class="zt-comparison__cell zt-comparison__cell--zeotein">

            <span class="zt-comparison__check">✓</span>

            <strong>
              {{ section.settings.row_6_zeotein }}
            </strong>

          </div>

        </div>

      </div>


      <!-- MOBILE NOTE -->

      <div class="zt-comparison__mobile-note">
        {{ section.settings.mobile_note }}
      </div>

    </div>


    <!-- =========================================
         CTA
         DESTINATION REMAINS UNCHANGED
    ========================================== -->

    {% if section.settings.cta_text != blank %}

      <div class="zt-comparison__cta-wrap">

        <a
          href="{{ section.settings.cta_url | default: '/collections/shop-all' }}"
          class="zt-comparison__cta"
          data-zeotein-shop-cta
        >

          <span>
            {{ section.settings.cta_text }}
          </span>

          <span class="zt-comparison__cta-arrow">
            →
          </span>

        </a>

      </div>

    {% endif %}

  </div>
</section>


<style>

  /* ==========================================================
     ZEOTEIN — COMPARISON / VALUE
  ========================================================== */

  #zeotein-comparison-{{ section.id }} {

    --zt-cream: #F8F6F2;
    --zt-purple: #6F4AA8;
    --zt-purple-dark: #51357D;
