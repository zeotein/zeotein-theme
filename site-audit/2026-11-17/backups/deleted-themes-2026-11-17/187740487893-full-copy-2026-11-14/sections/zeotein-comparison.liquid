  #zeotein-comparison-{{ section.id }}
  .zt-comparison__cell--zeotein {

    gap: 10px;

    background: #ffffff;

    color: var(--zt-purple-dark);

    font-size: 14px;

    line-height: 1.45;
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__row:not(.zt-comparison__row--header)
