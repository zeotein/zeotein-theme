    display: grid;

    grid-template-columns:
      1.1fr 0.9fr 0.9fr;

    border-bottom: 1px solid var(--zt-line);
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__row:last-child {

    border-bottom: 0;
  }


  /* ==========================================================
     HEADER ROW
  ========================================================== */

  #zeotein-comparison-{{ section.id }}
  .zt-comparison__row--header {

    min-height: 84px;

    border-bottom: 0;

    background: var(--zt-navy);

    color: #ffffff;
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__row--header
  .zt-comparison__cell {

    border-right:
      1px solid rgba(255,255,255,0.09);
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__row--header
  .zt-comparison__cell:last-child {

    border-right: 0;
  }


  /* ==========================================================
     CELLS
  ========================================================== */

