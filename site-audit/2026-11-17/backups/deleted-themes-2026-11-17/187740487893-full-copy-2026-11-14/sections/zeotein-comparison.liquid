    max-width: 760px;

    margin: 0 auto 52px;

    text-align: center;
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__eyebrow {

    margin-bottom: 14px;

    color: var(--zt-purple);

    font-size: 11px;

    line-height: 1.4;

    font-weight: 700;

    letter-spacing: 0.18em;

    text-transform: uppercase;
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__heading {

    margin: 0;

    color: var(--zt-ink);

    font-size: clamp(40px, 5.5vw, 66px);

    line-height: 0.98;

    font-weight: 600;

    letter-spacing: -0.05em;
  }


  #zeotein-comparison-{{ section.id }}
  .zt-comparison__intro {

    max-width: 610px;

    margin: 22px auto 0;

    color: var(--zt-muted);

    font-size: 16px;

    line-height: 1.65;
  }


  /* ==========================================================
     COMPARISON CARD
  ========================================================== */

  #zeotein-comparison-{{ section.id }}
  .zt-comparison__card {

    overflow: hidden;

    background: #ffffff;

    border: 1px solid rgba(81, 53, 125, 0.13);

    border-radius: 28px;

