    --zt-ink: #242228;
    --zt-muted: #706D76;
    --zt-line: rgba(45, 38, 57, 0.11);
    --zt-soft: #F7F5F9;

    background: var(--zt-cream);

    padding: 58px 24px 56px;
  }


  #zeotein-comparison-{{ section.id }} * {
    box-sizing: border-box;
  }


  /* ==========================================================
     CONTAINER
  ========================================================== */

