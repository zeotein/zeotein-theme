    },

    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Post-Workout Image"
    },

    {
      "type": "text",
      "id": "alt_2",
      "label": "Post-Workout Image Alt Text",
      "default": "Woman holding Zeotein after a workout"
    },

    {
      "type": "text",
      "id": "title_2",
      "label": "Post-Workout Title",
      "default": "Post-Workout"
    },

    {
      "type": "textarea",
      "id": "text_2",
      "label": "Post-Workout Description",
      "default": "A simple protein option when your workout is done."
    },


    {
      "type": "header",
      "content": "03 — Travel Day"
    },

    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Travel Image"
    },

    {
      "type": "text",
      "id": "alt_3",
      "label": "Travel Image Alt Text",
      "default": "Zeotein packed for a travel day"
    },

    {
      "type": "text",
      "id": "title_3",
      "label": "Travel Title",
      "default": "Travel Day"
    },

    {
      "type": "textarea",
      "id": "text_3",
      "label": "Travel Description",
      "default": "Keep your routine simple, even when you're away from home."
    },


    {
      "type": "header",
      "content": "04 — Afternoon Protein"
    },

    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Afternoon Image"
    },

    {
      "type": "text",
      "id": "alt_4",
      "label": "Afternoon Image Alt Text",
      "default": "Zeotein protein drink enjoyed at home in the afternoon"
    },

    {
      "type": "text",
      "id": "title_4",
      "label": "Afternoon Title",
      "default": "Afternoon Protein"
    },

    {
      "type": "textarea",
      "id": "text_4",
      "label": "Afternoon Description",
      "default": "A convenient addition when you want more protein during the day."
    },


    {
      "type": "header",
      "content": "Section CTA"
    },

    {
      "type": "text",
      "id": "cta_text",
