{% liquid
  assign breakfast_image = block.settings.image_1
  assign workout_image = block.settings.image_2
  assign travel_image = block.settings.image_3
  assign afternoon_image = block.settings.image_4
%}

<section id="zt-real-life-{{ block.id }}" class="zt-real-life" {{ block.shopify_attributes }}>
  <div class="zt-real-life__inner">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="zt-real-life__header">

      {% if block.settings.eyebrow != blank %}
        <div class="zt-real-life__eyebrow">
          {{ block.settings.eyebrow }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="zt-real-life__heading">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.intro != blank %}
        <p class="zt-real-life__intro">
          {{ block.settings.intro }}
        </p>
      {% endif %}

    </header>


    <!-- =====================================================
         ROUTINE GRID
    ====================================================== -->

    <div class="zt-real-life__grid">

      <!-- 01 — BREAKFAST -->

      <article class="zt-real-life__card">

        <div class="zt-real-life__image">

          {% if breakfast_image != blank %}

            {{
              breakfast_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400,700,1000,1400',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: block.settings.alt_1
            }}

          {% else %}

            <div class="zt-real-life__placeholder">
              ADD BREAKFAST IMAGE
            </div>

          {% endif %}

        </div>

        <div class="zt-real-life__copy">

          <div class="zt-real-life__meta">
            <span>01</span>
            <span>BREAKFAST</span>
          </div>

          <h3>
            {{ block.settings.title_1 }}
          </h3>

          <p>
            {{ block.settings.text_1 }}
          </p>

        </div>

      </article>


      <!-- 02 — POST-WORKOUT -->

      <article class="zt-real-life__card">

        <div class="zt-real-life__image">

          {% if workout_image != blank %}

            {{
              workout_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400,700,1000,1400',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: block.settings.alt_2
            }}

          {% else %}

            <div class="zt-real-life__placeholder">
              ADD POST-WORKOUT IMAGE
            </div>

          {% endif %}

        </div>

        <div class="zt-real-life__copy">

          <div class="zt-real-life__meta">
            <span>02</span>
            <span>POST-WORKOUT</span>
          </div>

          <h3>
            {{ block.settings.title_2 }}
          </h3>

          <p>
            {{ block.settings.text_2 }}
          </p>

        </div>

      </article>


      <!-- 03 — TRAVEL DAY -->

      <article class="zt-real-life__card">

        <div class="zt-real-life__image">

          {% if travel_image != blank %}

            {{
              travel_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400,700,1000,1400',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: block.settings.alt_3
            }}

          {% else %}

            <div class="zt-real-life__placeholder">
              ADD TRAVEL IMAGE
            </div>

          {% endif %}

        </div>

        <div class="zt-real-life__copy">

          <div class="zt-real-life__meta">
            <span>03</span>
            <span>TRAVEL DAY</span>
          </div>

          <h3>
            {{ block.settings.title_3 }}
          </h3>

          <p>
            {{ block.settings.text_3 }}
          </p>

        </div>

      </article>


      <!-- 04 — AFTERNOON PROTEIN -->

      <article class="zt-real-life__card zt-real-life__card--featured">

        <div class="zt-real-life__image">

          {% if afternoon_image != blank %}

            {{
              afternoon_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400,700,1000,1400',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: block.settings.alt_4
            }}

          {% else %}

            <div class="zt-real-life__placeholder">
              ADD AFTERNOON IMAGE
            </div>

          {% endif %}

        </div>

        <div class="zt-real-life__copy">

          <div class="zt-real-life__meta">
            <span>04</span>
            <span>AFTERNOON PROTEIN</span>
          </div>

          <h3>
            {{ block.settings.title_4 }}
          </h3>

          <p>
            {{ block.settings.text_4 }}
          </p>

        </div>

      </article>

    </div>


    <!-- =====================================================
         CTA
         URL / SCROLL BEHAVIOR PRESERVED
    ====================================================== -->

    {% if block.settings.cta_text != blank %}

      <div class="zt-real-life__cta">

        <a
          href="{{ block.settings.cta_url | default: '/collections/protein-blends' }}"
          data-zeotein-final-cta
        >
          <span>{{ block.settings.cta_text }}</span>
          <span aria-hidden="true">→</span>
        </a>

      </div>

    {% endif %}

  </div>
</section>


<style>

  /* ==========================================================
     ZEOTEIN — MADE FOR REAL LIFE
  ========================================================== */

  #zt-real-life-{{ block.id }} {

    --purple: #6F4AA8;
    --purple-dark: #56338B;
    --lavender: #EEE9F7;
    --cream: #F7F4EF;
    --ink: #17151B;
    --muted: #68626D;
    --border: rgba(23,21,27,.11);

    background: var(--cream);

    padding: 64px 24px 58px;

    overflow: hidden;
  }


  /* ==========================================================
     CONTAINER
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__inner {

    width: 100%;

    max-width: 1240px;

    margin: 0 auto;
  }


  /* ==========================================================
     HEADER
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__header {

    max-width: 720px;

    margin: 0 auto 30px;

    text-align: center;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__eyebrow {

    margin-bottom: 10px;

    color: var(--purple);

    font-size: 9px;

    line-height: 1.2;

    letter-spacing: .16em;

    text-transform: uppercase;

    font-weight: 700;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__heading {

    margin: 0 !important;

    padding: 0 !important;

    color: var(--ink) !important;

    font-size: clamp(34px, 4.2vw, 52px) !important;

    line-height: 1 !important;

    letter-spacing: -.045em !important;

    font-weight: 600 !important;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__intro {

    max-width: 560px;

    margin: 13px auto 0 !important;

    padding: 0 !important;

    color: var(--muted) !important;

    font-size: 13px !important;

    line-height: 1.55 !important;
  }


  /* ==========================================================
     GRID
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__grid {

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 12px;
  }


  /* ==========================================================
     CARDS
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__card {

    min-width: 0;

    overflow: hidden;

    border: 1px solid var(--border);

    border-radius: 15px;

    background: #fff;

    transition:
      transform .25s ease,
      box-shadow .25s ease;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__card--featured {

    background: var(--lavender);
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__card:hover {

    transform: translateY(-3px);

    box-shadow:
      0 12px 28px rgba(23,21,27,.08);
  }


  /* ==========================================================
     IMAGE
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__image {

    position: relative;

    width: 100%;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: #dedad4;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__image img {

    display: block !important;

    width: 100% !important;

    height: 100% !important;

    max-width: none !important;

    object-fit: cover !important;

    object-position: center center !important;

    transition: transform .5s ease;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__card:hover
  .zt-real-life__image img {

    transform: scale(1.025);
  }


  /* ==========================================================
     CARD CONTENT
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__copy {

    padding: 15px 16px 17px;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__meta {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 8px;

    padding-bottom: 9px;

    border-bottom: 1px solid var(--border);

    color: var(--purple);

    font-size: 9px;

    line-height: 1.2;

    letter-spacing: .16em;

    text-transform: uppercase;

    font-weight: 700;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__meta span:first-child {

    opacity: .7;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__copy h3 {

    margin: 11px 0 0 !important;

    padding: 0 !important;

    color: var(--ink) !important;

    font-size: 20px !important;

    line-height: 1.05 !important;

    letter-spacing: -.025em !important;

    font-weight: 600 !important;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__copy p {

    margin: 7px 0 0 !important;

    padding: 0 !important;

    color: var(--muted) !important;

    font-size: 10.5px !important;

    line-height: 1.45 !important;
  }


  /* ==========================================================
     PLACEHOLDER
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__placeholder {

    width: 100%;

    height: 100%;

    min-height: 160px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #716c74;

    background: #dedad4;

    font-size: 8px;

    letter-spacing: .13em;

    text-transform: uppercase;

    font-weight: 700;
  }


  /* ==========================================================
     CTA
     PURPLE PRIMARY
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__cta {

    display: flex;

    justify-content: center;

    margin-top: 25px;
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__cta a {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    min-height: 48px;

    padding: 0 25px;

    border: 1px solid #6F4AA8;

    border-radius: 999px;

    background: #6F4AA8;

    color: #FFFFFF !important;

    text-decoration: none !important;

    font-size: 9px;

    line-height: 1;

    letter-spacing: .11em;

    text-transform: uppercase;

    font-weight: 700;

    box-shadow:
      0 7px 18px rgba(111,74,168,.16);

    transition:
      background-color .25s ease,
      color .25s ease,
      border-color .25s ease,
      transform .25s ease,
      box-shadow .25s ease;
  }


  /* ==========================================================
     CTA HOVER
     WHITE BACKGROUND + PURPLE TEXT
  ========================================================== */

  #zt-real-life-{{ block.id }}
  .zt-real-life__cta a:hover {

    background: #FFFFFF;

    color: #6F4AA8 !important;

    border-color: #FFFFFF;

    transform: translateY(-2px);

    box-shadow:
      0 10px 24px rgba(111,74,168,.14);
  }


  #zt-real-life-{{ block.id }}
  .zt-real-life__cta a span:last-child {

    font-size: 16px;

    letter-spacing: 0;
  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media screen and (max-width: 749px) {

    #zt-real-life-{{ block.id }} {

      padding: 50px 16px 38px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__header {

      margin-bottom: 23px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__heading {

      font-size: 34px !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__intro {

      max-width: 430px;

      margin-top: 11px !important;

      font-size: 12px !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__grid {

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 9px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__card {

      border-radius: 12px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__image {

      aspect-ratio: 1 / 1.02;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__copy {

      padding: 11px 12px 13px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__meta {

      font-size: 7px;

      padding-bottom: 7px;

      letter-spacing: .13em;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__copy h3 {

      margin-top: 8px !important;

      font-size: 17px !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__copy p {

      margin-top: 5px !important;

      font-size: 9.5px !important;

      line-height: 1.4 !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__cta {

      margin-top: 20px;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__cta a {

      min-height: 46px;

      padding: 0 22px;
    }

  }


  /* ==========================================================
     SMALL PHONES
  ========================================================== */

  @media screen and (max-width: 390px) {

    #zt-real-life-{{ block.id }}
    .zt-real-life__heading {

      font-size: 31px !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__copy h3 {

      font-size: 15px !important;
    }


    #zt-real-life-{{ block.id }}
    .zt-real-life__copy p {

      font-size: 9px !important;
    }

  }

</style>


<!-- ==========================================================
     CTA SCROLL BEHAVIOR
     URL / DESTINATION PRESERVED
=========================================================== -->

<script>

  (function() {

    var root = document.getElementById(
      'zt-real-life-{{ block.id }}'
    );

    if (!root) return;


    var cta = root.querySelector(
      '[data-zt-scroll-disabled]'
    );

    if (!cta) return;


    cta.addEventListener('click', function(event) {

      var target = document.querySelector(
        '[id^="zeotein-final-product-cta-"]'
      );

      if (!target) return;


      event.preventDefault();


      target.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });


      if (history.replaceState) {

        history.replaceState(
          null,
          '',
          '#' + target.id
        );

      }

    });

  })();

</script>


{% schema %}
{
  "name": "Made for Real Life",
  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MADE FOR REAL LIFE"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Routine. Wherever Life Takes You."
    },

    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "From the first sip of the morning to the middle of a busy day, Zeotein fits into routines that don't always go according to plan."
    },


    {
      "type": "header",
      "content": "01 — Breakfast"
    },

    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Breakfast Image"
    },

    {
