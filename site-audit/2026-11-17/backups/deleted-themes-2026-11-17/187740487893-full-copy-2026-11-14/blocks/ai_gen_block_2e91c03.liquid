{% style %}

@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@400;500;600;700&display=swap');

.bonus-offer{
  background:#2A1242;
  padding:50px 20px;
}

.bonus-offer__wrap{
  max-width:980px;
  margin:0 auto;
  background:#2A1242;
  border:2px solid #32BAC0;
  border-radius:24px;
  padding:45px 40px;
  text-align:center;
}

.bonus-pill{
  display:inline-block;
  background:#32BAC0;
  color:#fff;
  padding:10px 26px;
  border-radius:999px;
  font-family:'Poppins',sans-serif;
  font-size:15px;
  font-weight:700;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:20px;
}

.bonus-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:82px;
  line-height:.92;
  color:#fff;
  margin:0;
  letter-spacing:1px;
}

.bonus-title span{
  display:block;
  color:#32BAC0;
}

.bonus-image{
  margin:22px auto 18px;
  text-align:center;
}

.bonus-image img{
  display:inline-block;
  width:auto;
  max-width:100%;
  max-height:420px;
  height:auto;
  object-fit:contain;
}

.bonus-sub{
  margin:0 auto 20px;
  max-width:760px;
  font-family:'Poppins',sans-serif;
  font-size:26px;
  line-height:1.5;
  font-weight:400;
  color:#FFFFFF;
}

.bonus-sub strong{
  color:#32BAC0;
}

.bonus-heading{
  margin:10px 0 8px;
  font-family:'Poppins',sans-serif;
  font-size:28px;
  font-weight:700;
  color:#D8CCE8;
}

.bonus-heading strong{
  color:#32BAC0;
}

.bonus-included{
  margin:0 0 20px;
  font-family:'Bebas Neue',sans-serif;
  font-size:40px;
  color:#fff;
  letter-spacing:2px;
}

.bonus-list{
  max-width:560px;
  margin:0 auto 16px;
}

.bonus-item{
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
  font-family:'Poppins',sans-serif;
  font-size:22px;
  color:#fff;
  line-height:1.35;
}

.bonus-item svg{
  width:20px;
  height:20px;
  color:#32BAC0;
  flex-shrink:0;
}

.old-price{
  margin-left:auto;
  color:#A79AB8;
  text-decoration:line-through;
}

.free{
  margin-left:8px;
  color:#32BAC0;
  font-weight:700;
}.total-pill{
  display:inline-block;
  margin:12px 0 18px;
  background:#6E3AB7;
  color:#fff;
  padding:14px 30px;
  border-radius:999px;
  font-family:'Poppins',sans-serif;
  font-size:20px;
  font-weight:600;
  box-shadow:0 0 20px rgba(50,186,192,.25);
}

.total-pill .old-price{
  color:#D7C9EB;
  margin-left:6px;
}

.bonus-btn{
  display:inline-block;
  margin-top:8px;
  background:#32BAC0;
  color:#fff;
  text-decoration:none;
  font-family:'Poppins',sans-serif;
  font-size:24px;
  font-weight:700;
  padding:20px 60px;
  border-radius:18px;
  transition:.25s ease;
}

.bonus-btn:hover{
  background:#2AA7AD;
  transform:translateY(-2px);
}

@media (max-width:768px){

  .bonus-offer{
    padding:35px 18px;
  }

  .bonus-offer__wrap{
    padding:32px 20px;
  }

  .bonus-pill{
    font-size:13px;
    padding:8px 18px;
    margin-bottom:18px;
  }

  .bonus-title{
    font-size:56px;
  }

  .bonus-image{
    margin:18px auto 16px;
  }

  .bonus-image img{
    max-height:280px;
  }

  .bonus-sub{
    font-size:20px;
    line-height:1.45;
    margin-bottom:18px;
  }

  .bonus-heading{
    font-size:22px;
  }

  .bonus-included{
    font-size:28px;
    line-height:1.1;
    margin-bottom:16px;
  }

  .bonus-list{
    margin-bottom:14px;
  }

  .bonus-item{
    font-size:18px;
    margin-bottom:6px;
    gap:6px;
  }

  .bonus-item svg{
    width:18px;
    height:18px;
  }

  .total-pill{
    font-size:18px;
    padding:12px 20px;
    margin:10px 0 16px;
  }

  .bonus-btn{
    width:100%;
    font-size:18px;
    padding:18px;
  }

}

{% endstyle %}
<section class="bonus-offer">

  <div class="bonus-offer__wrap">

    <div class="bonus-pill">
      ⏳ TODAY ONLY
    </div>

    <h2 class="bonus-title">
      ORDER NOW & GET
      <span>$55 IN FREE BONUSES</span>
    </h2>

    {% if section.settings.image != blank %}
      <div class="bonus-image">
        <img
          src="{{ section.settings.image | image_url: width:900 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="900"
          height="{{ 900 | divided_by: section.settings.image.aspect_ratio | round }}">
      </div>
    {% endif %}

    <p class="bonus-sub">
      On top of your <strong>15% off</strong> – added automatically at checkout
    </p>

    <div class="bonus-heading">
      <strong>+</strong> SHAKER + 3 DIGITAL GUIDES – YOURS FREE
    </div>

    <div class="bonus-included">
      Included with your first 30-day subscription
    </div>

    <div class="bonus-list">

      <div class="bonus-item">
        ✔ Branded Zeotein Shaker
        <span class="old-price">$15.00</span>
        <span class="free">FREE</span>
      </div>

      <div class="bonus-item">
        ✔ Cacao Recipe Guide
        <span class="old-price">$14.00</span>
        <span class="free">FREE</span>
      </div>
            <div class="bonus-item">
        ✔ Vegan Recipe Guide
        <span class="old-price">$14.00</span>
        <span class="free">FREE</span>
      </div>

      <div class="bonus-item">
        ✔ Zeotein Starter Guide
        <span class="old-price">$12.00</span>
        <span class="free">FREE</span>
      </div>

    </div>

    <div class="total-pill">
      Total Bonus Value
      <span class="old-price">$55.00</span>
      <strong> FREE</strong>
    </div>

    <a class="bonus-btn" href="{{ section.settings.button_link }}">
      {{ section.settings.button_text }}
    </a>

  </div>

</section>
{% schema %}
{
  "name": "Bonus Offer",
  "tag": "section",
  "class": "bonus-offer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bonus Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CLAIM MY HOWIE DISCOUNT + FREE BONUSES"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Bonus Offer"
    }
  ]
}
{% endschema %}