{% # theme-check-disable ExcessiveSettingsCount %}
{% doc %}
  Category tab for Real Customers Cacao LP.
  Renders the tab button and its reviews. The section lays the buttons into one row.
{% enddoc %}

{%- liquid
  assign sid = 'zt-rc-' | append: section.id
  assign text_count = block.settings.text_count | default: 3 | plus: 0
  if text_count < 0
    assign text_count = 0
  elsif text_count > 6
    assign text_count = 6
  endif
  assign tab_label = block.settings.label | default: 'Tab'
-%}

<div class="zt-rc__item" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="zt-rc__tab"
    id="{{ sid }}-tab-{{ block.id }}"
    role="tab"
    aria-selected="false"
    aria-controls="{{ sid }}-panel-{{ block.id }}"
    tabindex="-1"
    data-zt-rc-tab="{{ block.id }}"
  >
    {{ tab_label | escape }}
  </button>
  <div
    class="zt-rc__panel"
    id="{{ sid }}-panel-{{ block.id }}"
    role="tabpanel"
    aria-labelledby="{{ sid }}-tab-{{ block.id }}"
    data-zt-rc-panel="{{ block.id }}"
  >
{%- if text_count > 0 -%}
  <div class="zt-rc__text-grid">
    {%- for i in (1..6) -%}
      {%- if i <= text_count -%}
        {%- liquid
          assign t_key = 'text_' | append: i | append: '_title'
          assign b_key = 'text_' | append: i | append: '_body'
          assign n_key = 'text_' | append: i | append: '_name'
          assign s_key = 'text_' | append: i | append: '_stars'
          assign r_title = block.settings[t_key]
          assign r_body = block.settings[b_key]
          assign r_name = block.settings[n_key]
          assign r_stars = block.settings[s_key] | default: 5 | plus: 0
          if r_stars < 1
            assign r_stars = 1
          elsif r_stars > 5
            assign r_stars = 5
          endif
        -%}
        {%- if r_title != blank or r_body != blank or r_name != blank -%}
          <article class="zt-rc__review">
            <span class="zt-rc__review-stars" aria-hidden="true">
              {%- for s in (1..r_stars) -%}
                <svg viewBox="0 0 20 20" width="14" height="14" focusable="false">
                  <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.52L10 14.27 5.06 16.73 6 11.21l-4-3.9 5.53-.8L10 1.5z"/>
                </svg>
              {%- endfor -%}
            </span>
            {%- if r_title != blank -%}
              <h3 class="zt-rc__review-title">{{ r_title | escape }}</h3>
            {%- endif -%}
            {%- if r_body != blank -%}
              <p class="zt-rc__review-body">{{ r_body | escape }}</p>
            {%- endif -%}
            {%- if r_name != blank -%}
              <p class="zt-rc__review-name">{{ r_name | escape }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
  </div>
</div>

{% schema %}
