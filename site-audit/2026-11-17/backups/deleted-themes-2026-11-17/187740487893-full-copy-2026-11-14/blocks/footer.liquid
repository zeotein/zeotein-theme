<section
  id="zeotein-email-capture-{{ section.id }}"
  class="zt-email-capture"
>
  <div class="zt-email-capture__inner">

    <div class="zt-email-capture__eyebrow">
      {{ section.settings.eyebrow | default: 'STAY IN THE LOOP' }}
    </div>

    <h2 class="zt-email-capture__heading">
      {{ section.settings.heading | default: 'Make Nutrition Simpler.' }}
    </h2>

    <p class="zt-email-capture__description">
      {{ section.settings.description | default: 'Get clean-label education, recipes, and Zeotein updates.' }}
    </p>


    {% if section.settings.ghl_form_url != blank %}

      <div class="zt-email-capture__form-wrapper">

        <iframe
          src="{{ section.settings.ghl_form_url }}"
          title="Zeotein email signup"
          class="zt-email-capture__ghl-frame"
          loading="lazy"
          frameborder="0"
          scrolling="no"
        ></iframe>

      </div>

    {% else %}

      <!-- Temporary visual fallback until the GHL form URL is added -->
      <div class="zt-email-capture__visual-form">

        <div class="zt-email-capture__input">
          <span>
            {{ section.settings.placeholder | default: 'Email Address' }}
          </span>
        </div>

        <div class="zt-email-capture__button">
          {{ section.settings.button_text | default: 'JOIN US' }}
        </div>

      </div>

    {% endif %}

  </div>
</section>


<style>
  #zeotein-email-capture-{{ section.id }} {
    width: 100%;
    background: #e9e3f6;
    box-sizing: border-box;
  }

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 66px 24px 62px;
    text-align: center;
    box-sizing: border-box;
  }


  /* EYEBROW */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__eyebrow {
    margin: 0 0 13px;
    color: #67459a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.3;
    text-transform: uppercase;
  }


  /* HEADING */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__heading {
    margin: 0;
    color: #4c2870;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }


  /* DESCRIPTION */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__description {
    max-width: 620px;
    margin: 15px auto 0;
    color: #6e6878;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
  }


  /* GHL WRAPPER */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__form-wrapper {
    width: 100%;
    max-width: 665px;
    height: 82px;
    margin: 27px auto 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  /*
    GHL forms are embedded in an iframe.
    The iframe itself is intentionally kept transparent-looking
    and contained within the compact signup area.
  */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__ghl-frame {
    display: block;
    width: 100%;
    height: 82px;
    border: 0;
    background: transparent;
  }


  /* VISUAL FALLBACK */

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__visual-form {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 12px;
    width: 100%;
    max-width: 665px;
    margin: 27px auto 0;
  }

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__input {
    display: flex;
    align-items: center;
    flex: 1;
    min-height: 57px;
    padding: 0 20px;
    border: 1px solid rgba(103, 69, 154, 0.28);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.86);
    color: #716b7c;
    font-size: 14px;
    text-align: left;
    box-sizing: border-box;
  }

  #zeotein-email-capture-{{ section.id }} .zt-email-capture__button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 142px;
    min-height: 57px;
    padding: 0 22px;
    border-radius: 12px;
    background: #4b216d;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__inner {
      padding: 54px 18px 52px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__heading {
      font-size: 36px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__description {
      font-size: 13px;
      margin-top: 12px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__form-wrapper {
      height: 150px;
      margin-top: 23px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__ghl-frame {
      height: 150px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__visual-form {
      flex-direction: column;
      gap: 10px;
      margin-top: 23px;
    }

    #zeotein-email-capture-{{ section.id }} .zt-email-capture__input,
    #zeotein-email-capture-{{ section.id }} .zt-email-capture__button {
      flex-basis: auto;
      width: 100%;
      min-height: 53px;
    }
  }
</style>


{% schema %}
{
  "name": "Zeotein Email Capture",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STAY IN THE LOOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make Nutrition Simpler."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get clean-label education, recipes, and Zeotein updates."
    },
    {
      "type": "text",
      "id": "ghl_form_url",
      "label": "GHL Form URL",
      "info": "Paste the GHL form embed URL here. Leave blank temporarily to show the visual placeholder."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "JOIN US"
    }
  ],
  "presets": [
    {
      "name": "Zeotein Email Capture"
    }
  ]
}
{% endschema %}