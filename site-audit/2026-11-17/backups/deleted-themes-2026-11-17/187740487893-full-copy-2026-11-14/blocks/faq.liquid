{% liquid
  assign section_id = 'zt-faq-' | append: block.id

  assign eyebrow = block.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'QUESTIONS, ANSWERED'
  endif

  assign heading = block.settings.heading
  if heading == blank
    assign heading = 'Good Questions. Straight Answers.'
  endif

  assign intro = block.settings.intro
  if intro == blank
    assign intro = 'Everything you need to know before making Zeotein part of your routine.'
  endif

  assign bottom_text = block.settings.bottom_text
  if bottom_text == blank
    assign bottom_text = 'Still have a question?'
  endif

  assign bottom_link_text = block.settings.bottom_link_text
  if bottom_link_text == blank
    assign bottom_link_text = 'Contact Zeotein'
  endif
%}

<section
  id="{{ section_id }}"
  class="zt-faq"
  aria-labelledby="{{ section_id }}-heading"
>
  <div class="zt-faq__container">

    <!-- HEADER -->
    <div class="zt-faq__header">
      <div class="zt-faq__eyebrow">
        {{ eyebrow }}
      </div>

      <h2
        id="{{ section_id }}-heading"
        class="zt-faq__heading"
      >
        {{ heading }}
      </h2>

      <p class="zt-faq__intro">
        {{ intro }}
      </p>
    </div>

    <!-- FAQ LIST -->
    <div class="zt-faq__list">

      <!-- FAQ 01 — WHAT IS ZEOTEIN? -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            What is Zeotein?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Zeotein is an all-in-one protein shake made to make everyday
            nutrition simpler. It brings protein and intentionally selected
            ingredients together in one easy daily format.
          </p>
        </div>
      </details>

      <!-- FAQ 02 — CACAO VS VEGAN -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            What's the difference between Cacao and Vegan?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Cacao provides 23g of protein from collagen peptides +
            grass-fed beef bone broth, with a rich cacao flavor.
            Vegan provides 20g of plant-based protein from organic hemp
            + pumpkin seed protein.
          </p>
        </div>
      </details>

      <!-- FAQ 03 — TASTE -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            What does Zeotein taste like?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            It has a creamy chocolate flavor.
          </p>
        </div>
      </details>

      <!-- FAQ 04 — HOW TO USE -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            How do I use Zeotein?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Mix one serving with 10–12 oz of cold water, milk, or your
            favorite milk alternative. Shake or blend until smooth.
            You can also add it to a smoothie.
          </p>
        </div>
      </details>

      <!-- FAQ 05 — ALLERGENS -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            What allergens are present?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Allergen information may vary by formula. Please review the
            ingredient list for the specific Zeotein formula you are
            considering.
          </p>
        </div>
      </details>

      <!-- FAQ 06 — SUBSCRIPTION -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            Can I change or cancel my subscription?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Yes. You can manage, skip, pause, swap, or cancel your
            subscription through the customer portal.
          </p>

          <a
            href="https://zeotein.com/a/subscriptions/login"
            class="zt-faq__answer-link"
          >
            <span>
              Manage My Subscription
            </span>

            <span
              class="zt-faq__answer-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      </details>

      <!-- FAQ 07 — SHIPPING + GUARANTEE -->
      <details class="zt-faq__item">
        <summary class="zt-faq__summary">
          <span class="zt-faq__question">
            What is your shipping and guarantee policy?
          </span>

          <span
            class="zt-faq__icon"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="zt-faq__answer">
          <p>
            Orders are generally processed within 1–2 business days,
            with standard U.S. shipping taking 2–5 business days after
            processing. Zeotein also offers a 30-day money-back guarantee
            on eligible first orders. The guarantee applies to one supply
            and starts from the date of delivery.
          </p>

          <a
            href="https://zeotein.com/pages/faqs"
            class="zt-faq__answer-link"
          >
            <span>
              View Full FAQ &amp; Guarantee Details
            </span>

            <span
              class="zt-faq__answer-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </div>
      </details>

    </div>

    <!-- CONTACT -->
    <div class="zt-faq__bottom">
      <div class="zt-faq__bottom-text">
        {{ bottom_text }}
      </div>

      <a
        href="mailto:hello@zeotein.com"
        class="zt-faq__bottom-link"
      >
        <span>
          {{ bottom_link_text }}
        </span>

        <span aria-hidden="true">
          →
        </span>
      </a>
    </div>

  </div>
</section>

<style>
  /* BASE */
  #{{ section_id }} {
    width: 100%;
    padding: 82px 24px 90px;
    background: #ffffff;
    color: #35164f;
  }

  #{{ section_id }} *,
  #{{ section_id }} *::before,
  #{{ section_id }} *::after {
    box-sizing: border-box;
  }

  #{{ section_id }} .zt-faq__container {
    width: min(980px, 100%);
    margin: 0 auto;
  }

  /* HEADER */
  #{{ section_id }} .zt-faq__header {
    max-width: 700px;
    margin: 0 auto 48px;
    text-align: center;
  }

  #{{ section_id }} .zt-faq__eyebrow {
    margin-bottom: 12px;
    color: #6f4aa8;
    font-size: 10px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  #{{ section_id }} .zt-faq__heading {
    margin: 0;
    color: #35164f;
    font-size: clamp(43px, 5vw, 61px);
    line-height: .98;
    font-weight: 400;
    letter-spacing: -.045em;
  }

  #{{ section_id }} .zt-faq__intro {
    max-width: 590px;
    margin: 18px auto 0;
    color: #625d68;
    font-size: 14px;
    line-height: 1.55;
  }

  /* FAQ LIST */
  #{{ section_id }} .zt-faq__list {
    border-top: 1px solid #ddd9e2;
  }

  #{{ section_id }} .zt-faq__item {
    margin: 0;
    border-bottom: 1px solid #ddd9e2;
  }

  /* CLICKABLE SUMMARY */
  #{{ section_id }} .zt-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 23px 5px;
    color: #47206b;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  #{{ section_id }} .zt-faq__summary::-webkit-details-marker {
    display: none;
  }

  #{{ section_id }} .zt-faq__summary::marker {
    display: none;
  }

  #{{ section_id }} .zt-faq__question {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* PLUS / MINUS ICON */
  #{{ section_id }} .zt-faq__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 29px;
    height: 29px;
    flex: 0 0 29px;
    border: 1px solid #8d75a8;
    border-radius: 50%;
    color: #6f4aa8;
    background: #ffffff;
    font-size: 17px;
    line-height: 1;
    font-weight: 400;
    transition:
      background-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  #{{ section_id }} .zt-faq__item[open]
  .zt-faq__icon {
    color: #ffffff;
    background: #6f4aa8;
    transform: none;
    font-size: 0;
  }

  #{{ section_id }} .zt-faq__item[open]
  .zt-faq__icon::after {
    content: "−";
    font-size: 17px;
    line-height: 1;
  }

  /* HOVER / FOCUS */
  #{{ section_id }} .zt-faq__summary:hover
  .zt-faq__icon {
    background: #efecf8;
  }

  #{{ section_id }} .zt-faq__item[open]
  .zt-faq__summary:hover
  .zt-faq__icon {
    color: #ffffff;
    background: #6f4aa8;
  }

  #{{ section_id }} .zt-faq__summary:focus-visible {
    outline: 2px solid #6f4aa8;
    outline-offset: -2px;
    border-radius: 4px;
  }

  /* ANSWER */
  #{{ section_id }} .zt-faq__answer {
    max-width: 790px;
    padding: 0 60px 27px 5px;
    color: #4d4855;
    font-size: 14px;
    line-height: 1.6;
  }

  #{{ section_id }} .zt-faq__answer p {
    margin: 0;
  }

  /* ANSWER LINKS */
  #{{ section_id }} .zt-faq__answer-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
    padding-bottom: 4px;
    border-bottom: 1px solid #6f4aa8;
    color: #6f4aa8;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    text-decoration: none;
    transition:
      opacity .2s ease,
      gap .2s ease;
  }

  #{{ section_id }} .zt-faq__answer-link:hover {
    opacity: .72;
    gap: 12px;
  }

  #{{ section_id }} .zt-faq__answer-arrow {
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
  }

  /* CONTACT STRIP */
  #{{ section_id }} .zt-faq__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 38px;
    padding: 21px 26px;
    border: 1px solid #ddd5eb;
    border-radius: 12px;
    background: #efecf8;
  }

  #{{ section_id }} .zt-faq__bottom-text {
    color: #4e4856;
    font-size: 13px;
    line-height: 1.4;
  }

  #{{ section_id }} .zt-faq__bottom-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #47206b;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  #{{ section_id }} .zt-faq__bottom-link span:last-child {
    font-size: 17px;
    line-height: 1;
    font-weight: 400;
  }

  #{{ section_id }} .zt-faq__bottom-link:hover {
    opacity: .72;
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding: 55px 16px 60px;
    }

    #{{ section_id }} .zt-faq__header {
      margin-bottom: 30px;
    }

    #{{ section_id }} .zt-faq__eyebrow {
      margin-bottom: 9px;
      font-size: 8px;
    }

    #{{ section_id }} .zt-faq__heading {
      font-size: 35px;
      line-height: 1;
    }

    #{{ section_id }} .zt-faq__intro {
      max-width: 340px;
      margin-top: 13px;
      font-size: 11.5px;
      line-height: 1.45;
    }

    #{{ section_id }} .zt-faq__summary {
      gap: 13px;
      padding: 18px 2px;
      font-size: 13px;
      line-height: 1.35;
    }

    #{{ section_id }} .zt-faq__icon {
      width: 27px;
      height: 27px;
      flex-basis: 27px;
      font-size: 16px;
    }

    #{{ section_id }} .zt-faq__item[open]
    .zt-faq__icon::after {
      font-size: 16px;
    }

    #{{ section_id }} .zt-faq__answer {
      padding: 0 34px 20px 2px;
      font-size: 11.5px;
      line-height: 1.55;
    }

    #{{ section_id }} .zt-faq__answer-link {
      margin-top: 12px;
      font-size: 10.5px;
    }

    #{{ section_id }} .zt-faq__answer-arrow {
      font-size: 14px;
    }

    #{{ section_id }} .zt-faq__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 9px;
      margin-top: 27px;
      padding: 17px 18px;
      border-radius: 11px;
    }

    #{{ section_id }} .zt-faq__bottom-text {
      font-size: 10.5px;
    }

    #{{ section_id }} .zt-faq__bottom-link {
      font-size: 10.5px;
    }
  }

  /* SMALL MOBILE */
  @media screen and (max-width: 390px) {
    #{{ section_id }} {
      padding: 50px 14px 55px;
    }

    #{{ section_id }} .zt-faq__heading {
      font-size: 33px;
    }

    #{{ section_id }} .zt-faq__summary {
      padding: 17px 1px;
      font-size: 12.5px;
    }

    #{{ section_id }} .zt-faq__answer {
      padding-right: 27px;
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Zeotein FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUESTIONS, ANSWERED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good Questions. Straight Answers."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Everything you need to know before making Zeotein part of your routine."
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "Still have a question?"
    },
    {
      "type": "text",
      "id": "bottom_link_text",
      "label": "Contact Link Text",
      "default": "Contact Zeotein"
    }
  ],
  "presets": [
    {
      "name": "Zeotein FAQ"
    }
  ]
}
{% endschema %}