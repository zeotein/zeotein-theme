{% doc %}
  Heading, rating, tabs, and review titles for Real Customers Cacao LP.
  Static typography block. Keeps each schema within Theme Check's 40-setting limit.
{% enddoc %}

{%- liquid
  assign sid = 'zt-rc-' | append: section.id
  assign ff = block.settings.font_family | default: 'manrope'
  assign font_custom = block.settings.custom_font
-%}
{% render 'cacao-lp-fonts',
  id: sid,
  font_family: ff,
  font_custom: font_custom,
  settings: block.settings,
  prefixes: 'heading,rating,tab,review_title,review_body,author'
%}

{% schema %}
{
  "name": "Typography",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font name",
      "options": [
        {
          "value": "manrope",
          "label": "Manrope (Figma)"
        },
        {
          "value": "theme_heading",
          "label": "Theme heading"
        },
        {
          "value": "theme_body",
          "label": "Theme body"
        },
        {
          "value": "system",
          "label": "System sans"
        },
        {
          "value": "custom",
          "label": "Custom font"
        }
      ],
      "default": "manrope"
    },
    {
      "type": "text",
      "id": "custom_font",
      "label": "Custom font name",
      "info": "CSS font-family, for example Georgia, serif. Used when Font name is Custom font.",
      "visible_if": "{{ block.settings.font_family == 'custom' }}"
