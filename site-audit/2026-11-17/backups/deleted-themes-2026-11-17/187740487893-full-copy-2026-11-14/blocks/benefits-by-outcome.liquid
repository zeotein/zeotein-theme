{% comment %}
  ZEOTEIN — BENEFITS + APPROACH
  FINAL MOBILE-FIRST VERSION

  IMPORTANT:
  This is a SHOPIFY THEME BLOCK.
  It intentionally uses block.id / block.settings.

  Dana feedback addressed:
  - Removed redundant "THE ZEOTEIN APPROACH" label from photo.
  - Kept "THE ZEOTEIN APPROACH" below the photo.
  - Benefits and Approach remain visually separated.
  - Mobile spacing tightened.
  - Cacao + Vegan choices remain clickable.
  - Visible copy is hardcoded so the section cannot render blank
    because of missing/mismatched saved setting values.
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<section
  id="zeotein-benefits-approach-{{ ai_gen_id }}"
  class="zt-benefits-final-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <!-- =========================================================
       BENEFITS
       ========================================================= -->

  <div class="zt-benefits-final__benefits">

    <div class="zt-benefits-final__benefits-inner">

      <!-- BENEFITS INTRO -->

      <div class="zt-benefits-final__intro">

        <span class="zt-benefits-final__eyebrow">
          WHY IT FITS YOUR ROUTINE
        </span>

        <h2>
          Nutrition That Fits Real Life.
        </h2>

        <p>
          Meaningful protein and purposeful ingredients, brought together in one simple daily format.
        </p>

        <div class="zt-benefits-final__statement">
          <span></span>
          <em>
            Less complexity. Better consistency.
          </em>
        </div>

      </div>


      <!-- BENEFIT OUTCOMES -->

      <div class="zt-benefits-final__outcomes">

        <!-- 01 -->

        <article class="zt-benefits-final__outcome">

          <span class="zt-benefits-final__number">
            01
          </span>

          <div>
            <h3>
              DAILY PROTEIN
            </h3>

            <p>
              Meaningful protein for everyday nutrition.
            </p>
          </div>

        </article>


        <!-- 02 -->

        <article class="zt-benefits-final__outcome">

          <span class="zt-benefits-final__number">
            02
          </span>

          <div>
            <h3>
              STEADY ROUTINE
            </h3>

            <p>
              A simple format that fits busy days.
            </p>
          </div>

        </article>


        <!-- 03 -->

        <article class="zt-benefits-final__outcome zt-benefits-final__outcome--highlight">

          <span class="zt-benefits-final__number">
            03
          </span>

          <div>
            <h3>
              INTENTIONAL INGREDIENTS
            </h3>

            <p>
              Purposeful ingredients. Nothing unnecessary.
            </p>
          </div>

          <span
            class="zt-benefits-final__spark"
            aria-hidden="true"
          >
            ✦
          </span>

        </article>


        <!-- 04 -->

        <article class="zt-benefits-final__outcome">

          <span class="zt-benefits-final__number">
            04
          </span>

          <div>
            <h3>
              EVERYDAY CONVENIENCE
            </h3>

            <p>
              Easy to add to the rhythm of real life.
            </p>
          </div>

        </article>

      </div>

    </div>

  </div>


  <!-- =========================================================
       THE ZEOTEIN APPROACH
       ========================================================= -->

  <div class="zt-benefits-final__approach">

    <div class="zt-benefits-final__approach-inner">

      <!-- APPROACH IMAGE -->

      <div class="zt-benefits-final__approach-image">

        {% if block.settings.approach_image != blank %}

          {{
            block.settings.approach_image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600, 1800',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'zt-benefits-final__approach-img',
              alt: block.settings.approach_image_alt | default: 'Zeotein lifestyle and product'
          }}

        {% else %}

          <div class="zt-benefits-final__image-placeholder">
            <span>
              ADD APPROACH IMAGE
            </span>
          </div>

        {% endif %}

      </div>


      <!-- APPROACH COPY -->

      <div class="zt-benefits-final__approach-copy">

        <span class="zt-benefits-final__eyebrow">
          THE ZEOTEIN APPROACH
        </span>

        <h3>
          Less complexity. More consistency.
        </h3>

        <p class="zt-benefits-final__approach-text">
          Zeotein brings protein and purposeful ingredients together in one simple daily format—so nutrition feels easier to keep up with.
        </p>


        <!-- FORMULA CHOICE -->

        <div class="zt-benefits-final__choose">

          <span class="zt-benefits-final__choose-label">
            CHOOSE YOUR FORMULA
          </span>


          <div class="zt-benefits-final__formula-grid">

            <!-- CACAO -->

            <a
              href="{{ block.settings.cacao_url | default: 'https://zeotein.com/products/zeotein-30-day-supply' }}"
              class="zt-benefits-final__formula-card"
              aria-label="Explore Zeotein Cacao"
            >

              <div class="zt-benefits-final__formula-top">

                <strong>
                  CACAO
                </strong>

                <span aria-hidden="true">
                  ↗
                </span>

              </div>

              <small>
                {{ block.settings.cacao_detail | default: 'Animal-based protein · 23g protein' }}
              </small>

              <span class="zt-benefits-final__formula-link">
                EXPLORE CACAO
                <b aria-hidden="true">→</b>
              </span>

            </a>


            <!-- VEGAN -->

            <a
              href="{{ block.settings.vegan_url | default: 'https://zeotein.com/products/zeotein-vegan-30-day-supply' }}"
              class="zt-benefits-final__formula-card zt-benefits-final__formula-card--vegan"
              aria-label="Explore Zeotein Vegan"
            >

              <div class="zt-benefits-final__formula-top">

                <strong>
                  VEGAN
                </strong>

                <span aria-hidden="true">
                  ↗
                </span>

              </div>

              <small>
                {{ block.settings.vegan_detail | default: 'Plant-based protein · 20g protein' }}
              </small>

              <span class="zt-benefits-final__formula-link">
                EXPLORE VEGAN
                <b aria-hidden="true">→</b>
              </span>

            </a>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================================================
     BASE
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }} {

    --zt-ink: #20202b;
    --zt-muted: #686673;

    --zt-purple: #8069b5;
    --zt-purple-dark: #56368b;

    --zt-lavender: #eee9fa;
    --zt-lavender-deep: #e5ddf2;

    --zt-cream: #f7f4ef;
    --zt-white: #ffffff;

    --zt-border: #d8d3dc;

    width: 100%;
    overflow: hidden;

    color: var(--zt-ink);
    background: var(--zt-cream);
  }


  .zt-benefits-final-{{ ai_gen_id }} *,
  .zt-benefits-final-{{ ai_gen_id }} *::before,
  .zt-benefits-final-{{ ai_gen_id }} *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     BENEFITS BACKGROUND
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__benefits {

    position: relative;

    background: var(--zt-lavender);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__benefits-inner {

    display: grid;

    grid-template-columns:
      minmax(300px, .78fr)
      minmax(0, 1.22fr);

    gap: 60px;

    width: min(1180px, calc(100% - 48px));

    margin: 0 auto;

    padding: 72px 0 70px;
  }


  /* =========================================================
     BENEFITS INTRO
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__intro {

    display: flex;

    flex-direction: column;

    justify-content: center;

    max-width: 500px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__eyebrow {

    display: block;

    margin-bottom: 14px;

    color: var(--zt-purple);

    font-size: 9px;

    line-height: 1.2;

    font-weight: 700;

    letter-spacing: .18em;

    text-transform: uppercase;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__intro h2 {

    max-width: 500px;

    margin: 0;

    color: var(--zt-ink);

    font-size: clamp(43px, 5vw, 62px);

    line-height: .98;

    letter-spacing: -.055em;

    font-weight: 700;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__intro > p {

    max-width: 460px;

    margin: 20px 0 0;

    color: var(--zt-muted);

    font-size: 14px;

    line-height: 1.55;
  }


  /* =========================================================
     STATEMENT
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__statement {

    display: flex;

    align-items: center;

    gap: 12px;

    max-width: 400px;

    margin-top: 30px;

    padding-top: 14px;

    border-top: 1px solid rgba(128,105,181,.28);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__statement > span {

    width: 27px;
    height: 2px;

    flex: 0 0 27px;

    background: var(--zt-purple);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__statement em {

    color: #393541;

    font-size: 14px;

    line-height: 1.4;
  }


  /* =========================================================
     OUTCOMES
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcomes {

    display: flex;

    flex-direction: column;

    border-top: 1px solid rgba(128,105,181,.25);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcome {

    position: relative;

    display: grid;

    grid-template-columns: 48px minmax(0, 1fr);

    align-items: center;

    min-height: 104px;

    padding: 19px 21px;

    border-bottom: 1px solid rgba(128,105,181,.25);

    background: transparent;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__number {

    align-self: start;

    padding-top: 3px;

    color: #8b7e9c;

    font-size: 9px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .14em;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcome h3 {

    margin: 0;

    color: var(--zt-ink);

    font-size: 18px;

    line-height: 1.12;

    letter-spacing: -.02em;

    font-weight: 700;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcome p {

    max-width: 510px;

    margin: 6px 0 0;

    color: var(--zt-muted);

    font-size: 12px;

    line-height: 1.45;
  }


  /* =========================================================
     HIGHLIGHT CARD
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcome--highlight {

    margin: 4px 0;

    border: 1px solid var(--zt-purple);

    border-radius: 15px;

    background: #ffffff;

    box-shadow:
      0 8px 24px rgba(86,54,139,.07);

    overflow: hidden;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__outcome--highlight::after {

    content: "";

    position: absolute;

    width: 190px;
    height: 190px;

    right: -85px;
    top: -80px;

    border: 1px solid rgba(128,105,181,.12);

    border-radius: 50%;

    box-shadow:
      0 0 0 28px rgba(128,105,181,.035),
      0 0 0 56px rgba(128,105,181,.025);

    pointer-events: none;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__spark {

    position: absolute;

    right: 19px;
    top: 18px;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 28px;
    height: 28px;

    border-radius: 50%;

    color: var(--zt-purple);

    background: var(--zt-lavender);

    font-size: 11px;

    z-index: 2;
  }


  /* =========================================================
     APPROACH SECTION
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach {

    padding: 68px 24px 74px;

    border-top: 8px solid var(--zt-cream);

    background: #ffffff;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-inner {

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    max-width: 1180px;

    margin: 0 auto;

    overflow: hidden;

    border: 1px solid #e1dce4;

    border-radius: 21px;

    background: #ffffff;

    box-shadow:
      0 16px 45px rgba(32,25,43,.055);
  }


  /* =========================================================
     APPROACH IMAGE
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-image {

    position: relative;

    min-height: 510px;

    overflow: hidden;

    background: #ece8e2;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-img {

    display: block;

    width: 100%;
    height: 100%;

    min-height: 510px;

    object-fit: cover;

    object-position: center;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__image-placeholder {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 100%;
    height: 100%;

    min-height: 510px;

    color: var(--zt-purple);

    background: #eee9f4;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: .16em;
  }


  /* =========================================================
     APPROACH COPY
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-copy {

    display: flex;

    flex-direction: column;

    justify-content: center;

    padding: 54px 52px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-copy
  .zt-benefits-final__eyebrow {

    margin-bottom: 13px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-copy h3 {

    max-width: 500px;

    margin: 0;

    color: var(--zt-ink);

    font-size: clamp(37px, 4.2vw, 56px);

    line-height: .99;

    letter-spacing: -.05em;

    font-weight: 700;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__approach-text {

    max-width: 500px;

    margin: 17px 0 0;

    color: var(--zt-muted);

    font-size: 14px;

    line-height: 1.55;
  }


  /* =========================================================
     FORMULA CHOICES
     ========================================================= */

  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__choose {

    margin-top: 29px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__choose-label {

    display: block;

    margin-bottom: 10px;

    color: #746681;

    font-size: 8px;

    font-weight: 700;

    letter-spacing: .18em;

    text-transform: uppercase;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-grid {

    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 9px;

    max-width: 540px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-card {

    position: relative;

    display: flex;

    flex-direction: column;

    min-height: 140px;

    padding: 16px;

    color: var(--zt-ink);

    text-decoration: none;

    border: 1px solid #d8d3dc;

    border-radius: 14px;

    background: #ffffff;

    transition:
      transform .2s ease,
      border-color .2s ease,
      box-shadow .2s ease;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-card:hover {

    transform: translateY(-2px);

    border-color: var(--zt-purple);

    box-shadow:
      0 8px 22px rgba(86,54,139,.08);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-card:focus-visible {

    outline: 2px solid var(--zt-purple);

    outline-offset: 3px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-card--vegan {

    background: var(--zt-lavender);
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-top {

    display: flex;

    align-items: center;

    justify-content: space-between;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-top strong {

    color: var(--zt-purple-dark);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: .15em;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-top > span {

    display: flex;

    align-items: center;
    justify-content: center;

    width: 23px;
    height: 23px;

    border: 1px solid #c9bfd5;

    border-radius: 50%;

    color: var(--zt-purple);

    background: rgba(255,255,255,.65);

    font-size: 11px;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-card small {

    display: block;

    margin-top: 9px;

    color: var(--zt-muted);

    font-size: 10px;

    line-height: 1.4;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-link {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-top: auto;

    padding-top: 13px;

    color: var(--zt-purple-dark);

    font-size: 7px;

    font-weight: 700;

    letter-spacing: .12em;
  }


  .zt-benefits-final-{{ ai_gen_id }}
  .zt-benefits-final__formula-link b {

    font-size: 13px;

    line-height: 1;

    font-weight: 400;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 989px) {

    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__benefits-inner {

      gap: 35px;

      width: min(100% - 36px, 800px);

      padding: 60px 0 58px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach {

      padding: 55px 18px 62px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-copy {

      padding: 40px 35px;
    }

  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    /* ---------------------------------------------
       BENEFITS
       --------------------------------------------- */

    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__benefits-inner {

      display: block;

      width: 100%;

      padding: 42px 15px 40px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__intro {

      max-width: none;

      text-align: center;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__eyebrow {

      margin-bottom: 9px;

      font-size: 7px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__intro h2 {

      max-width: 500px;

      margin: 0 auto;

      font-size: 35px;

      line-height: 1.01;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__intro > p {

      max-width: 340px;

      margin: 12px auto 0;

      font-size: 11px;

      line-height: 1.45;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__statement {

      justify-content: center;

      max-width: 320px;

      margin: 17px auto 0;

      padding-top: 11px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__statement em {

      font-size: 11px;
    }


    /* ---------------------------------------------
       OUTCOMES
       --------------------------------------------- */

    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__outcomes {

      margin-top: 22px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__outcome {

      grid-template-columns: 31px minmax(0, 1fr);

      min-height: 76px;

      padding: 13px 2px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__number {

      padding-top: 2px;

      font-size: 7px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__outcome h3 {

      font-size: 14px;

      line-height: 1.08;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__outcome p {

      margin-top: 4px;

      font-size: 9.5px;

      line-height: 1.35;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__outcome--highlight {

      margin: 2px -3px;

      padding-left: 7px;

      padding-right: 36px;

      border-radius: 12px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__spark {

      top: 12px;

      right: 9px;

      width: 21px;
      height: 21px;

      font-size: 8px;
    }


    /* ---------------------------------------------
       APPROACH
       --------------------------------------------- */

    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach {

      padding: 27px 11px 34px;

      border-top-width: 7px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-inner {

      display: flex;

      flex-direction: column;

      border-radius: 15px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-image {

      order: 1;

      min-height: 255px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-img {

      min-height: 255px;

      height: 255px;

      object-fit: cover;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__image-placeholder {

      min-height: 255px;

      height: 255px;
    }


    /* ---------------------------------------------
       APPROACH COPY
       --------------------------------------------- */

    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-copy {

      order: 2;

      padding: 25px 17px 23px;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-copy
    .zt-benefits-final__eyebrow {

      margin-bottom: 8px;

      text-align: left;
    }


    .zt-benefits-final-{{ ai_gen_id }}
    .zt-benefits-final__approach-copy h3 {

      font-size: 29px;

      line-height: 1.02;
    }


