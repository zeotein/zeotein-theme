    },
    {
      "type": "text",
      "id": "rating_score_font_custom",
      "label": "Custom font name",
      "info": "CSS font-family, for example Georgia, serif. The font must already load on the store.",
      "visible_if": "{{ block.settings.rating_score_font == 'custom' }}"
    },
    {
      "type": "select",
      "id": "rating_score_weight",
      "label": "Font weight",
