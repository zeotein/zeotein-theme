{% doc %}
  Per-element typography for Hero Banner Cacao LP.
  Rendered as a static theme block so settings do not count toward the section's 40-setting cap.
{% enddoc %}

{%- liquid
  assign sid = 'hbclp-' | append: section.id
-%}

{% render 'cacao-lp-fonts', id: sid, font_family: block.settings.font_family, settings: block.settings, prefixes: 'rating_score,rating_label,heading,benefit,subtext,cta_top' %}

{% schema %}
{
  "name": "Typography",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "font_family",
      "label": "Font name",
      "options": [
        {
          "value": "manrope",
          "label": "Manrope (Figma)"
        },
        {
          "value": "theme_heading",
          "label": "Theme heading"
        },
        {
          "value": "theme_body",
          "label": "Theme body"
        },
        {
          "value": "poppins",
          "label": "Theme body (Poppins alias)"
        },
        {
          "value": "system",
          "label": "System sans"
        },
        {
          "value": "custom",
          "label": "Custom font"
        }
      ],
      "default": "manrope"
    },
    {
      "type": "text",
      "id": "custom_font",
      "label": "Custom font name",
      "info": "CSS font-family, for example Georgia, serif. Used when Font name is Custom font.",
      "visible_if": "{{ block.settings.font_family == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Rating score"
    },
