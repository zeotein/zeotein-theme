{% doc %}
  Remaining hero typography: CTA line 2, risk-free text, formula, and price badge.
  Static typography block. Keeps each schema within Theme Check's 40-setting limit.
{% enddoc %}

{%- liquid
  assign sid = 'hbclp-' | append: section.id
  assign base = section.blocks | where: 'type', 'cacao-type-hero' | first
  assign ff = 'manrope'
  assign font_custom = ''
  if base != blank
    assign ff = base.settings.font_family | default: 'manrope'
    assign font_custom = base.settings.custom_font
  endif
-%}
{% render 'cacao-lp-fonts',
  id: sid,
  font_family: ff,
  font_custom: font_custom,
  emit_root: false,
  settings: block.settings,
  prefixes: 'cta_bottom,risk,formula_label,formula_text,badge_top,badge_pct'
%}

