    },
    {
      "type": "text",
      "id": "heading_font_custom",
      "label": "Heading custom font",
      "info": "CSS font-family, for example Georgia, serif. The font must already load on the store.",
      "visible_if": "{{ block.settings.heading_font == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
