{% comment %}
  ZEOTEIN DIFFERENCE
  Final version — redundant card pre-headings removed.
  Theme-block safe — NO nested blocks.
{% endcomment %}

<section
  id="zeotein-difference-{{ block.id }}"
  class="zt-difference"
  {{ block.shopify_attributes }}
>
  <div class="zt-difference__inner">

    <!-- HEADER -->
    <header class="zt-difference__header">

      {% if block.settings.eyebrow != blank %}
        <div class="zt-difference__eyebrow">
          {{ block.settings.eyebrow }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="zt-difference__heading">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.intro != blank %}
        <p class="zt-difference__intro">
          {{ block.settings.intro }}
        </p>
      {% endif %}

    </header>


    <!-- THREE DIFFERENCE CARDS -->
    <div class="zt-difference__cards">

      <!-- CARD 1 -->
      <article class="zt-difference-card">

        <div class="zt-difference-card__top">

          <span class="zt-difference-card__number">
            01
          </span>

          <div class="zt-difference-card__icon">

            {% if block.settings.card_1_icon != blank %}

              {{
                block.settings.card_1_icon
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 180',
                  sizes: '50px',
                  alt: block.settings.card_1_title
              }}

            {% else %}

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3.8v5.4"/>
                <path d="M12 14.8v5.4"/>
                <path d="M3.8 12h5.4"/>
                <path d="M14.8 12h5.4"/>
                <circle cx="12" cy="12" r="5.2"/>
                <path d="m9.8 12 1.5 1.5 3-3"/>
              </svg>

            {% endif %}

          </div>

        </div>


        <div class="zt-difference-card__content">

          <h3>
            {{ block.settings.card_1_title }}
          </h3>

          <p>
            {{ block.settings.card_1_text }}
          </p>

        </div>

        <span class="zt-difference-card__accent"></span>

      </article>


      <!-- CARD 2 -->
      <article class="zt-difference-card">

        <div class="zt-difference-card__top">

          <span class="zt-difference-card__number">
            02
          </span>

          <div class="zt-difference-card__icon">

            {% if block.settings.card_2_icon != blank %}

              {{
                block.settings.card_2_icon
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 180',
                  sizes: '50px',
                  alt: block.settings.card_2_title
              }}

            {% else %}

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 4.2c2.7 3.1 5.7 5.6 5.7 9.1a5.7 5.7 0 0 1-11.4 0c0-3.5 3-6 5.7-9.1Z"/>
                <path d="M9.1 14.1c.3 1.4 1.3 2.3 2.9 2.6"/>
                <path d="M8.8 7.9h6.4"/>
              </svg>

            {% endif %}

          </div>

        </div>


        <div class="zt-difference-card__content">

          <h3>
            {{ block.settings.card_2_title }}
          </h3>

          <p>
            {{ block.settings.card_2_text }}
          </p>

        </div>

        <span class="zt-difference-card__accent"></span>

      </article>


      <!-- CARD 3 / FEATURED -->
      <article class="zt-difference-card zt-difference-card--featured">

        <div class="zt-difference-card__top">

          <span class="zt-difference-card__number">
            03
          </span>

          <div class="zt-difference-card__icon">

            {% if block.settings.card_3_icon != blank %}

              {{
                block.settings.card_3_icon
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 180',
                  sizes: '50px',
                  alt: block.settings.card_3_title
              }}

            {% else %}

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="5" y="5.5" width="14" height="13.5" rx="2"/>
                <path d="M8 3.8v3.4"/>
                <path d="M16 3.8v3.4"/>
                <path d="M5 9.5h14"/>
                <path d="m9 14 1.8 1.8 4-4"/>
              </svg>

            {% endif %}

          </div>

        </div>


        <div class="zt-difference-card__content">

          <h3>
            {{ block.settings.card_3_title }}
          </h3>

          <p>
            {{ block.settings.card_3_text }}
          </p>

        </div>

        <span class="zt-difference-card__accent"></span>

      </article>

    </div>


    <!-- PURPLE PRODUCT STRIP -->
    <div class="zt-difference-proof">

      <div class="zt-difference-proof__content">

        {% if block.settings.proof_eyebrow != blank %}
          <div class="zt-difference-proof__eyebrow">
            {{ block.settings.proof_eyebrow }}
          </div>
        {% endif %}

        {% if block.settings.proof_heading != blank %}
          <h3>
            {{ block.settings.proof_heading }}
          </h3>
        {% endif %}

        {% if block.settings.proof_text != blank %}
          <p>
            {{ block.settings.proof_text }}
          </p>
        {% endif %}

      </div>


      {% if block.settings.proof_image != blank %}

        <div class="zt-difference-proof__image">

          {{
            block.settings.proof_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000',
              sizes: '(min-width: 990px) 35vw, 75vw',
              alt: block.settings.proof_image.alt | default: 'Zeotein product'
          }}

        </div>

      {% endif %}

    </div>

  </div>
</section>


<style>
  /* =========================================================
     ZEOTEIN DIFFERENCE — FINAL
     Redundant card pre-headings removed
  ========================================================= */

  #zeotein-difference-{{ block.id }} {
    --zt-ink: #11182b;
    --zt-muted: #697187;
    --zt-purple: #5f3091;
    --zt-purple-dark: #3b195d;
    --zt-lavender: #f0ecf8;
    --zt-lavender-deep: #e5dcf2;
    --zt-border: #d5dbe7;
    --zt-white: #ffffff;

    display: block;
    width: 100%;
    background: #f8f9fc;
    padding: 60px 20px 66px;
    box-sizing: border-box;
    color: var(--zt-ink);
  }

  #zeotein-difference-{{ block.id }} *,
  #zeotein-difference-{{ block.id }} *::before,
  #zeotein-difference-{{ block.id }} *::after {
    box-sizing: border-box;
  }

  #zeotein-difference-{{ block.id }} .zt-difference__inner {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  #zeotein-difference-{{ block.id }} .zt-difference__header {
    max-width: 850px;
    margin: 0 auto 34px;
    text-align: center;
  }

  #zeotein-difference-{{ block.id }} .zt-difference__eyebrow {
    margin: 0 0 9px;
    color: var(--zt-purple);
    font-size: 10px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  #zeotein-difference-{{ block.id }} .zt-difference__heading {
    margin: 0;
    color: var(--zt-ink);
    font-size: clamp(38px, 4.4vw, 54px);
    line-height: 1.02;
    letter-spacing: -.055em;
    font-weight: 700;
  }

  #zeotein-difference-{{ block.id }} .zt-difference__intro {
    max-width: 650px;
    margin: 13px auto 0;
    color: var(--zt-muted);
    font-size: 15px;
    line-height: 1.5;
  }


  /* =========================================================
     CARDS
  ========================================================= */

  #zeotein-difference-{{ block.id }} .zt-difference__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 16px;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card {
    position: relative;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    padding: 25px 27px 23px;
    overflow: hidden;

    background: #ffffff;
    border: 1px solid var(--zt-border);
    border-radius: 20px;

    box-shadow: 0 8px 24px rgba(26, 22, 42, .035);

    transition:
      transform .25s ease,
      box-shadow .25s ease,
      border-color .25s ease;
  }

  /* Thin editorial color cue */
  #zeotein-difference-{{ block.id }} .zt-difference-card::after {
    content: "";
    position: absolute;
    left: 27px;
    top: 0;
    width: 50px;
    height: 3px;
    background: #c6b4dc;
    border-radius: 0 0 4px 4px;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card:hover {
    transform: translateY(-5px);
    border-color: #b9adca;
    box-shadow: 0 18px 38px rgba(31, 24, 52, .09);
  }


  /* Featured third card */
  #zeotein-difference-{{ block.id }} .zt-difference-card--featured {
    min-height: 318px;
    background: var(--zt-lavender);
    border: 1px solid #6b3ca0;
    box-shadow: 0 12px 30px rgba(95, 48, 145, .09);
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card--featured::after {
    width: 74px;
    background: var(--zt-purple);
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card--featured::before {
    content: "";
    position: absolute;
    right: -55px;
    top: -68px;
    width: 190px;
    height: 190px;
    border: 1px solid rgba(95, 48, 145, .12);
    border-radius: 50%;
    box-shadow:
      0 0 0 27px rgba(95, 48, 145, .035),
      0 0 0 54px rgba(95, 48, 145, .022);
    pointer-events: none;
  }


  /* =========================================================
     CARD TOP / NUMBERS / ICONS
  ========================================================= */

  #zeotein-difference-{{ block.id }} .zt-difference-card__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card__number {
    display: block;
    color: #82738f;
    font-size: 12px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: .16em;
    padding-top: 6px;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card--featured
  .zt-difference-card__number {
    color: #ffffff;
    background: var(--zt-purple);
    padding: 7px 10px 6px;
    border-radius: 999px;
    letter-spacing: .13em;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card__icon {
    width: 56px;
    height: 56px;
    flex: 0 0 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--zt-purple);
    background: #faf9fc;
    border: 1px solid #cfc5df;
    border-radius: 50%;

    transition:
      transform .25s ease,
      background .25s ease,
      border-color .25s ease;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card:hover
  .zt-difference-card__icon {
    transform: scale(1.06) rotate(-2deg);
    background: #f1ecf7;
    border-color: #bcaed0;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card--featured
  .zt-difference-card__icon {
    background: var(--zt-lavender-deep);
    border-color: #b8a7d1;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card__icon img {
    width: 31px;
    height: 31px;
    display: block;
    object-fit: contain;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card__icon svg {
    width: 26px;
    height: 26px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* =========================================================
     CARD CONTENT
  ========================================================= */

  #zeotein-difference-{{ block.id }} .zt-difference-card__content {
    position: relative;
    z-index: 2;
    margin-top: 36px;
  }

  /* No redundant label/pre-heading here */

  #zeotein-difference-{{ block.id }} .zt-difference-card h3 {
    margin: 0;
    max-width: 300px;
    color: var(--zt-ink);
    font-size: 23px;
    line-height: 1.08;
    letter-spacing: -.035em;
    font-weight: 700;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card p {
    max-width: 320px;
    margin: 11px 0 0;
    color: var(--zt-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-card__accent {
    position: relative;
    z-index: 2;
    width: 46px;
    height: 2px;
    margin-top: auto;
    background: #8660b5;
  }


  /* =========================================================
     PRODUCT PROOF STRIP
  ========================================================= */

  #zeotein-difference-{{ block.id }} .zt-difference-proof {
    position: relative;
    margin-top: 22px;
    min-height: 195px;

    padding: 28px 38px;

    display: grid;
    grid-template-columns: 1fr .65fr;
    align-items: center;
    gap: 22px;

    overflow: hidden;
    border-radius: 18px;

    background: linear-gradient(
      110deg,
      #513384 0%,
      #4a2b78 55%,
      #3a175b 100%
    );
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof::after {
    content: "";
    position: absolute;
    width: 330px;
    height: 330px;
    right: 40px;
    top: -175px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 50%;
    box-shadow:
      0 0 0 38px rgba(255,255,255,.035),
      0 0 0 76px rgba(255,255,255,.025);
    pointer-events: none;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof__content {
    position: relative;
    z-index: 2;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof__eyebrow {
    margin-bottom: 7px;
    color: #d9c7f2;
    font-size: 9px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof h3 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(29px, 3.3vw, 40px);
    line-height: 1.05;
    letter-spacing: -.04em;
    font-weight: 700;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof p {
    max-width: 550px;
    margin: 10px 0 0;
    color: rgba(255,255,255,.78);
    font-size: 14px;
    line-height: 1.5;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof__image {
    position: relative;
    z-index: 2;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  #zeotein-difference-{{ block.id }} .zt-difference-proof__image img {
    display: block;
    width: min(100%, 330px);
    max-height: 185px;
    object-fit: contain;
    object-position: center right;
    filter: drop-shadow(0 18px 20px rgba(0,0,0,.18));
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 900px) {

    #zeotein-difference-{{ block.id }} {
      padding: 48px 18px 56px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__header {
      margin-bottom: 28px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card {
      padding: 23px;
      min-height: 285px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card--featured {
      min-height: 300px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    #zeotein-difference-{{ block.id }} {
      padding: 38px 14px 44px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__header {
      margin-bottom: 20px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__eyebrow {
      margin-bottom: 7px;
      font-size: 9px;
      letter-spacing: .2em;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__heading {
      font-size: 32px;
      line-height: 1.05;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__intro {
      margin-top: 10px;
      font-size: 13px;
      line-height: 1.45;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__cards {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card,
    #zeotein-difference-{{ block.id }} .zt-difference-card--featured {
      min-height: 0;
      padding: 19px 18px 20px;
      border-radius: 17px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card::after {
      left: 18px;
      width: 40px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card--featured::after {
      width: 58px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__number {
      font-size: 10px;
      padding-top: 6px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__icon {
      width: 48px;
      height: 48px;
      flex-basis: 48px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__icon svg {
      width: 23px;
      height: 23px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__icon img {
      width: 28px;
      height: 28px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__content {
      margin-top: 22px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card h3 {
      max-width: 300px;
      font-size: 21px;
      line-height: 1.08;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card p {
      margin-top: 8px;
      max-width: none;
      font-size: 12.5px;
      line-height: 1.48;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__accent {
      margin-top: 17px;
      width: 38px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof {
      margin-top: 16px;
      min-height: 0;
      padding: 24px 18px 18px;
      grid-template-columns: 1fr;
      gap: 8px;
      border-radius: 16px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof__eyebrow {
      margin-bottom: 6px;
      font-size: 8px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof h3 {
      font-size: 28px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof p {
      margin-top: 8px;
      font-size: 12.5px;
      line-height: 1.48;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof__image {
      min-height: 125px;
      justify-content: center;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof__image img {
      width: 72%;
      max-height: 150px;
      object-position: center;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 360px) {

    #zeotein-difference-{{ block.id }} {
      padding: 34px 12px 40px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__header {
      margin-bottom: 18px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__heading {
      font-size: 29px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__intro {
      font-size: 11.5px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference__cards {
      gap: 9px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card {
      padding: 18px 16px 19px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card__content {
      margin-top: 20px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card h3 {
      font-size: 19px;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-card p {
      font-size: 11px;
      line-height: 1.42;
    }

    #zeotein-difference-{{ block.id }} .zt-difference-proof {
      margin-top: 14px;
      padding: 22px 16px 16px;
    }

  }
</style>


{% schema %}
{
  "name": "Zeotein Difference",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE ZEOTEIN DIFFERENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than Protein. Made Simple."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Thoughtfully combined nutrition, without the complicated routine."
    },

    {
      "type": "header",
      "content": "Card 1 — Functional Nutrition"
    },
    {
      "type": "image_picker",
      "id": "card_1_icon",
      "label": "Card 1 Icon"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Card 1 Title",
      "default": "Functional Nutrition"
    },
    {
      "type": "textarea",
      "id": "card_1_text",
      "label": "Card 1 Description",
      "default": "Meaningful protein and functional ingredients designed for everyday nutrition."
    },

    {
      "type": "header",
      "content": "Card 2 — Intentional Ingredients"
    },
    {
      "type": "image_picker",
      "id": "card_2_icon",
      "label": "Card 2 Icon"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Card 2 Title",
      "default": "Intentional Ingredients"
    },
    {
      "type": "textarea",
      "id": "card_2_text",
      "label": "Card 2 Description",
      "default": "A short, purposeful formula. Nothing added just to make the label longer."
    },

    {
      "type": "header",
      "content": "Card 3 — Easy Daily Routine"
    },
    {
      "type": "image_picker",
      "id": "card_3_icon",
      "label": "Card 3 Icon"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Card 3 Title",
      "default": "Easy Daily Routine"
    },
    {
      "type": "textarea",
      "id": "card_3_text",
      "label": "Card 3 Description",
      "default": "One simple format designed to fit naturally into your day."
    },

    {
      "type": "header",
      "content": "Purple Product Strip"
    },
    {
      "type": "text",
      "id": "proof_eyebrow",
      "label": "Strip Eyebrow",
      "default": "SIX INTENTIONAL INGREDIENTS"
    },
    {
      "type": "text",
      "id": "proof_heading",
      "label": "Strip Heading",
      "default": "One simple routine."
    },
    {
