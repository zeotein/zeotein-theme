{% doc %}
  Heading, body, cells, and row labels for Us vs Them Cacao LP.
  Static typography block. Keeps each schema within Theme Check's 40-setting limit.
{% enddoc %}

{%- liquid
  assign sid = 'zt-uvt-' | append: section.id
  assign ff = block.settings.font_family | default: 'manrope'
  assign font_custom = block.settings.custom_font
-%}
{% render 'cacao-lp-fonts',
  id: sid,
  font_family: ff,
  font_custom: font_custom,
  settings: block.settings,
  prefixes: 'heading,body,cell,label,feat_title,feat_sub'
%}

{% schema %}
