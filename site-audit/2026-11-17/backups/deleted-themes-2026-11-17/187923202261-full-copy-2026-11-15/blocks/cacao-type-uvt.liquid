    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font name",
      "options": [
        {
          "value": "manrope",
          "label": "Manrope (Figma)"
        },
        {
          "value": "theme_heading",
          "label": "Theme heading"
        },
        {
          "value": "theme_body",
          "label": "Theme body"
        },
        {
          "value": "system",
          "label": "System sans"
        },
        {
          "value": "custom",
          "label": "Custom font"
        }
      ],
      "default": "manrope"
    },
    {
      "type": "text",
      "id": "custom_font",
      "label": "Custom font name",
