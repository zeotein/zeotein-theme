{% doc %}
  Column titles, comparison labels, accent values, and the footnote for Us vs Them Cacao LP.
  Static typography block. Keeps each schema within Theme Check's 40-setting limit.
{% enddoc %}

{%- liquid
  assign sid = 'zt-uvt-' | append: section.id
  assign base = section.blocks | where: 'type', 'cacao-type-uvt' | first
  assign ff = 'manrope'
  assign font_custom = ''
  if base != blank
    assign ff = base.settings.font_family | default: 'manrope'
    assign font_custom = base.settings.custom_font
  endif
-%}
{% render 'cacao-lp-fonts',
  id: sid,
  font_family: ff,
  font_custom: font_custom,
  emit_root: false,
  settings: block.settings,
  prefixes: 'comp_label,accent_value,note'
%}

{% schema %}
{
  "name": "Typography, continued",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Comp Label"
    },
    {
      "type": "select",
      "id": "comp_label_font",
      "label": "Font name",
      "options": [
        {
          "value": "inherit",
          "label": "Same as section"
        },
        {
          "value": "manrope",
          "label": "Manrope"
        },
        {
          "value": "theme_heading",
          "label": "Theme heading"
        },
        {
          "value": "theme_body",
          "label": "Theme body"
        },
        {
          "value": "system",
          "label": "System sans"
        },
        {
          "value": "custom",
          "label": "Custom font"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "text",
      "id": "comp_label_font_custom",
      "label": "Custom font name",
      "info": "CSS font-family, for example Georgia, serif. The font must already load on the store.",
      "visible_if": "{{ block.settings.comp_label_font == 'custom' }}"
    },
    {
      "type": "select",
      "id": "comp_label_weight",
      "label": "Font weight",
