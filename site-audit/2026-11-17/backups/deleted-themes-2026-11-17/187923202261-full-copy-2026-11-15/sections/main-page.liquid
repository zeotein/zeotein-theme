<section
  id="AboutWhy-{{ section.id }}"
  class="zeotein-about-story"
  aria-labelledby="AboutWhyHeading-{{ section.id }}"
>
  <div class="zeotein-about-story__inner page-width">

    <div class="zeotein-about-story__intro">

      <div class="zeotein-about-story__eyebrow">
        WHY ZEOTEIN EXISTS
      </div>

      <h2
        id="AboutWhyHeading-{{ section.id }}"
        class="zeotein-about-story__heading"
      >
        There's a volcanic mineral in this protein shake.
      </h2>

      <div class="zeotein-about-story__intro-text">
        That's not an accident. It's part of the story behind the name Zeotein.
      </div>

    </div>

    <div class="zeotein-about-story__grid">

      <div class="zeotein-about-story__visual">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'zeotein-about-story__image',
              widths: '500, 700, 900, 1200, 1400',
              sizes: '(min-width: 990px) 42vw, 100vw',
              alt: section.settings.image_alt,
              loading: 'lazy'
          }}
        {%- else -%}
          <div class="zeotein-about-story__image-placeholder">
            <span>Zeotein</span>
          </div>
        {%- endif -%}
      </div>

      <div class="zeotein-about-story__content">

        <h3>
          Start with the strange part
        </h3>

        <div class="zeotein-about-story__copy">
          <p>
            <strong>Zeolite.</strong> Clinoptilolite, specifically. It's a naturally occurring volcanic mineral with a porous crystalline structure. It's a food-grade ingredient and the mineral Zeotein was named after. It's included in every Zeotein formula.
          </p>
        </div>

        <h3>
          Everything else had to earn its place.
        </h3>

        <div class="zeotein-about-story__copy">
          <p>
            Once zeolite was part of the formula, the same intentional approach applied to everything else. Each ingredient had to have a reason to be there.
          </p>

          <p>
            <strong>Six made it into Cacao. Five into Vegan.</strong> Protein, organic MCT, organic sea moss, and other intentionally selected ingredients come together in simple daily formulas.
          </p>
        </div>

        <div class="zeotein-about-story__formula-note">

          <!-- Cacao -->
          <div class="zeotein-about-story__formula-item">
            <div class="zeotein-about-story__icon" aria-hidden="true">
              <svg
                viewBox="0 0 32 32"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M10 5H22"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
                <path
                  d="M13 5V10L8 23.5C7.4 25.1 8.6 27 10.3 27H21.7C23.4 27 24.6 25.1 24 23.5L19 10V5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M10 20H22"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div class="zeotein-about-story__formula-content">
              <strong>6 INGREDIENTS</strong>
              <p>Cacao</p>
            </div>
          </div>

          <!-- Vegan -->
          <div class="zeotein-about-story__formula-item">
            <div class="zeotein-about-story__icon" aria-hidden="true">
              <svg
                viewBox="0 0 32 32"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M25.5 6.5C17.2 6.8 10.2 9.4 7.1 15.1C4.7 19.5 6.1 24.2 6.8 25.5C8.1 25.2 12.7 24.7 16.8 21.3C21.5 17.4 23.8 12.1 25.5 6.5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M7 25C10.3 19.8 14.7 15.8 20.4 12.4"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div class="zeotein-about-story__formula-content">
              <strong>5 INGREDIENTS</strong>
              <p>Vegan</p>
            </div>
          </div>

        </div>

        <div class="zeotein-about-story__copy zeotein-about-story__closing">
          <p>
            That's the idea behind Zeotein: keep the formula intentional, keep the label clear, and make the daily routine easier to manage.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #AboutWhy-{{ section.id }} {
    background: #f7f5f1;
    color: #21162f;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__inner {
    padding-top: 88px;
    padding-bottom: 96px;
  }

  /* Intro */

  #AboutWhy-{{ section.id }} .zeotein-about-story__intro {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__eyebrow {
    margin-bottom: 14px;
    color: #5f2d91;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__heading {
    margin: 0;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: #21162f;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__intro-text {
    max-width: 620px;
    margin: 20px auto 0;
    font-size: 17px;
    line-height: 1.55;
    color: #5d5665;
  }

  /* Main content */

  #AboutWhy-{{ section.id }} .zeotein-about-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 72px;
    align-items: center;
  }

  /* Image */

  #AboutWhy-{{ section.id }} .zeotein-about-story__visual {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: #ebe6df;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    background: #eae5df;
    color: #5f2d91;
    font-size: 22px;
    font-weight: 700;
  }

  /* Copy */

  #AboutWhy-{{ section.id }} .zeotein-about-story__content {
    max-width: 650px;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__content h3 {
    margin: 0 0 14px;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #21162f;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__content h3:not(:first-child) {
    margin-top: 38px;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__copy {
    font-size: 16px;
    line-height: 1.65;
    color: #5d5665;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__copy p {
    margin: 0 0 18px;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__copy p:last-child {
    margin-bottom: 0;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__copy strong {
    color: #21162f;
    font-weight: 700;
  }

  /* Formula cards */

  #AboutWhy-{{ section.id }} .zeotein-about-story__formula-note {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 32px;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__formula-item {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 18px;
    border: 1px solid rgba(95, 45, 145, 0.18);
    border-radius: 16px;
    background: #f0ebf8;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__icon {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffffff;
    color: #5f2d91;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__icon svg {
    display: block;
    width: 21px;
    height: 21px;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__formula-content {
    min-width: 0;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__formula-item strong {
    display: block;
    margin-bottom: 4px;
    color: #21162f;
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    font-weight: 700;
  }

  #AboutWhy-{{ section.id }} .zeotein-about-story__formula-item p {
    margin: 0;
    color: #6a6372;
    font-size: 13px;
    line-height: 1.45;
  }

  /* Closing */

  #AboutWhy-{{ section.id }} .zeotein-about-story__closing {
    margin-top: 30px;
    font-weight: 500;
    color: #40384a;
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    #AboutWhy-{{ section.id }} .zeotein-about-story__grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__visual {
      max-width: 720px;
      margin: 0 auto;
      width: 100%;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__content {
      max-width: 720px;
      margin: 0 auto;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #AboutWhy-{{ section.id }} .zeotein-about-story__inner {
      padding-top: 58px;
      padding-bottom: 64px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__intro {
      margin-bottom: 38px;
      text-align: left;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__eyebrow {
      margin-bottom: 10px;
      font-size: 10px;
      letter-spacing: 0.15em;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__heading {
      font-size: clamp(34px, 10vw, 46px);
      line-height: 1;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__intro-text {
      margin-top: 16px;
      font-size: 15px;
      line-height: 1.55;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__grid {
      gap: 32px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__visual {
      border-radius: 18px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__image {
      aspect-ratio: 4 / 3;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__content h3 {
      font-size: 22px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__copy {
      font-size: 15px;
      line-height: 1.6;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__formula-note {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 26px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__formula-item {
      padding: 16px;
    }

    #AboutWhy-{{ section.id }} .zeotein-about-story__icon {
      flex-basis: 36px;
      width: 36px;
      height: 36px;
    }
  }
</style>

{% schema %}
{
  "name": "About - Why Zeotein",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Zeotein Cacao protein powder"
    }
  ],
  "presets": [
    {
      "name": "About - Why Zeotein"
    }
  ]
}
{% endschema %}