{%- liquid
  assign sid = 'zt-ss-' | append: section.id
  assign cta_href = section.settings.cta_link | default: '#purchase'
  assign heading = section.settings.heading
  assign accent = section.settings.accent_text
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'heading,body,cta'
%}

{{ 'start-strong-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-ss"
  {{ section.shopify_attributes }}
  style="
    --zt-ss-bg: {{ section.settings.bg_color }};
    --zt-ss-text: {{ section.settings.text_color }};
    --zt-ss-accent: {{ section.settings.accent_color }};
    --zt-ss-cta-bg: {{ section.settings.cta_bg_color }};
    --zt-ss-cta-text: {{ section.settings.cta_text_color }};
    --zt-ss-confetti-1: {{ section.settings.confetti_color_1 }};
    --zt-ss-confetti-2: {{ section.settings.confetti_color_2 }};
    --zt-ss-confetti-3: {{ section.settings.confetti_color_3 }};
    --zt-ss-max-width: {{ section.settings.content_width | default: 1180 }}px;
    --zt-ss-pad-top: {{ section.settings.padding_top }}px;
    --zt-ss-pad-bottom: {{ section.settings.padding_bottom }}px;
    --zt-ss-badge-top: {{ section.settings.badge_top }}%;
    --zt-ss-badge-left: {{ section.settings.badge_left }}%;
    --zt-ss-badge-top-m: {{ section.settings.badge_top_mobile }}%;
    --zt-ss-badge-left-m: {{ section.settings.badge_left_mobile }}%;
    --zt-ss-badge-rotate: {{ section.settings.badge_rotate }}deg;
  "
>
  {%- if section.settings.show_confetti -%}
    <div class="zt-ss__confetti" aria-hidden="true">
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
      <span class="zt-ss__dot"></span>
    </div>
  {%- endif -%}

  <div class="zt-ss__inner">
    <div class="zt-ss__copy">
      {%- if heading != blank -%}
        <h2 class="zt-ss__heading">
          {%- liquid
            assign heading_safe = heading | escape
            if accent != blank
              assign accent_safe = accent | escape
              assign accent_html = '<span class="zt-ss__accent">' | append: accent_safe | append: '</span>'
              assign heading_safe = heading_safe | replace: accent_safe, accent_html
            endif
          -%}
          {{ heading_safe }}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="zt-ss__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="zt-ss__cta" href="{{ cta_href }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <svg class="zt-ss__cta-arrow" viewBox="0 0 16 16" width="16" height="16" focusable="false" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="zt-ss__media">
      {%- if section.settings.show_badge -%}
        <div class="zt-ss__badge">
          {%- if section.settings.badge_image != blank -%}
            {{
              section.settings.badge_image
              | image_url: width: 400
              | image_tag:
                class: 'zt-ss__badge-img',
                loading: 'lazy',
                widths: '120, 200, 300, 400',
                sizes: '(max-width: 989px) 42vw, 150px',
                alt: section.settings.badge_label
            }}
          {%- else -%}
            <div class="zt-ss__badge-fallback">
              {%- if section.settings.badge_label != blank -%}
                <p class="zt-ss__badge-ring">{{ section.settings.badge_label | escape }}</p>
              {%- endif -%}
              {%- if section.settings.badge_center != blank -%}
                <p class="zt-ss__badge-center">{{ section.settings.badge_center | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.product_image != blank -%}
        {%- assign product_alt = section.settings.product_image.alt | default: section.settings.heading -%}
        {{
          section.settings.product_image
          | image_url: width: 900
          | image_tag:
            class: 'zt-ss__product',
            loading: 'lazy',
            widths: '280, 400, 600, 900',
            sizes: '(max-width: 989px) 82vw, min(420px, 40vw)',
            alt: product_alt
        }}
      {%- else -%}
        <div class="zt-ss__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'zt-ss__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    if (window.ztSsCtaScroll) return;
    window.ztSsCtaScroll = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.zt-ss__cta');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;

      var target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      if (href === '#purchase' && typeof window.ztScrollToCacaoOffer === 'function') {
        window.ztScrollToCacaoOffer({ frameKey: 'ztSsCtaFrame' });
        return;
      }

      var start = window.scrollY || window.pageYOffset;
      var margin = parseFloat(window.getComputedStyle(target).scrollMarginTop) || 0;
      var end = target.getBoundingClientRect().top + start - margin;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.ztSsCtaFrame) {
        window.cancelAnimationFrame(window.ztSsCtaFrame);
        window.ztSsCtaFrame = 0;
      }

      if (reduce || Math.abs(end - start) < 2) {
        window.scrollTo(0, end);
        if (window.history.replaceState) window.history.replaceState(null, '', window.location.pathname + window.location.search);
        return;
      }

      var duration = 1300;
      var startTime = null;

      function ease(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function finish(cancelled) {
        window.removeEventListener('wheel', cancel);
        window.removeEventListener('touchstart', cancel);
        window.ztSsCtaFrame = 0;
        if (!cancelled && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function cancel() {
        if (window.ztSsCtaFrame) window.cancelAnimationFrame(window.ztSsCtaFrame);
        finish(true);
      }

      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + (end - start) * ease(progress));
        if (progress < 1) {
          window.ztSsCtaFrame = window.requestAnimationFrame(step);
        } else {
          finish(false);
        }
      }

      window.addEventListener('wheel', cancel, { passive: true });
      window.addEventListener('touchstart', cancel, { passive: true });
      window.ztSsCtaFrame = window.requestAnimationFrame(step);
    });
  })();
</script>

