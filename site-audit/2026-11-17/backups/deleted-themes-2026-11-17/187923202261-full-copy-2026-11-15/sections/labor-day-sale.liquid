{% assign cacao_bulk = all_products['zeotein-cacao-30-day-bulk-powder'] %}
{% assign cacao_sticks = all_products['zeotein-30-day-supply'] %}
{% assign vegan_sticks = all_products['zeotein-vegan-30-day-supply'] %}

<style>
  /* =========================================================
     ZEOTEIN LABOR DAY SALE
     ONLY STYLES CONTENT INSIDE THIS SECTION
     ========================================================= */

  .zeo-labor {
    --zeo-purple: #1B0B30;
    --zeo-purple-2: #241238;
    --zeo-teal: #2EC9C9;
    --zeo-white: #FFFFFF;
    --zeo-light: #F8F6FA;
    --zeo-text: #1B0B30;
    --zeo-muted: #746B7B;
    --zeo-border: #E5DFE9;

    width: 100%;
    overflow: hidden;
    background: #FFFFFF;
    color: var(--zeo-text);
    font-family: "Poppins", sans-serif;
  }

  .zeo-labor *,
  .zeo-labor *::before,
  .zeo-labor *::after {
    box-sizing: border-box;
  }

  .zeo-labor img {
    display: block;
    max-width: 100%;
  }

  .zeo-labor h1,
  .zeo-labor h2,
  .zeo-labor h3 {
    margin: 0;
    font-family: "Bebas Neue", "Arial Narrow", sans-serif !important;
    font-weight: 400 !important;
    letter-spacing: 0.01em;
  }

  .zeo-labor p {
    margin-top: 0;
  }

  .zeo-container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  /* =========================================================
     HERO
     ========================================================= */

  .zeo-hero {
    padding: 64px 0;
    color: #FFFFFF;

    background:
      radial-gradient(
        circle at 90% 20%,
        rgba(46, 201, 201, 0.13),
        transparent 38%
      ),
      var(--zeo-purple);
  }

  .zeo-hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.95fr;
    gap: 56px;
    align-items: center;
  }

  .zeo-hero h1 {
    max-width: 650px;
    margin-bottom: 24px;
    color: #FFFFFF !important;
    font-size: clamp(58px, 5.5vw, 86px);
    line-height: 0.95;
  }

  .zeo-hero-copy {
    max-width: 650px;
    margin-bottom: 20px;
    color: #FFFFFF;
    font-size: 18px;
    line-height: 1.6;
  }

  .zeo-deadline {
    margin-bottom: 28px !important;
    color: #FFFFFF;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 700;
  }

  .zeo-hero-image {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zeo-hero-image img {
    width: 100%;
    max-width: 560px;
    height: auto;
  }

  /* =========================================================
     BUTTONS
     ========================================================= */

  .zeo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 220px;
    min-height: 56px;
    padding: 16px 32px;

    background: var(--zeo-teal);
    color: #FFFFFF !important;

    border: 0;
    border-radius: 5px;

    text-decoration: none !important;

    font-size: 16px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .zeo-button:hover {
    color: #FFFFFF !important;
    opacity: 0.92;
    transform: translateY(-2px);
  }

  /* =========================================================
     GENERAL CONTENT
     ========================================================= */

  .zeo-section {
    padding: 52px 0;
  }

  .zeo-section-light {
    background: var(--zeo-light);
  }

  .zeo-section h2 {
    margin-bottom: 18px;
    color: var(--zeo-purple) !important;
    font-size: clamp(46px, 4.6vw, 66px);
    line-height: 0.98;
  }

  .zeo-body {
    max-width: 850px;
    color: var(--zeo-text);
    font-size: 18px;
    line-height: 1.65;
  }

  .zeo-fine {
    max-width: 920px;
    margin-top: 18px;
    color: var(--zeo-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  /* =========================================================
     PRODUCT GRID
     ========================================================= */

  .zeo-products-section {
    padding: 48px 0 54px;
    background: var(--zeo-light);
  }

  .zeo-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .zeo-product {
    display: flex;
    flex-direction: column;
    overflow: hidden;

    background: #FFFFFF;
    color: var(--zeo-text);
    text-decoration: none !important;

    border: 1px solid var(--zeo-border);
    border-radius: 18px;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .zeo-product:hover {
    color: var(--zeo-text);
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(27, 11, 48, 0.1);
  }

  .zeo-product-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #F6F2F8;
  }

  .zeo-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zeo-product-content {
    padding: 18px 20px 20px;
    text-align: center;
  }

  .zeo-product-name {
    margin-bottom: 6px;
    color: var(--zeo-purple);
    font-size: 17px;
    line-height: 1.35;
    font-weight: 700;
  }

  .zeo-product-note {
    color: var(--zeo-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  /* =========================================================
     VEGAN COMPARISON
     ========================================================= */

  .zeo-compare-wrap {
    margin-top: 28px;
    overflow-x: auto;
    border-radius: 14px;
  }

  .zeo-compare {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
    background: #FFFFFF;
  }

  .zeo-compare th,
  .zeo-compare td {
    padding: 17px 20px;
    vertical-align: middle;
    text-align: left;
    border-bottom: 1px solid var(--zeo-border);
  }

  .zeo-compare thead th {
    color: #FFFFFF;
    background: var(--zeo-purple);
    font-size: 16px;
    font-weight: 700;
  }

  .zeo-compare thead th:first-child {
    border-top-left-radius: 14px;
  }

  .zeo-compare thead th:last-child {
    border-top-right-radius: 14px;
  }

  .zeo-compare tbody th {
    width: 22%;
    color: var(--zeo-purple);
    font-size: 15px;
    font-weight: 700;
  }

  .zeo-compare tbody td {
    color: var(--zeo-text);
    font-size: 15px;
    line-height: 1.45;
  }

  .zeo-note {
    margin: 20px 0 0;
    color: var(--zeo-text);
    font-size: 15px;
    line-height: 1.55;
    font-style: italic;
  }

  /* =========================================================
     FAQ
     ========================================================= */

  .zeo-faq {
    max-width: 930px;
    margin-top: 14px;
  }

  .zeo-faq details {
    border-bottom: 1px solid var(--zeo-border);
  }

  .zeo-faq summary {
    position: relative;

    padding: 18px 42px 18px 0;

    color: var(--zeo-purple);
    cursor: pointer;
    list-style: none;

    font-size: 17px;
    line-height: 1.4;
    font-weight: 700;
  }

  .zeo-faq summary::-webkit-details-marker {
    display: none;
  }

  .zeo-faq summary::after {
    content: "+";

    position: absolute;
    top: 50%;
    right: 4px;

    color: var(--zeo-teal);
    font-size: 27px;
    font-weight: 700;
    line-height: 1;

    transform: translateY(-50%);
  }

  .zeo-faq details[open] summary::after {
    content: "−";
  }

  .zeo-faq p {
    max-width: 820px;
    margin: 0;
    padding: 0 40px 19px 0;

    color: var(--zeo-text);

    font-size: 15px;
    line-height: 1.65;
  }

  .zeo-faq a {
    color: #169EA4;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* =========================================================
     FINAL CTA
     Reduced spacing so it flows into footer cleanly
     ========================================================= */

  .zeo-final {
    padding: 46px 0 48px;
    color: #FFFFFF;
    text-align: center;

    background:
      radial-gradient(
        circle at 50% 100%,
        rgba(46, 201, 201, 0.07),
        transparent 45%
      ),
      var(--zeo-purple);
  }

  .zeo-final-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .zeo-final h2 {
    max-width: 950px;
    margin: 0 auto 24px;

    color: #FFFFFF !important;

    font-size: clamp(46px, 5vw, 68px);
    line-height: 0.98;
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (max-width: 990px) {
    .zeo-container {
      width: min(100% - 36px, 1180px);
    }

    .zeo-hero {
      padding: 52px 0;
    }

    .zeo-hero-grid {
      grid-template-columns: 1fr 0.9fr;
      gap: 34px;
    }

    .zeo-hero h1 {
      font-size: clamp(50px, 7vw, 72px);
    }

    .zeo-hero-copy {
      font-size: 16px;
    }

    .zeo-products {
      gap: 18px;
    }

    .zeo-product-name {
      font-size: 15px;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {
    .zeo-container {
      width: min(100% - 30px, 1180px);
    }

    .zeo-hero {
      padding: 34px 0 40px;
    }

    .zeo-hero-grid {
      display: flex;
      flex-direction: column;
      gap: 26px;
    }

    .zeo-hero-content {
      order: 1;
      text-align: center;
    }

    .zeo-hero-image {
      order: 0;
    }

    .zeo-hero-image img {
      width: 100%;
      max-width: 440px;
    }

    .zeo-hero h1 {
      margin-bottom: 18px;
      font-size: clamp(44px, 14vw, 62px);
      line-height: 0.95;
    }

    .zeo-hero-copy {
      margin: 0 auto 16px;
      font-size: 15px;
      line-height: 1.55;
    }

    .zeo-deadline {
      margin-bottom: 22px !important;
      font-size: 14px;
    }

    .zeo-section {
      padding: 38px 0;
    }

    .zeo-section h2 {
      margin-bottom: 16px;
      font-size: clamp(40px, 12vw, 54px);
    }

    .zeo-body {
      font-size: 16px;
      line-height: 1.6;
    }

    .zeo-fine {
      margin-top: 16px;
      font-size: 12px;
    }

    .zeo-products-section {
      padding: 36px 0 40px;
    }

    .zeo-products {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .zeo-product {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
    }

    .zeo-product-image {
      aspect-ratio: 16 / 10;
    }

    .zeo-product-content {
      padding: 16px 16px 18px;
    }

    .zeo-product-name {
      font-size: 16px;
    }

    .zeo-compare-wrap {
      margin-top: 20px;
    }

    .zeo-compare th,
    .zeo-compare td {
      padding: 14px 15px;
    }

    .zeo-note {
      margin-top: 16px;
      font-size: 14px;
    }

    .zeo-faq {
      margin-top: 10px;
    }

    .zeo-faq summary {
      padding-top: 16px;
      padding-bottom: 16px;
      font-size: 16px;
    }

    .zeo-faq p {
      font-size: 14px;
    }

    .zeo-final {
      padding: 38px 0 42px;
    }

    .zeo-final h2 {
      margin-bottom: 22px;
      font-size: clamp(42px, 12vw, 56px);
    }

    .zeo-button {
      width: 100%;
      max-width: 360px;
      min-height: 54px;
    }
  }
</style>


<div class="zeo-labor">

  <!-- HERO -->
  <section class="zeo-hero">
    <div class="zeo-container zeo-hero-grid">

      <div class="zeo-hero-content">
        <h1>
          Buy one 30-Day, get a second 50% off.
        </h1>

        <p class="zeo-hero-copy">
          Mix any two 30-day supplies. Free shipping. No code — the discount comes off automatically at checkout.
        </p>

        <p class="zeo-deadline">
          Ends Monday, September 7 at 11:59 PM CT.
        </p>

        <a class="zeo-button" href="#labor-products">
          SHOP THE SALE
        </a>
      </div>


      <div class="zeo-hero-image">
        {% if cacao_bulk.featured_image %}
          {{
            cacao_bulk.featured_image
            | image_url: width: 1000
            | image_tag:
              loading: 'eager',
              alt: 'Zeotein Cacao 30-Day Bulk Bag'
          }}
        {% endif %}
      </div>

    </div>
  </section>


  <!-- MIX ANY TWO -->
  <section class="zeo-section">
    <div class="zeo-container">

      <h2>
        Mix any two.
      </h2>

      <div class="zeo-body">
        Cacao, Vegan, bulk bag, stick packs — choose any two qualifying 30-day supplies.
        The lower-priced item is 50% off, and shipping is free.
      </div>

      <div class="zeo-fine">
        One-time purchases only. Subscription orders are not included.
        Discount applies to the lower-priced of the two qualifying 30-day items,
        one discounted item per order. Does not combine with other codes.
      </div>

    </div>
  </section>


  <!-- PRODUCTS -->
  <section class="zeo-products-section" id="labor-products">
    <div class="zeo-container">

      <div class="zeo-products">

        <!-- CACAO BULK -->
        <a
          class="zeo-product"
          href="{{ cacao_bulk.url | default: '/products/zeotein-cacao-30-day-bulk-powder' }}"
        >
          <div class="zeo-product-image">
            {% if cacao_bulk.featured_image %}
              {{
                cacao_bulk.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: 'Zeotein Cacao 30-Day Bulk Bag'
              }}
            {% endif %}
          </div>

          <div class="zeo-product-content">
            <div class="zeo-product-name">
              Cacao — 30-Day Bulk Bag
            </div>

            <div class="zeo-product-note">
              Choose one-time purchase for the Labor Day offer.
            </div>
          </div>
        </a>


        <!-- CACAO STICKS -->
        <a
          class="zeo-product"
          href="{{ cacao_sticks.url | default: '/products/zeotein-30-day-supply' }}"
        >
          <div class="zeo-product-image">
            {% if cacao_sticks.featured_image %}
              {{
                cacao_sticks.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: 'Zeotein Cacao 30-Day Stick Packs'
              }}
            {% endif %}
          </div>

          <div class="zeo-product-content">
            <div class="zeo-product-name">
              Cacao — 30-Day Stick Packs
            </div>

            <div class="zeo-product-note">
              Choose one-time purchase for the Labor Day offer.
            </div>
          </div>
        </a>


        <!-- VEGAN STICKS -->
        <a
          class="zeo-product"
          href="{{ vegan_sticks.url | default: '/products/zeotein-vegan-30-day-supply' }}"
        >
          <div class="zeo-product-image">
            {% if vegan_sticks.featured_image %}
              {{
                vegan_sticks.featured_image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: 'Zeotein Vegan 30-Day Stick Packs'
              }}
            {% endif %}
          </div>

          <div class="zeo-product-content">
            <div class="zeo-product-name">
              Vegan — 30-Day Stick Packs
            </div>

            <div class="zeo-product-note">
              Choose one-time purchase for the Labor Day offer.
            </div>
          </div>
        </a>

      </div>

    </div>
  </section>


  <!-- CACAO VS VEGAN -->
  <section class="zeo-section">
    <div class="zeo-container">

      <h2>
        The Vegan is in it too.
      </h2>

      <div class="zeo-body">
        If you've only had the Cacao and wondered about the plant-based Vegan,
        this is an easy time to try both.
      </div>


      <div class="zeo-compare-wrap">
        <table class="zeo-compare">

          <thead>
            <tr>
              <th></th>
              <th>Cacao</th>
              <th>Vegan</th>
            </tr>
          </thead>

          <tbody>

            <tr>
              <th>Protein</th>
              <td>23g per serving</td>
              <td>20g per serving</td>
            </tr>

            <tr>
              <th>Base</th>
              <td>Collagen + Bone Broth</td>
              <td>Pumpkin Seed Protein + Hemp Protein</td>
            </tr>

            <tr>
              <th>Also in it</th>
              <td>Cacao, MCT, Zeolite, Sea Moss</td>
              <td>MCT, Zeolite, Sea Moss</td>
            </tr>

            <tr>
              <th>Ingredients</th>
              <td>6</td>
              <td>5</td>
            </tr>

            <tr>
              <th>Format</th>
              <td>Bulk bag or stick packs</td>
              <td>Stick packs</td>
            </tr>

          </tbody>

        </table>
      </div>


      <p class="zeo-note">
        Both have no fillers, no gums, no artificial sweeteners, and no added sugar.
      </p>

    </div>
  </section>


  <!-- FAQ -->
  <section class="zeo-section zeo-section-light">
    <div class="zeo-container">

      <h2>
        Questions?
      </h2>

      <div class="zeo-faq">

        <details>
          <summary>
            Do I need a code?
          </summary>

          <p>
            No. Add two qualifying 30-day products to your cart and the Labor Day
            discount comes off automatically at checkout.
          </p>
        </details>


        <details>
          <summary>
            Which one gets discounted?
          </summary>

          <p>
            The lower-priced of the two qualifying 30-day products receives the
            50% discount. One discounted item per order.
          </p>
        </details>


        <details>
          <summary>
            Is shipping free?
          </summary>

          <p>
            Yes. Qualifying Labor Day sale orders receive free shipping.
          </p>
        </details>


        <details>
          <summary>
            I'm on a subscription. Can I use this?
          </summary>

          <p>
            Yes, but the Labor Day offer is for a separate one-time purchase.
            Your subscription order itself is not included in the promotion.

            <br><br>

            You can manage your existing subscription through the customer portal.

            <br><br>

            <a href="https://zeotein.com/a/subscriptions/login">
              Manage your subscription →
            </a>
          </p>
        </details>

      </div>

    </div>
  </section>


  <!-- FINAL CTA -->
  <section class="zeo-final">
    <div class="zeo-container zeo-final-inner">

      <h2>
        Four days. Then everything goes back to regular price.
      </h2>

      <a class="zeo-button" href="#labor-products">
        SHOP THE SALE
      </a>

    </div>
  </section>

</div>


{% schema %}
{
  "name": "Labor Day Sale",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Labor Day Sale"
    }
  ]
}
{% endschema %}