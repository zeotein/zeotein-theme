          "label": "400"
        },
        {
          "value": "500",
          "label": "500"
        },
        {
          "value": "600",
          "label": "600"
        },
        {
          "value": "700",
          "label": "700"
        },
        {
          "value": "800",
          "label": "800"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "subtext_size_desktop",
      "label": "Size - desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "subtext_size_mobile",
      "label": "Size - mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Feature title"
    },
    {
      "type": "select",
      "id": "feature_title_font",
      "label": "Font name",
      "options": [
        {
          "value": "inherit",
