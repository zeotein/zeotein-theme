{%- liquid
  assign sid = 'zt-cs-' | append: section.id
  assign cta_href = section.settings.cta_link | default: '#purchase'
  assign quote = section.settings.quote
  if quote != blank and section.settings.auto_quotes
    assign first = quote | slice: 0
    unless first == '“' or first == '"' or first == "'"
      assign quote = '“' | append: quote | append: '”'
    endunless
  endif
  assign image_ratio = section.settings.image_ratio | default: 'landscape'
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'quote,body,name,meta,cta,disclaimer'
%}

{{ 'customer-story-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-cs"
  {{ section.shopify_attributes }}
  style="
    --zt-cs-bg: {{ section.settings.bg_color }};
    --zt-cs-ink: {{ section.settings.ink_color }};
    --zt-cs-body: {{ section.settings.body_color }};
    --zt-cs-muted: {{ section.settings.muted_color }};
    --zt-cs-cta-bg: {{ section.settings.cta_bg_color }};
    --zt-cs-cta-text: {{ section.settings.cta_text_color }};
    --zt-cs-shadow: {{ section.settings.shadow_color }};
    --zt-cs-shadow-x: 8px;
    --zt-cs-shadow-y: 8px;
    --zt-cs-radius: {{ section.settings.image_radius }}px;
    --zt-cs-max-width: {{ section.settings.content_width | default: 1120 }}px;
    --zt-cs-pad-top: {{ section.settings.padding_top }}px;
    --zt-cs-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zt-cs__inner">
    <div class="zt-cs__media">
      <div class="zt-cs__frame zt-cs__frame--{{ image_ratio }}">
        {%- if section.settings.image != blank -%}
          {%- assign img_alt = section.settings.image.alt | default: section.settings.name -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'zt-cs__img',
              loading: 'lazy',
              widths: '400, 700, 1000, 1400',
              sizes: '(max-width: 989px) 100vw, 50vw',
              alt: img_alt
          }}
        {%- else -%}
          <div class="zt-cs__placeholder">
            {{ 'image' | placeholder_svg_tag: 'zt-cs__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="zt-cs__copy">
      {%- if quote != blank -%}
        <h2 class="zt-cs__quote">{{ quote | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="zt-cs__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.settings.name != blank or section.settings.meta != blank -%}
        <div class="zt-cs__person">
          {%- if section.settings.name != blank -%}
            <p class="zt-cs__name">{{ section.settings.name | escape }}</p>
          {%- endif -%}
          {%- if section.settings.meta != blank -%}
            <p class="zt-cs__meta">{{ section.settings.meta | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="zt-cs__cta-wrap">
          <a class="zt-cs__cta" href="{{ cta_href }}">
            <span>{{ section.settings.cta_label | escape }}</span>
            <svg class="zt-cs__cta-arrow" viewBox="0 0 16 16" width="16" height="16" focusable="false" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
        </div>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="zt-cs__disclaimer">{{ section.settings.disclaimer | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    if (window.ztCsCtaScroll) return;
    window.ztCsCtaScroll = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.zt-cs__cta');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;

      var target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      if (href === '#purchase' && typeof window.ztScrollToCacaoOffer === 'function') {
        window.ztScrollToCacaoOffer({ frameKey: 'ztCsCtaFrame' });
        return;
      }

      var start = window.scrollY || window.pageYOffset;
      var margin = parseFloat(window.getComputedStyle(target).scrollMarginTop) || 0;
      var end = target.getBoundingClientRect().top + start - margin;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.ztCsCtaFrame) {
        window.cancelAnimationFrame(window.ztCsCtaFrame);
        window.ztCsCtaFrame = 0;
      }

      if (reduce || Math.abs(end - start) < 2) {
        window.scrollTo(0, end);
        if (window.history.replaceState) window.history.replaceState(null, '', window.location.pathname + window.location.search);
        return;
      }

      var duration = 1300;
      var startTime = null;

      function ease(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function finish(cancelled) {
        window.removeEventListener('wheel', cancel);
        window.removeEventListener('touchstart', cancel);
        window.ztCsCtaFrame = 0;
        if (!cancelled && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function cancel() {
        if (window.ztCsCtaFrame) window.cancelAnimationFrame(window.ztCsCtaFrame);
        finish(true);
      }

      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + (end - start) * ease(progress));
        if (progress < 1) {
          window.ztCsCtaFrame = window.requestAnimationFrame(step);
        } else {
          finish(false);
        }
      }

      window.addEventListener('wheel', cancel, { passive: true });
      window.addEventListener('touchstart', cancel, { passive: true });
      window.ztCsCtaFrame = window.requestAnimationFrame(step);
    });
  })();
</script>

