{% endstylesheet %}

<script>
  (function () {
    if (window.__ztCurrencySelector) return;
    window.__ztCurrencySelector = true;

    document.addEventListener('click', function (event) {
      var root = document.getElementById('header-component');
      if (!root || !event.target.closest) return;
      if (customElements.get('dropdown-localization-component')) return;

      var button = event.target.closest('.dropdown-localization__button');
      if (button && root.contains(button)) {
        var host = button.closest('dropdown-localization-component');
        var panel = host && host.querySelector('.localization-wrapper');
        if (!panel) return;
        var willOpen = panel.hasAttribute('hidden');
        root.querySelectorAll('.localization-wrapper').forEach(function (other) {
          other.setAttribute('hidden', '');
        });
        root.querySelectorAll('.dropdown-localization__button').forEach(function (other) {
          other.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) {
          panel.removeAttribute('hidden');
          button.setAttribute('aria-expanded', 'true');
        }
        return;
      }

      var item = event.target.closest('.localization-form__list-item[data-value]');
      if (item && root.contains(item)) {
        var form = item.closest('form');
        var input = form && form.querySelector('input[name="country_code"]');
        if (!form || !input) return;
        input.value = item.getAttribute('data-value');
        event.preventDefault();
        HTMLFormElement.prototype.submit.call(form);
        return;
      }

      if (event.target.closest('#header-component dropdown-localization-component')) return;

      root.querySelectorAll('.localization-wrapper').forEach(function (panel) {
        panel.setAttribute('hidden', '');
      });
      root.querySelectorAll('.dropdown-localization__button').forEach(function (other) {
        other.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('change', function (event) {
      var select = event.target;
      if (!select || select.name !== 'language_code') return;
      if (customElements.get('localization-form-component')) return;
      var root = document.getElementById('header-component');
      if (!root || !root.contains(select)) return;
      var form = select.closest('form');
      if (form) form.submit();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      var root = document.getElementById('header-component');
      if (!root) return;
      root.querySelectorAll('.localization-wrapper').forEach(function (panel) {
        panel.setAttribute('hidden', '');
      });
      root.querySelectorAll('.dropdown-localization__button').forEach(function (button) {
        button.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>

<script>
  (function () {
    if (window.__ztStickyAppBar) return;
    window.__ztStickyAppBar = true;

    var SELECTOR = '.essential_free_shipping_bar_wrapper';

    function appBarHeight() {
      var total = 0;
      document.querySelectorAll(SELECTOR).forEach(function (bar) {
        var cs = getComputedStyle(bar);
        if (cs.display === 'none' || cs.visibility === 'hidden') return;
        if (cs.position !== 'sticky' && cs.position !== 'fixed') return;
        total += bar.getBoundingClientRect().height;
      });
      // Overlap the bar by 1px so subpixel rounding cannot show the page between them.
      return Math.max(0, Math.floor(total) - 1);
    }

    function apply() {
      var section = document.querySelector('.header-section');
      if (!section) return;
      var height = appBarHeight();
      if (height > 0) section.style.setProperty('--zt-sticky-offset', height + 'px');
      else section.style.removeProperty('--zt-sticky-offset');
    }

    function watchBar(bar) {
      if (!bar || bar.dataset.ztStickyWatch) return;
      bar.dataset.ztStickyWatch = 'true';
      if (typeof ResizeObserver === 'function') new ResizeObserver(apply).observe(bar);
    }

    function scan() {
      document.querySelectorAll(SELECTOR).forEach(watchBar);
      apply();
    }

    scan();
    if (document.body) new MutationObserver(scan).observe(document.body, { childList: true });
    window.addEventListener('resize', apply);
  })();
</script>

{%- comment -%}
  Removed Nov 10 2026: inline module importing '@theme/section-hydration'. These layouts have no
  import map, so it threw "Failed to resolve module specifier" on every page and never ran.
  The header menus are fully server-rendered, so hydration had nothing to add.
