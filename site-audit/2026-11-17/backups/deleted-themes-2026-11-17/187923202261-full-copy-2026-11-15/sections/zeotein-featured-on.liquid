{% comment %}
  ZEOTEIN — STEP 12
  HOWIE / MEDIA CREDIBILITY

  Purpose:
  - Position Howie as credibility, not the primary sales reason
  - Use approved Howie imagery only
  - Keep the section modular/removable
  - Avoid endorsement claims
  - Premium cream / lavender / white editorial design
{% endcomment %}

<section
  id="zeotein-credibility-{{ section.id }}"
  class="zt-credibility"
>
  <div class="zt-credibility__container">

    {% comment %}
      HEADER
    {% endcomment %}
    <div class="zt-credibility__header">

      {% if section.settings.eyebrow != blank %}
        <div class="zt-credibility__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="zt-credibility__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

    </div>


    {% comment %}
      MAIN EDITORIAL PANEL
    {% endcomment %}
    <div class="zt-credibility__panel">

      {% comment %}
        HOWIE SIDE
      {% endcomment %}
      <div class="zt-credibility__howie">

        <div class="zt-credibility__howie-glow"></div>

        {% if section.settings.howie_image != blank %}

          {{
            section.settings.howie_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '500, 700, 900, 1200, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'zt-credibility__howie-image',
              alt: section.settings.howie_alt
          }}

        {% elsif request.design_mode %}

          <div class="zt-credibility__placeholder">
            <span>ADD APPROVED HOWIE IMAGE</span>
          </div>

        {% endif %}

      </div>


      {% comment %}
        MEDIA / RECOGNITION SIDE
      {% endcomment %}
      <div class="zt-credibility__media">

        <div class="zt-credibility__media-copy">

          {% if section.settings.media_eyebrow != blank %}
            <div class="zt-credibility__media-eyebrow">
              {{ section.settings.media_eyebrow }}
            </div>
          {% endif %}

          {% if section.settings.media_heading != blank %}
            <h3 class="zt-credibility__media-heading">
              {{ section.settings.media_heading }}
            </h3>
          {% endif %}

        </div>


        {% comment %}
          MEDIA ASSETS
        {% endcomment %}
        <div class="zt-credibility__assets">

          <div class="zt-credibility__asset">

            {% if section.settings.media_logo_1 != blank %}

              {{
                section.settings.media_logo_1
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 990px) 300px, 42vw',
                  class: 'zt-credibility__asset-image',
                  alt: section.settings.media_logo_1_alt
              }}

            {% elsif request.design_mode %}

              <div class="zt-credibility__asset-placeholder">
                <span>MEDIA ASSET 01</span>
              </div>

            {% endif %}

          </div>


          <div class="zt-credibility__asset">

            {% if section.settings.media_logo_2 != blank %}

              {{
                section.settings.media_logo_2
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 990px) 300px, 42vw',
                  class: 'zt-credibility__asset-image',
                  alt: section.settings.media_logo_2_alt
              }}

            {% elsif request.design_mode %}

              <div class="zt-credibility__asset-placeholder">
                <span>MEDIA ASSET 02</span>
              </div>

            {% endif %}

          </div>

        </div>


        {% if section.settings.bottom_text != blank %}
          <div class="zt-credibility__bottom-text">
            {{ section.settings.bottom_text }}
          </div>
        {% endif %}

      </div>

    </div>

  </div>
</section>


<style>
  #zeotein-credibility-{{ section.id }} {
    --zt-cream: #F8F6F2;
    --zt-lavender: #F0ECF8;
    --zt-purple: #6F4AA8;
    --zt-purple-dark: #51357D;
    --zt-teal: #35B9C7;
    --zt-ink: #202020;
    --zt-muted: #68656D;
    --zt-border: rgba(81, 53, 125, 0.14);

    background: var(--zt-cream);
    padding: 70px 24px;
  }

  #zeotein-credibility-{{ section.id }} * {
    box-sizing: border-box;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
  }


  /* --------------------------------
     HEADER
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__header {
    max-width: 850px;
    margin: 0 auto 48px;
    text-align: center;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__eyebrow {
    margin-bottom: 14px;
    color: var(--zt-purple);
    font-size: 12px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__heading {
    margin: 0;
    color: var(--zt-ink);
    font-size: clamp(38px, 5vw, 64px);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: -0.045em;
  }


  /* --------------------------------
     MAIN PANEL
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    min-height: 600px;
    overflow: hidden;

    background: #ffffff;
    border: 1px solid var(--zt-border);
    border-radius: 30px;

    box-shadow:
      0 20px 60px rgba(44, 28, 67, 0.07);
  }


  /* --------------------------------
     HOWIE AREA
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__howie {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 600px;
    height: 600px;
    overflow: hidden;

    background: var(--zt-lavender);

    border-right: 1px solid rgba(111, 74, 168, 0.14);
    box-shadow: none;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__howie-glow {
    position: absolute;
    width: 460px;
    height: 460px;
    left: 50%;
    bottom: -150px;
    transform: translateX(-50%);

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(111, 74, 168, 0.16) 0%,
        rgba(111, 74, 168, 0.07) 42%,
        rgba(111, 74, 168, 0) 72%
      );

    pointer-events: none;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__howie-image {
    position: relative;
    z-index: 2;

    display: block;

    width: 108%;
    max-width: none;
    height: 108%;
    max-height: none;

    object-fit: contain;
    object-position: center bottom;

    margin: 0 auto;
    transform: translateX(-4%);

    filter: drop-shadow(0 14px 18px rgba(44, 28, 67, 0.11));
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__placeholder {
    position: absolute;
    inset: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px dashed rgba(81, 53, 125, 0.35);
    border-radius: 20px;

    color: var(--zt-purple);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }


  /* --------------------------------
     MEDIA AREA
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__media {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 70px 64px;

    background: #ffffff;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__media-copy {
    margin-bottom: 42px;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__media-eyebrow {
    margin-bottom: 12px;

    color: var(--zt-purple);
    font-size: 11px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__media-heading {
    margin: 0;

    color: var(--zt-ink);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.035em;
  }


  /* --------------------------------
     MEDIA ASSET GRID
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__assets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__asset {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 150px;

    overflow: hidden;

    background: #faf9fb;
    border: 1px solid rgba(81, 53, 125, 0.11);
    border-radius: 18px;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__asset:hover {
    transform: translateY(-2px);

    border-color: rgba(111, 74, 168, 0.25);

    box-shadow:
      0 10px 25px rgba(44, 28, 67, 0.06);
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__asset-image {
    display: block;

    width: 100%;
    height: 100%;
    min-height: 150px;

    object-fit: contain;
    object-position: center;

    padding: 18px;
  }

  #zeotein-credibility-{{ section.id }} .zt-credibility__asset-placeholder {
    width: 100%;
    height: 150px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--zt-purple);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }


  /* --------------------------------
     OPTIONAL FOOTER TEXT
  -------------------------------- */

  #zeotein-credibility-{{ section.id }} .zt-credibility__bottom-text {
    margin-top: 28px;

    color: var(--zt-muted);
    font-size: 12px;
    line-height: 1.6;
  }


  /* --------------------------------
     MOBILE
  -------------------------------- */

  @media screen and (max-width: 989px) {

    #zeotein-credibility-{{ section.id }} {
      padding: 76px 20px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__header {
      margin-bottom: 20px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__heading {
      font-size: clamp(36px, 10vw, 52px);
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__panel {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: 24px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__howie {
      min-height: 0;
      height: 430px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__howie-image {
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 500px;
      object-fit: contain;
      object-position: center bottom;
      margin: 0 auto;
      transform: none;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__media {
      padding: 48px 30px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__media-copy {
      margin-bottom: 30px;
    }

  }


  /* --------------------------------
     SMALL MOBILE
  -------------------------------- */

  @media screen and (max-width: 600px) {

    #zeotein-credibility-{{ section.id }} {
      padding: 38px 16px 55px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__howie-image {
      width: auto;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      object-position: center bottom;
      transform: none;
      margin: 0 auto;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__eyebrow {
      font-size: 10px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__heading {
      font-size: 38px;
      line-height: 1;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__howie {
      min-height: 0;
      height: 395px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__howie-image {
      width: auto;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      object-position: center bottom;
      transform: none;
      margin: 0 auto;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__media {
      padding: 40px 22px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__assets {
      gap: 10px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__asset {
      min-height: 120px;
      border-radius: 14px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__asset-image {
      min-height: 120px;
      padding: 12px;
    }

    #zeotein-credibility-{{ section.id }} .zt-credibility__asset-placeholder {
      height: 120px;
      font-size: 9px;
    }

  }
</style>


{% schema %}
{
  "name": "Howie / Media Credibility",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CREDIBILITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Seen With Howie Mandel"
    },
    {
      "type": "image_picker",
      "id": "howie_image",
      "label": "Approved Howie Image"
    },
    {
      "type": "text",
      "id": "howie_alt",
      "label": "Howie Image Alt Text",
      "default": "Howie Mandel holding Zeotein"
    },
    {
      "type": "text",
      "id": "media_eyebrow",
      "label": "Media Eyebrow",
      "default": "FEATURED ON"
    },
    {
      "type": "text",
      "id": "media_heading",
      "label": "Media Heading",
      "default": "Howie Does Stuff"
    },
    {
      "type": "image_picker",
      "id": "media_logo_1",
      "label": "Media Asset 1"
    },
    {
      "type": "text",
      "id": "media_logo_1_alt",
      "label": "Media Asset 1 Alt Text",
      "default": "Howie Does Stuff"
    },
    {
      "type": "image_picker",
      "id": "media_logo_2",
      "label": "Media Asset 2"
    },
    {
      "type": "text",
      "id": "media_logo_2_alt",
      "label": "Media Asset 2 Alt Text",
      "default": "YouTube"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Optional Bottom Text"
    }
  ],
  "presets": [
    {
      "name": "Howie / Media Credibility"
    }
  ]
}
{% endschema %}
