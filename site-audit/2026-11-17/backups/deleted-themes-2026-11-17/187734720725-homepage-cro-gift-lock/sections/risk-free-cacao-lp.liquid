{%- liquid
  assign sid = 'zt-rf-' | append: section.id
  assign cta_href = section.settings.cta_link | default: '#purchase'
  assign overlay_color = section.settings.overlay_color | default: '#5a148c'
  assign overlay_alpha = section.settings.overlay_opacity | default: 55 | times: 1.0 | divided_by: 100
  assign bg_desktop = section.settings.bg_image
  assign bg_mobile = section.settings.bg_image_mobile
  if bg_desktop == blank
    assign bg_desktop = bg_mobile
  endif
  if bg_mobile == blank
    assign bg_mobile = bg_desktop
  endif
-%}

{% content_for 'block', type: 'cacao-type-rf', id: 'type-rf' %}

{{ 'risk-free-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-rf"
  {{ section.shopify_attributes }}
  style="
    --zt-rf-bg: {{ section.settings.bg_color }};
    --zt-rf-text: {{ section.settings.text_color }};
    --zt-rf-accent: {{ section.settings.accent_color }};
    --zt-rf-badge-text: {{ section.settings.badge_text_color }};
    --zt-rf-cta-bg: {{ section.settings.cta_bg_color }};
    --zt-rf-cta-text: {{ section.settings.cta_text_color }};
    --zt-rf-overlay: {{ overlay_color | color_modify: 'alpha', overlay_alpha }};
    --zt-rf-max-width: {{ section.settings.content_width | default: 720 }}px;
    --zt-rf-pad-top: {{ section.settings.padding_top }}px;
    --zt-rf-pad-bottom: {{ section.settings.padding_bottom }}px;
    --zt-rf-badge-size: {{ section.settings.badge_size }}px;
    --zt-rf-badge-size-m: {{ section.settings.badge_size_mobile }}px;
  "
>
  {%- if bg_desktop != blank or bg_mobile != blank -%}
    <div class="zt-rf__bg" aria-hidden="true">
      {%- if bg_desktop != blank -%}
        {{
          bg_desktop
          | image_url: width: 2400
          | image_tag:
            class: 'zt-rf__bg-img zt-rf__bg-img--desktop',
            loading: 'lazy',
            widths: '800, 1200, 1600, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
      {%- if bg_mobile != blank -%}
        {{
          bg_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'zt-rf__bg-img zt-rf__bg-img--mobile',
            loading: 'lazy',
            widths: '400, 700, 1000, 1200',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
      <div class="zt-rf__shade"></div>
    </div>
  {%- endif -%}

  <div class="zt-rf__inner">
    {%- if section.settings.show_badge -%}
      {%- liquid
        assign badge_class = 'zt-rf__badge'
        assign badge_knockout = false
        if section.settings.badge_image != blank
          assign badge_class = badge_class | append: ' zt-rf__badge--image'
          if section.settings.badge_knockout_white
            assign badge_knockout = true
            assign badge_class = badge_class | append: ' zt-rf__badge--knockout'
          endif
        endif
      -%}
      <div class="{{ badge_class }}">
        {%- if section.settings.badge_image != blank -%}
          {%- if badge_knockout -%}
            {%- assign badge_src = section.settings.badge_image | image_url: width: 800 -%}
            <span
              class="zt-rf__badge-img zt-rf__badge-img--knockout"
              role="img"
              aria-label="{{ section.settings.badge_text | escape }}"
              style="background-image: url('{{ badge_src }}');"
            ></span>
          {%- else -%}
            {{
              section.settings.badge_image
              | image_url: width: 800
              | image_tag:
                class: 'zt-rf__badge-img',
                loading: 'lazy',
                widths: '160, 240, 360, 520, 800',
                sizes: '(min-width: 750px) 360px, 280px',
                alt: section.settings.badge_text
            }}
          {%- endif -%}
        {%- else -%}
          <div class="zt-rf__badge-fallback">
            {%- if section.settings.badge_text != blank -%}
              <p class="zt-rf__badge-text">{{ section.settings.badge_text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <p class="zt-rf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="zt-rf__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="zt-rf__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="zt-rf__cta" href="{{ cta_href }}">
        <span>{{ section.settings.cta_label | escape }}</span>
        <svg class="zt-rf__cta-arrow" viewBox="0 0 16 16" width="16" height="16" focusable="false" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    if (window.ztRfCtaScroll) return;
    window.ztRfCtaScroll = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.zt-rf__cta');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;

      var target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      if (href === '#purchase' && typeof window.ztScrollToCacaoOffer === 'function') {
        window.ztScrollToCacaoOffer({ frameKey: 'ztRfCtaFrame' });
        return;
      }

      var start = window.scrollY || window.pageYOffset;
      var margin = parseFloat(window.getComputedStyle(target).scrollMarginTop) || 0;
      var end = target.getBoundingClientRect().top + start - margin;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.ztRfCtaFrame) {
        window.cancelAnimationFrame(window.ztRfCtaFrame);
        window.ztRfCtaFrame = 0;
      }

      if (reduce || Math.abs(end - start) < 2) {
        window.scrollTo(0, end);
        if (window.history.replaceState) window.history.replaceState(null, '', window.location.pathname + window.location.search);
        return;
      }

      var duration = 1300;
      var startTime = null;

      function ease(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function finish(cancelled) {
        window.removeEventListener('wheel', cancel);
        window.removeEventListener('touchstart', cancel);
        window.ztRfCtaFrame = 0;
        if (!cancelled && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function cancel() {
        if (window.ztRfCtaFrame) window.cancelAnimationFrame(window.ztRfCtaFrame);
        finish(true);
      }

      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + (end - start) * ease(progress));
        if (progress < 1) {
          window.ztRfCtaFrame = window.requestAnimationFrame(step);
        } else {
          finish(false);
        }
      }

      window.addEventListener('wheel', cancel, { passive: true });
      window.addEventListener('touchstart', cancel, { passive: true });
      window.ztRfCtaFrame = window.requestAnimationFrame(step);
    });
  })();
</script>

