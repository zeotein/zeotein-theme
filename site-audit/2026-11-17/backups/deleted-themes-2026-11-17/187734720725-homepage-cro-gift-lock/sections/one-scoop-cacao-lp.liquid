{%- liquid
  assign sid = 'zt-os-' | append: section.id
  assign body_desktop = section.settings.body
  assign body_mobile = section.settings.body_mobile | default: body_desktop
  assign cta_href = section.settings.cta_link | default: '#purchase'
  assign shade_color = section.settings.bg_shade_color | default: '#000000'
  assign shade_alpha = section.settings.bg_shade | default: 0 | times: 1.0 | divided_by: 100
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'eyebrow,heading,body,cta'
%}

{{ 'one-scoop-cacao-lp.css' | asset_url | stylesheet_tag }}

<section
  id="{{ sid }}"
  class="zt-os"
  {{ section.shopify_attributes }}
  style="
    --zt-os-bg: {{ section.settings.bg_color }};
    --zt-os-accent: {{ section.settings.accent_color }};
    --zt-os-text: {{ section.settings.text_color }};
    --zt-os-cta-bg: {{ section.settings.cta_bg_color }};
    --zt-os-cta-text: {{ section.settings.cta_text_color }};
    --zt-os-max-width: {{ section.settings.content_width | default: 1200 }}px;
    --zt-os-pad-top: {{ section.settings.padding_top }}px;
    --zt-os-pad-bottom: {{ section.settings.padding_bottom }}px;
    --zt-os-shade: {{ shade_color | color_modify: 'alpha', shade_alpha }};
  "
>
  {%- liquid
    assign bg_desktop = section.settings.bg_image
    assign bg_mobile = section.settings.bg_image_mobile
    if bg_desktop == blank
      assign bg_desktop = bg_mobile
    endif
    if bg_mobile == blank
      assign bg_mobile = bg_desktop
    endif
  -%}
  {%- if bg_desktop != blank or bg_mobile != blank -%}
    <div class="zt-os__bg" aria-hidden="true">
      {%- if bg_desktop != blank -%}
        {{
          bg_desktop
          | image_url: width: 2400
          | image_tag:
            class: 'zt-os__bg-img zt-os__bg-img--desktop',
            loading: 'lazy',
            widths: '800, 1200, 1600, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
      {%- if bg_mobile != blank -%}
        {{
          bg_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'zt-os__bg-img zt-os__bg-img--mobile',
            loading: 'lazy',
            widths: '400, 700, 1000, 1200',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
      <div class="zt-os__shade"></div>
    </div>
  {%- endif -%}

  <div class="zt-os__inner">
    <div class="zt-os__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zt-os__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="zt-os__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if body_desktop != blank -%}
        <p class="zt-os__body zt-os__body--desktop">{{ body_desktop | escape }}</p>
      {%- endif -%}
      {%- if body_mobile != blank -%}
        <p class="zt-os__body zt-os__body--mobile">{{ body_mobile | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="zt-os__cta" href="{{ cta_href }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <svg class="zt-os__cta-arrow" viewBox="0 0 16 16" width="16" height="16" focusable="false" aria-hidden="true">
            <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="zt-os__media">
      {%- if section.settings.product_image != blank -%}
        {%- assign product_alt = section.settings.product_image.alt | default: section.settings.heading -%}
        {{
          section.settings.product_image
          | image_url: width: 900
          | image_tag:
            class: 'zt-os__product',
            loading: 'lazy',
            widths: '280, 400, 600, 900',
            sizes: '(max-width: 989px) 78vw, min(420px, 40vw)',
            alt: product_alt
        }}
      {%- else -%}
        <div class="zt-os__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'zt-os__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    if (window.ztOsCtaScroll) return;
    window.ztOsCtaScroll = true;

    document.addEventListener('click', function (event) {
      var link = event.target.closest('.zt-os__cta');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;

      var target = document.getElementById(href.slice(1));
      if (!target) return;

      event.preventDefault();

      if (href === '#purchase' && typeof window.ztScrollToCacaoOffer === 'function') {
        window.ztScrollToCacaoOffer({ frameKey: 'ztOsCtaFrame' });
        return;
      }

      var start = window.scrollY || window.pageYOffset;
      var margin = parseFloat(window.getComputedStyle(target).scrollMarginTop) || 0;
      var end = target.getBoundingClientRect().top + start - margin;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.ztOsCtaFrame) {
        window.cancelAnimationFrame(window.ztOsCtaFrame);
        window.ztOsCtaFrame = 0;
      }

      if (reduce || Math.abs(end - start) < 2) {
        window.scrollTo(0, end);
        if (window.history.replaceState) window.history.replaceState(null, '', window.location.pathname + window.location.search);
        return;
      }

      var duration = 1300;
      var startTime = null;

      function ease(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      }

      function finish(cancelled) {
        window.removeEventListener('wheel', cancel);
        window.removeEventListener('touchstart', cancel);
        window.ztOsCtaFrame = 0;
        if (!cancelled && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }

      function cancel() {
        if (window.ztOsCtaFrame) window.cancelAnimationFrame(window.ztOsCtaFrame);
        finish(true);
      }

      function step(now) {
        if (startTime === null) startTime = now;
        var progress = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + (end - start) * ease(progress));
        if (progress < 1) {
          window.ztOsCtaFrame = window.requestAnimationFrame(step);
        } else {
          finish(false);
        }
      }

      window.addEventListener('wheel', cancel, { passive: true });
      window.addEventListener('touchstart', cancel, { passive: true });
      window.ztOsCtaFrame = window.requestAnimationFrame(step);
    });
  })();
</script>

