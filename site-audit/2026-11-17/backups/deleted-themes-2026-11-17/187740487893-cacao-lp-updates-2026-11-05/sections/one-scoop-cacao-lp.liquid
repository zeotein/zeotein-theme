{%- comment -%}
  One Scoop Cacao LP: How it works (Scoop / Shake / Go) + proof strip, flanked by two
  existing gallery images of the 30-Day Cacao Bulk Bag (gid://shopify/Product/15398808027349).
  Content is hardcoded. Legacy settings stay in the schema so the template keeps validating.
{%- endcomment -%}
{%- liquid
  assign sid = 'zt-os-' | append: section.id
  assign os_product = all_products['zeotein-cacao-bag-30-landing-page']
  assign os_img_a = nil
  assign os_img_b = nil
  if os_product != blank
    for m in os_product.media
      if m.media_type == 'image'
        assign m_src = m.preview_image.src | append: ''
        if m_src contains 'Overhead_flat_lay'
          assign os_img_a = m
        elsif m_src contains 'bulk_protein_bag_open'
          assign os_img_b = m
        endif
      endif
    endfor
    if os_img_a == nil
      assign os_img_a = os_product.featured_media
    endif
  endif
-%}

{% render 'cacao-lp-fonts',
  id: sid,
  font_family: section.settings.font_family,
  settings: section.settings,
  prefixes: 'eyebrow,heading,body,cta'
%}

<style>
  #{{ sid }}.zt-os2 {
    background: #F3EDF9;
    color: #1e1734;
    padding: 32px 16px 36px;
  }
  #{{ sid }} .zt-os2__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      'head head'
      'a b'
      'main main';
    gap: 10px 8px;
    max-width: 520px;
    margin: 0 auto;
  }
  #{{ sid }} .zt-os2__head { grid-area: head; }
  #{{ sid }} .zt-os2__fig--a { grid-area: a; }
  #{{ sid }} .zt-os2__fig--b { grid-area: b; }
  #{{ sid }} .zt-os2__main { grid-area: main; min-width: 0; }
  #{{ sid }} .zt-os2__fig {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #e9e0f4;
    aspect-ratio: 4 / 3;
  }
  #{{ sid }} .zt-os2__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #{{ sid }} .zt-os2__fig--b .zt-os2__img {
    object-position: 72% 50%;
  }
  #{{ sid }} .zt-os2__eyebrow {
    margin: 0 0 6px;
    color: #32BAC0;
    font-size: 9.5px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .13em;
    line-height: 1.3;
  }
  #{{ sid }} .zt-os2__heading {
    margin: 0 0 4px;
    color: #1e1734;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.15;
  }
  #{{ sid }} .zt-os2__steps {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #{{ sid }} .zt-os2__step {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid #e6e0f0;
    border-radius: 12px;
    padding: 12px 13px 13px;
    background: #ffffff;
    --zt-os2-bar: #5F2D90;
    --zt-os2-word: #5F2D90;
  }
  #{{ sid }} .zt-os2__step::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: var(--zt-os2-bar);
  }
  #{{ sid }} .zt-os2__step--2 {
    --zt-os2-bar: #7E4BB5;
    --zt-os2-word: #7E4BB5;
  }
  #{{ sid }} .zt-os2__step--3 {
    --zt-os2-bar: #32BAC0;
    --zt-os2-word: #1E8A8F;
    background: #F4FBFC;
    border-color: #cfeff0;
  }
  #{{ sid }} .zt-os2__verb {
    margin: 0 0 6px;
    color: var(--zt-os2-word);
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -.045em;
    line-height: .95;
    text-transform: uppercase;
  }
  #{{ sid }} .zt-os2__desc {
    margin: 0;
    max-width: 86%;
    color: #4A4458;
    font-size: 11.5px;
    line-height: 1.42;
  }
  #{{ sid }} .zt-os2__proof {
    margin: 10px 0 0;
    border: 1px solid #e6e0f0;
    border-radius: 10px;
    padding: 10px 11px;
    background: #ffffff;
  }
  #{{ sid }} .zt-os2__stars {
    margin: 0 0 3px;
    color: #E8A33D;
    font-size: 10.5px;
    letter-spacing: .08em;
    line-height: 1.2;
  }
  #{{ sid }} .zt-os2__quote {
    margin: 0 0 3px;
    padding: 0;
    border: 0;
    color: #1e1734;
    font-size: 11.5px;
    font-style: normal;
    font-weight: 650;
    line-height: 1.35;
  }
  #{{ sid }} .zt-os2__quote::before,
  #{{ sid }} .zt-os2__quote::after {
    content: none;
  }
  #{{ sid }} .zt-os2__cite {
    margin: 0;
    color: #7A7389;
    font-size: 9.5px;
    font-weight: 600;
    font-style: normal;
    line-height: 1.3;
  }
  @media (min-width: 750px) {
    #{{ sid }}.zt-os2 {
      padding: 56px 24px 60px;
    }
    #{{ sid }} .zt-os2__heading {
      font-size: 30px;
    }
  }
  @media (min-width: 990px) {
    #{{ sid }} .zt-os2__layout {
      grid-template-columns: 240px minmax(0, 520px) 240px;
      grid-template-areas:
        'a head b'
        'a main b';
      gap: 12px 32px;
      max-width: none;
      justify-content: center;
    }
    #{{ sid }} .zt-os2__fig {
      aspect-ratio: 3 / 4;
      align-self: center;
      border-radius: 14px;
    }
  }
</style>

<section
  id="{{ sid }}"
  class="zt-os2"
  {{ section.shopify_attributes }}
>
  <div class="zt-os2__layout">
    <div class="zt-os2__head">
      <p class="zt-os2__eyebrow">How it works</p>
      <h2 class="zt-os2__heading">Clean nutrition in seconds.</h2>
    </div>

    {%- if os_img_a != blank -%}
      <figure class="zt-os2__fig zt-os2__fig--a">
        {{
          os_img_a
          | image_url: width: 720
          | image_tag:
            class: 'zt-os2__img',
            loading: 'lazy',
            widths: '360, 540, 720',
            sizes: '(min-width: 990px) 240px, 50vw',
            alt: 'Zeotein Cacao bulk bag with two scoops and bowls of cacao ingredients, seen from above'
        }}
      </figure>
    {%- endif -%}

    <div class="zt-os2__main">
      <ol class="zt-os2__steps">
        <li class="zt-os2__step zt-os2__step--1">
          <p class="zt-os2__verb">Scoop</p>
          <p class="zt-os2__desc">Two scoops from the bag. The Save-A-Scoop clips right to it, so it never disappears in the powder.</p>
        </li>
        <li class="zt-os2__step zt-os2__step--2">
          <p class="zt-os2__verb">Shake</p>
          <p class="zt-os2__desc">10 to 12 oz of milk, water or coffee. Ten seconds, no blender.</p>
        </li>
        <li class="zt-os2__step zt-os2__step--3">
          <p class="zt-os2__verb">Go</p>
          <p class="zt-os2__desc">Clean fuel that keeps up with whatever the day throws at you.</p>
        </li>
      </ol>

      <figure class="zt-os2__proof">
        <p class="zt-os2__stars" role="img" aria-label="5 out of 5 stars">★★★★★</p>
        <blockquote class="zt-os2__quote">Smooth, filling, and easy to stick with.</blockquote>
        <figcaption class="zt-os2__cite">Traci P. · Verified customer</figcaption>
      </figure>
    </div>

    {%- if os_img_b != blank -%}
      <figure class="zt-os2__fig zt-os2__fig--b">
        {{
          os_img_b
          | image_url: width: 720
          | image_tag:
            class: 'zt-os2__img',
            loading: 'lazy',
            widths: '360, 540, 720',
            sizes: '(min-width: 990px) 240px, 50vw',
            alt: 'Zeotein Cacao bulk bag with a scoop inside, next to a glass of cacao shake on a kitchen counter'
        }}
      </figure>
    {%- endif -%}
  </div>
</section>

