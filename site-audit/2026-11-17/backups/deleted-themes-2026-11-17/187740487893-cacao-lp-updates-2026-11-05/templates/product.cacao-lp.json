        "tab_bztMc9": {
          "type": "tab",
          "settings": {
            "label": "Vs Powders",
            "text_count": 3,
            "text_1_stars": 5,
            "text_1_title": "The easiest protein routine I’ve ever kept up with.",
            "text_1_body": "I’ve tried a few protein powders, but most felt complicated or had long ingredient lists. Zeotein keeps it simple with 23g of protein and six intentional ingredients in one serving. I mix it with almond milk, and the creamy cacao flavor makes it easy to enjoy every morning.",
            "text_1_name": "Rebecca D.",
            "text_2_stars": 5,
            "text_2_title": "Finally, a simple daily nutrition option.",
            "text_2_body": "I wanted something practical that I could add to my routine without mixing several different products. Two scoops of Zeotein with water takes less than a minute, and I like knowing I’m getting protein and collagen in the same serving.",
            "text_2_name": "Lauren P.",
            "text_3_stars": 5,
            "text_3_title": "Great for a quick shake at home.",
            "text_3_body": "I like that Zeotein can be mixed with water or blended into a smoothie, depending on what I feel like that day. The cacao flavor is rich without being overwhelming, and the powder blends especially well with frozen berries and almond milk.",
            "text_3_name": "Marcus W.",
            "text_4_stars": 5,
