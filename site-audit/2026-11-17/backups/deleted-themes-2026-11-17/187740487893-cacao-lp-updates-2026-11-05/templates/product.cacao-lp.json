        "tab_4znfkL": {
          "type": "tab",
          "settings": {
            "label": "Taste",
            "text_count": 3,
            "text_1_stars": 5,
            "text_1_title": "Just what I wanted",
            "text_1_body": "I was looking for a clean protein that didn’t taste chalky. Zeotein Cacao is smooth, filling, and easy to stick with every morning.",
            "text_1_name": "Traci P.",
            "text_2_stars": 5,
            "text_2_title": "Smooth Cacao without the sugar rush",
            "text_2_body": "It tastes great and the ingredients are clean. It has genuinely become part of my morning routine, the Cacao flavor is rich without being too sweet and mixes smoothly with oat milk.",
            "text_2_name": "Melissa M.",
            "text_3_stars": 5,
            "text_3_title": "Simple ingredients, smooth chocolate",
            "text_3_body": "I love that Zeotein gives me protein and collagen in one convenient serving without making my routine complicated. It blends beautifully with oat milk, and the cacao taste is rich without being overwhelming.",
            "text_3_name": "Nicole R.",
            "text_4_stars": 5,
            "text_4_title": "",
