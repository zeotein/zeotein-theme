      "type": "faq-cacao-lp",
      "blocks": {
        "item_cacao_faq_1": {
          "type": "item",
          "settings": {
            "question": "What comes in my Starter Kit?",
            "answer": "A 30-day bulk bag (30 servings), a CleanBlend shaker, a Save-A-Scoop, and three digital guides emailed after you order: the Zeotein Starter Guide, the Cacao Recipe Guide and the Vegan Recipe Guide.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_2": {
          "type": "item",
          "settings": {
            "question": "What do I pay after my first order?",
            "answer": "$99.99 per delivery. It ships every 30 days, and you can switch to every 6 or 8 weeks in your portal.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_3": {
          "type": "item",
          "settings": {
            "question": "What does it taste like?",
            "answer": "This is what clean tastes like: real organic fermented cacao, zero sugar. Most people shake it with milk, oat milk or into a smoothie. Your recipe guides have more ideas.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_4": {
          "type": "item",
          "settings": {
            "question": "Is this a whey protein?",
            "answer": "No. The protein comes from grass-fed beef bone broth and grass-fed collagen peptides.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_ingredients": {
          "type": "item",
          "settings": {
            "question": "What are the six ingredients?",
            "answer": "Grass-fed collagen peptides, grass-fed beef bone broth, organic fermented cacao, organic MCT oil powder, zeolite mineral, and organic purple and gold sea moss. Every ingredient is named on the label.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_5": {
          "type": "item",
          "settings": {
            "question": "Is it gluten free and dairy free?",
            "answer": "Yes. Zeotein Cacao is gluten free and dairy free.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_6": {
          "type": "item",
          "settings": {
            "question": "When does it ship?",
            "answer": "Orders ship in 1 to 2 business days. Standard U.S. shipping takes 2 to 5 business days after that.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_7": {
          "type": "item",
          "settings": {
            "question": "Can I pause or cancel?",
            "answer": "Yes. Pause, skip, change your date or cancel anytime in your customer portal.",
            "open_by_default": false
          }
        },
        "item_cacao_faq_8": {
          "type": "item",
          "settings": {
            "question": "How does the guarantee work?",
            "answer": "Drink your first bag. If it is not for you within 30 days of delivery, email hello@zeotein.com and we will refund it.",
            "open_by_default": false
          }
        }
